{
  "call": {
    "provider": "vertex",
    "function": "credential",
    "arg": {
      "label": "work"
    }
  },
  "host": {
    "exec": [
      {
        "request": {
          "program": "gcloud",
          "args": [
            "config",
            "config-helper",
            "--format=json(credential.access_token,credential.token_expiry)",
            "--configuration",
            "work"
          ]
        },
        "reply": {
          "code": 0,
          "stdout": "{\n  \"credential\": {\n    \"access_token\": \"example-work-token\",\n    \"token_expiry\": \"2023-11-15T00:13:20Z\"\n  }\n}",
          "stderr": ""
        }
      }
    ]
  },
  "returns": {
    "token": "example-work-token",
    "expires_at": 1700007200
  }
}
