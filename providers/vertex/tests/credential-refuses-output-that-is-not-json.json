{
  "call": {
    "provider": "vertex",
    "function": "credential",
    "arg": {}
  },
  "host": {
    "exec": [
      {
        "request": {
          "program": "gcloud",
          "args": [
            "config",
            "config-helper",
            "--format=json(credential.access_token,credential.token_expiry)"
          ]
        },
        "reply": {
          "code": 0,
          "stdout": "example-access-token\n",
          "stderr": ""
        }
      }
    ]
  },
  "error": {
    "code": "credential_failed",
    "message": "`github.com/aakshintala/fiber/providers/vertex`: vertex credential: `gcloud config config-helper` printed something other than JSON"
  }
}
