{
  "call": {
    "provider": "vertex",
    "function": "credential",
    "arg": {}
  },
  "host": {
    "exec": [
      {
        "request": {
          "program": "gcloud",
          "args": [
            "config",
            "config-helper",
            "--format=json(credential.access_token,credential.token_expiry)"
          ]
        },
        "reply": {
          "code": 0,
          "stdout": "{\n  \"credential\": {\n    \"access_token\": \"example-access-token\",\n    \"token_expiry\": \"2023-11-15T05:43:20+05:30\"\n  }\n}",
          "stderr": ""
        }
      }
    ]
  },
  "returns": {
    "token": "example-access-token",
    "expires_at": 1700007200
  }
}
