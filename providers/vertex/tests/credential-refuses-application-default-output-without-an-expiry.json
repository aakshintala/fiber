{
  "call": {
    "provider": "vertex",
    "function": "credential",
    "arg": {}
  },
  "host": {
    "exec": [
      {
        "request": {
          "program": "gcloud",
          "args": [
            "config",
            "config-helper",
            "--format=json(credential.access_token,credential.token_expiry)"
          ]
        },
        "reply": {
          "code": 1,
          "stdout": "",
          "stderr": "ERROR: (gcloud.config.config-helper) You do not currently have an active account selected.\nPlease run:\n\n  $ gcloud auth login\n\nto obtain new credentials.\n"
        }
      },
      {
        "request": {
          "program": "gcloud",
          "args": [
            "auth",
            "application-default",
            "print-access-token",
            "--format=json(token,expiry.datetime)"
          ]
        },
        "reply": {
          "code": 0,
          "stdout": "{\"token\": \"example-adc-token\"}",
          "stderr": ""
        }
      }
    ]
  },
  "error": {
    "code": "credential_failed",
    "message": "`github.com/aakshintala/fiber/providers/vertex`: vertex credential: `gcloud auth application-default print-access-token` printed no expiry that is a UTC time"
  }
}
