{
  "name": "databricks",
  "credential": {
    "env": "DATABRICKS_TOKEN"
  },
  "placeholders": {
    "workspace": {
      "env": "DATABRICKS_HOST"
    }
  },
  "headers": {
    "Databricks-Ai-Gateway-Request-Tags": "{\"source\":\"fiber\"}"
  },
  "models": [
    {
      "id": "databricks-claude-opus-5",
      "name": "Claude Opus 5 (Databricks)",
      "protocol": "anthropic-messages",
      "base_url": "https://{workspace}/ai-gateway/anthropic/v1",
      "compat": {
        "bearer": true
      },
      "context_window": 1000000,
      "max_output_tokens": 128000,
      "input": [
        "text",
        "image"
      ],
      "cost": {
        "input": 5.0,
        "output": 25.0,
        "cache_read": 0.5,
        "cache_write": 6.25
      }
    }
  ]
}
