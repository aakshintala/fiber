#!/bin/sh
# Stands in for gh in crates/main/tests/release_pack.rs: the test drives
# the draft-publish-last flow against a state directory instead of the
# GitHub API, so no request reaches the network. RELEASE_PACK_STATE names
# the directory; every invocation is appended to calls.log there. Like the
# real gh outside a checkout, every call needs its repository: GH_REPO
# names it, and a call without it fails; each log line names
# the repository the call carried.
set -eu
state=${RELEASE_PACK_STATE:?}
log=$state/calls.log
[ "${1:-}" = release ] || exit 64
repo=${GH_REPO:-}
if [ -z "$repo" ]; then
  printf 'gh: no repository: set GH_REPO\n' >&2
  exit 1
fi
# RELEASE_PACK_GH_FAIL fails every call with its text, so a test drives a
# failing API without the network.
if [ -n "${RELEASE_PACK_GH_FAIL:-}" ]; then printf 'gh: %s\n' "$RELEASE_PACK_GH_FAIL" >&2; exit 1; fi
sub=${2:-}
tag=
for arg in "$@"; do
  case $arg in
    v*) tag=$arg ;;
  esac
done
[ -n "$tag" ] || exit 64
version=${tag#v}
case $sub in
  view)
    printf 'view %s repo=%s\n' "$tag" "$repo" >> "$log"
    # RELEASE_PACK_GH_VIEW replaces a successful view body, so a test
    # drives an unexpected release state without the network.
    if [ -n "${RELEASE_PACK_GH_VIEW:-}" ]; then printf '%s\n' "$RELEASE_PACK_GH_VIEW"; exit 0; fi
    case $* in
      # A target query prints the commit the release was created from,
      # which create stores in the state file, as the real view prints
      # targetCommitish.
      *targetCommitish*)
        if [ -f "$state/published-$version" ]; then cat "$state/published-$version"; exit 0; fi
        if [ -f "$state/draft-$version" ]; then cat "$state/draft-$version"; exit 0; fi
        printf 'gh: release %s not found\n' "$tag" >&2
        exit 1 ;;
    esac
    if [ -f "$state/published-$version" ]; then printf 'false\n'; exit 0; fi
    if [ -f "$state/draft-$version" ]; then printf 'true\n'; exit 0; fi
    # Like the real view, a missing release says so, so the caller can
    # tell absent from a failed lookup.
    printf 'gh: release %s not found\n' "$tag" >&2
    exit 1 ;;
  create)
    printf 'create %s %s repo=%s\n' "$tag" "$*" "$repo" >> "$log"
    [ ! -f "$state/published-$version" ] || exit 1
    target=
    notes=
    prev=
    for arg in "$@"; do
      if [ "$prev" = --target ]; then target=$arg; fi
      if [ "$prev" = --notes-file ]; then notes=$arg; fi
      prev=$arg
    done
    printf '%s\n' "$target" > "$state/draft-$version"
    if [ -n "$notes" ]; then cp "$notes" "$state/notes-$version"; fi ;;
  upload)
    printf 'upload %s %s repo=%s\n' "$tag" "$*" "$repo" >> "$log"
    [ -f "$state/draft-$version" ] || exit 1
    for arg in "$@"; do
      case $arg in
        --* | "$tag" | release | upload | create | edit | delete | view) ;;
        *)
          # Like the real upload, a named file that is not there fails
          # the step, so the failure step's cleanup runs.
          if [ ! -f "$arg" ]; then printf 'upload: %s: no such file\n' "$arg" >&2; exit 1; fi
          printf '%s\n' "${arg##*/}" >> "$state/uploads-$version" ;;
      esac
    done ;;
  edit)
    printf 'edit %s %s repo=%s\n' "$tag" "$*" "$repo" >> "$log"
    [ -f "$state/draft-$version" ] || exit 1
    mv "$state/draft-$version" "$state/published-$version" ;;
  delete)
    printf 'delete %s %s repo=%s\n' "$tag" "$*" "$repo" >> "$log"
    case $* in
      *--cleanup-tag*) ;;
      *) exit 1 ;;
    esac
    [ -f "$state/draft-$version" ] || [ -f "$state/published-$version" ] || exit 1
    rm -f "$state/draft-$version" "$state/published-$version" ;;
  *) exit 64 ;;
esac
