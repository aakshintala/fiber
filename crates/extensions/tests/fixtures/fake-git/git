#!/bin/sh
# A stand-in for `git` in the bounded-wait tests: it answers `ls-remote`
# with one tag, and stalls instead when the call carries its stall marker
# (`ls-remote` on `stall-ls-remote/...`, `clone` on `stall-clone/...`) or
# lists files at all. A stall is a `sh` loop that keeps its arguments in
# its own argv, so a test can match the stalled process by the unique text
# they carry and show it is gone after the run. Anything else is a loud
# failure.
# (`docs/testing.md`, "Testing an extension": a test never executes a file
# it wrote in the same run, so this fixture is checked in executable.)

stall() {
    exec sh -c 'while :; do :; done' stall-git "$@"
}

if [ "$1" = "ls-remote" ]; then
    for arg in "$@"; do
        case "$arg" in
            *stall-ls-remote*)
                stall "$@"
                ;;
        esac
    done
    printf '0123456789abcdef0123456789abcdef01234567\trefs/tags/v1.0.0\n'
    exit 0
fi

if [ "$1" = "clone" ]; then
    for arg in "$@"; do
        case "$arg" in
            *stall-clone*)
                stall "$@"
                ;;
        esac
    done
fi

if [ "$1" = "ls-files" ]; then
    stall "$@"
fi

echo "fake-git: unexpected arguments: $*" >&2
exit 1
