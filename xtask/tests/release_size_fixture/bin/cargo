#!/usr/bin/env bash
# Stands in for cargo in the release-size and paging-jig tests. A build run
# from a directory whose path contains $FAKE_CARGO_FAIL_IN fails; successful
# builds record their target and commit, keep one crate marker per target,
# and embed the marker in the fake binary so tests can identify linked output.
case $PWD in
  *"${FAKE_CARGO_FAIL_IN:?}"*) echo "error: could not compile fiber" >&2; exit 101 ;;
esac
dir="$CARGO_TARGET_DIR/x86_64-unknown-linux-musl/release"
mkdir -p "$dir/examples"
commit=$(git rev-parse --short HEAD)
printf '%s\t%s\n' "$CARGO_TARGET_DIR" "$commit" >> "${FAKE_CARGO_LOG:?}"
marker="$CARGO_TARGET_DIR/crate-marker"
if [ "${FAKE_CARGO_REUSE_TARGET:-}" != "$CARGO_TARGET_DIR" ]; then
  printf 'crate from %s\n' "$commit" > "$marker"
fi
payload="built at $commit; linked $(cat "$marker")"
case " $* " in
  *" --example "*) printf '%s\n' "$payload" > "$dir/examples/paging" ;;
  *) printf '%s\n' "$payload" > "$dir/fiber" ;;
esac
