#!/usr/bin/env bash
# Runs the red commit's new and changed tests at the red commit, and passes
# only if at least one of them fails there (docs/testing.md, "Proving a test
# bites"). The red commit is the pull request's first commit after the merge
# base: it holds the reproducing test and any new signature or test seam the
# test needs, but not the fix. A test counts as changed when its test file
# changed in the red commit itself, against its parent; the head is covered
# by the normal test jobs.
#
# Usage: scripts/bug-red BASE [HEAD]
#        scripts/bug-red --report BASE HEAD
#        scripts/bug-red --collect LINUX_STATUS MACOS_STATUS
# A pull request that changes only docs passes at once, with a message
# saying so: the doc was wrong and the code was right, so no test can show
# the bug. A red commit whose only test files belong to `test = false`
# targets passes too, with a message saying so: those tests run only on push
# until #3899 step 6, so a plain nextest filter would match none of them.
# Each leg drops the planned tests its platform does not compile and names
# them. A plan left empty on both legs fails with the no-match status.
# --report writes nextest's status class, or `docs` or `journey` for the
# docs-only and journey-only cases, to GITHUB_OUTPUT and lets the collector
# decide whether this leg passed. --collect accepts a test failure on either
# platform, but requires a build on both.
set -euo pipefail

journey_only="the red commit's only touched tests are journey tests, which pull-request CI does not run until #3899 step 6"

if [ "${1-}" = --collect ]; then
  [ "$#" -eq 3 ] || { echo "usage: scripts/bug-red --collect LINUX_STATUS MACOS_STATUS" >&2; exit 2; }
  linux_status=$2
  macos_status=$3
  if [ "$linux_status" = docs ] || [ "$macos_status" = docs ]; then
    if [ "$linux_status" = docs ] && [ "$macos_status" = docs ]; then
      echo "bug-red: both legs confirm the pull request changes only docs"
      exit 0
    fi
    echo "bug-red: docs-only result disagrees between legs (linux=$linux_status, macos=$macos_status)"
    exit 1
  fi
  if [ "$linux_status" = journey ] || [ "$macos_status" = journey ]; then
    if [ "$linux_status" = journey ] && [ "$macos_status" = journey ]; then
      echo "bug-red: both legs confirm $journey_only"
      exit 0
    fi
    echo "bug-red: journey-only result disagrees between legs (linux=$linux_status, macos=$macos_status)"
    exit 1
  fi
  for status in "$linux_status" "$macos_status"; do
    case "$status" in
      '' | *[!0-9]*)
        echo "bug-red: missing or invalid platform result (linux=$linux_status, macos=$macos_status)"
        exit 1
        ;;
    esac
  done
  if [ "$linux_status" -eq 101 ] || [ "$macos_status" -eq 101 ]; then
    echo "bug-red: the red commit must build on both platforms (linux=$linux_status, macos=$macos_status)"
    exit 1
  fi
  for status in "$linux_status" "$macos_status"; do
    case "$status" in
      0 | 4 | 100) : ;;
      *) echo "bug-red: nextest failed unexpectedly (linux=$linux_status, macos=$macos_status)"; exit 1 ;;
    esac
  done
  if [ "$linux_status" -eq 100 ] || [ "$macos_status" -eq 100 ]; then
    echo "bug-red: red commit failed tests on at least one platform (linux=$linux_status, macos=$macos_status)"
    exit 0
  fi
  echo "bug-red: every red-commit test passed or no test ran (linux=$linux_status, macos=$macos_status)"
  exit 1
fi

report=false
if [ "${1-}" = --report ]; then
  report=true
  shift
fi
report_status() {
  if [ "$report" = true ]; then
    if [ -z "${GITHUB_OUTPUT:-}" ]; then
      echo "bug-red: --report needs GITHUB_OUTPUT" >&2
      exit 2
    fi
    printf 'status=%s\n' "$1" >>"$GITHUB_OUTPUT"
  fi
}
case "$#" in
  1 | 2) ;;
  *) echo "usage: scripts/bug-red [--report] BASE [HEAD]" >&2; exit 2 ;;
esac
cd "$(git rev-parse --show-toplevel)"

base=$1
# Resolve to a SHA once: the one-commit check below compares SHAs.
if ! prhead=$(git rev-parse --verify --quiet "${2:-HEAD}^{commit}"); then
  echo "bug-red: ${2:-HEAD} is not a commit in this checkout"
  exit 1
fi
merge_base=$(git merge-base "$base" "$prhead")
# A docs-only diff has no code for a test to show the bug, so the check
# passes before the one-commit check. Only exit 0 means docs-only; exit 1
# falls through, and any other xtask failure fails the script.
# NUL-delimited: a spaced name stays one word and a glob character in a
# name never expands. git diff failing exits the script under set -e.
names=$(mktemp)
git diff --name-only --no-renames -z "$merge_base" "$prhead" > "$names"
files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < "$names"
rm -f "$names"
docs_only_status=0
cargo xtask docs-only ${files[@]+"${files[@]}"} >/dev/null || docs_only_status=$?
if [ "$docs_only_status" -eq 0 ]; then
  echo "bug-red: ok, the pull request changes only docs, so it has no code for a test to show the bug"
  report_status docs
  exit 0
elif [ "$docs_only_status" -ne 1 ]; then
  exit "$docs_only_status"
fi
red=$(git rev-list --reverse --topo-order --no-merges "$merge_base..$prhead" | sed -n '1p')
if [ -z "$red" ] || [ "$red" = "$prhead" ]; then
  echo "bug-red: the pull request has one commit; push the reproducing test and the fix as separate commits, the test first"
  exit 1
fi
# shellcheck disable=SC2046
plan=$(cargo xtask bug-filter $(git diff --name-only --diff-filter=AM "$red^" "$red"))
filter=$(sed -n 's/^filter\t//p' <<<"$plan")
if [ -z "$filter" ] && [ -n "$(sed -n 's/^unrun\t//p' <<<"$plan")" ]; then
  echo "bug-red: ok, $journey_only"
  report_status journey
  exit 0
fi
if [ -z "$filter" ]; then
  echo "bug-red: the red commit changes no test file, so no test shows the bug"
  exit 1
fi

tree=$(mktemp -d)
list=$(mktemp)
git worktree add --quiet --detach "$tree" "$red"
trap 'git worktree remove --force "$tree"; rm -f "$list"' EXIT

package_args=()
while IFS=$'\t' read -r -a fields; do
  kind=${fields[0]:-}
  if [ "$kind" = package ]; then
    # The `log` crate shares its name with crates.io `log`: name its version.
    if [ "${fields[1]}" = log ]; then
      package_args+=(-p log@0.0.0)
    else
      package_args+=(-p "${fields[1]}")
    fi
  fi
done <<<"$plan"

# The red commit is what this leg compiles. Listing there, with the same
# packages and filter, names the tests this platform built. A planned test
# missing from that list is compiled out: say so, drop it from the filter,
# and an empty remainder is the no-match result.
planned=$(sed -n '/^planned\t/p' <<<"$plan")
if [ -n "$planned" ]; then
  (cd "$tree" && cargo nextest list --message-format json --color never --no-pager "${package_args[@]}" -E "$filter") >"$list"
  narrowed=$(printf '%s\n' "$planned" | cargo xtask narrow-plan --list "$list" --filter "$filter")
  sed -n 's/^dropped\t/bug-red: dropping /p' <<<"$narrowed"
  if [ "$(sed -n 's/^run\t//p' <<<"$narrowed")" != true ]; then
    echo "bug-red: none of the red commit's tests runs at the red commit"
    report_status 4
    [ "$report" = true ] || exit 1
    exit 0
  fi
  filter=$(sed -n 's/^filter\t//p' <<<"$narrowed")
fi

echo "bug-red: running $filter at $red"
status=0
(cd "$tree" && cargo nextest run --no-fail-fast "${package_args[@]}" -E "$filter") || status=$?

# nextest-metadata's exit codes: 100 when a test failed, 101 when the build
# failed and 4 when no test matched. Only a failed test shows the bug.
case $status in
  100)
    echo "bug-red: ok, one of the red commit's tests fails at the red commit"
    report_status "$status"
    ;;
  0)
    echo "bug-red: every one of the red commit's tests passes at the red commit, so none shows the bug"
    report_status "$status"
    [ "$report" = true ] || exit 1
    ;;
  101)
    echo "bug-red: the red commit $red does not build; it must build without the fix"
    report_status "$status"
    [ "$report" = true ] || exit 1
    ;;
  4)
    echo "bug-red: none of the red commit's tests runs at the red commit"
    report_status "$status"
    [ "$report" = true ] || exit 1
    ;;
  *)
    echo "bug-red: nextest exited $status at the red commit"
    report_status "$status"
    [ "$report" = true ] || exit 1
    ;;
esac
