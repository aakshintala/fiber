#!/usr/bin/env bash
# The self-test for the flake report (.github/workflows/ci.yml, jobs
# flake_decide and flake_report; docs/testing/running.md, "Flaky tests").
# It runs the decide job's classify block for real, cut from the workflow
# file, with a `git` shim answering history from the case's fixture, and
# the writer step's own script, cut the same way, against a stub `gh`
# that records each write and answers each read from the case's fixture,
# plus the classification and decision artifacts the case stages. A
# minimal `jq` fake answers only the steps' fixed queries. Every write
# path is proven: a new
# issue carrying the test-only label, a comment on an open issue, a pull
# request comment for a failing file the pull request owns, and a validated
# reopen with its sighting comment and needs-triage. Every no-write path
# is proven: stale-base and PR-owned classifications that skip the open
# lookup, stale and source-aware unknown actions, the four reopen
# predicate mismatches, a fetch that fails, a recheck that fails or finds
# an open issue before reopen or create, a failed open lookup, an invalid
# or unrecognised classification, an invalid or missing decision, and the
# fail-closed guards on the decision result, the decision artifact and
# the classification, including a missing history input. A duplicate title
# writes once. A throwaway repo proves the two three-dot diffs, including
# a rebased and a force-pushed head. The script also exercises
# scripts/flaky-tests on malformed XML, proving collection fails with no
# list (the incomplete marker path) instead of a complete empty list.
# Each body names the tested commit from the classification record:
# `tested <sha> = main <base> + head <head>` on a pull request run with
# two parents, and `tested <sha>` on a push run or a pull request run with
# one parent. Nothing reaches the GitHub API.
#
# Usage: scripts/test-flake-report
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
toplevel=$(pwd)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# The decide self-check needs the real jq before any stub goes on PATH.
# A missing jq fails the check; it never skips.
orig_path=$PATH
real_jq=$(command -v jq || true)
[ -n "$real_jq" ] || {
  echo "scripts/test-flake-report: jq is required for the flake decide self-check" >&2
  exit 1
}
real_git=$(command -v git || true)
[ -n "$real_git" ] || {
  echo "scripts/test-flake-report: git is required for the classify self-check" >&2
  exit 1
}
real_cargo=$(command -v cargo || true)
[ -n "$real_cargo" ] || {
  echo "scripts/test-flake-report: cargo is required for the classify self-check" >&2
  exit 1
}

fail() {
  echo "scripts/test-flake-report: $1" >&2
  exit 1
}

# The step is the one whose name is given below: its `run: |` block, every
# line indented past the `run:` key. No YAML parser: the name is unique.
awk '
  index($0, "- name: File or comment on the flake issues") { armed = 1; next }
  armed && !started && $0 ~ /^ *run: \|$/ { started = 1; match($0, /[^ ]/); indent = RSTART - 1; next }
  started {
    if ($0 ~ /^ *$/) { print ""; next }
    match($0, /[^ ]/)
    if (RSTART - 1 <= indent) exit
    print
  }
' .github/workflows/ci.yml >"$tmp/step.sh"
grep -Fq 'flake_body() {' "$tmp/step.sh" || fail "the flake report step's script was not found in .github/workflows/ci.yml"
grep -Fq 'open_number() {' "$tmp/step.sh" || fail "the flake report step's open lookup was not found in .github/workflows/ci.yml"

# The stub, written ahead of the step so it needs no executable on PATH.
# A write becomes one file, numbered in order. A comment file holds
# `comment <number>` then the body exactly; a create file holds
# `create <title>`, the body, then `label=<label>`; a reopen file holds
# `reopen <number>`; a label file holds `label <number> <label>`. The open
# lookup answers $STUB_OPEN every call, or $STUB_OPEN_FIRST once then
# $STUB_OPEN_REST; STUB_OPEN_FAIL fails every open call and
# STUB_OPEN_REST_FAIL fails the calls after the first. Any history call
# (`commits`, `compare`, `pulls`) is unexpected: the file lists come from
# the classification, never from the API.
cat >"$tmp/stub.sh" <<'EOF'
gh() {
  case "$1" in
    api)
      case "$*" in
        *"state=open"*)
          n=0
          if [ -f "$STUB_CALLS/../open-calls" ]; then n=$(cat "$STUB_CALLS/../open-calls"); fi
          echo "$((n + 1))" >"$STUB_CALLS/../open-calls"
          if [ -n "${STUB_OPEN_FAIL:-}" ]; then return 1; fi
          if [ "$n" -gt 0 ] && [ -n "${STUB_OPEN_REST_FAIL:-}" ]; then return 1; fi
          if [ "$n" -gt 0 ] && [ -n "${STUB_OPEN_REST:-}" ]; then printf '%s\n' "$STUB_OPEN_REST"; else printf '%s\n' "${STUB_OPEN_FIRST:-$STUB_OPEN}"; fi
          ;;
        *"/issues/"*)
          if [ -n "${STUB_ISSUE_FAIL:-}" ]; then return 1; fi
          printf '%s\n' "$STUB_ISSUE"
          ;;
        *) echo "stub gh: unexpected api call: $*" >&2; return 1 ;;
      esac
      ;;
    issue)
      verb=$2
      shift 2
      case "$verb" in
        comment) header="comment $1"; shift ;;
        create) header="create" ;;
        reopen)
          n=$(find "$STUB_CALLS" -type f | wc -l | tr -d ' ')
          printf 'reopen %s\n' "$1" >"$STUB_CALLS/$n"
          return 0
          ;;
        edit)
          n=$(find "$STUB_CALLS" -type f | wc -l | tr -d ' ')
          [ "$2" = --add-label ] || { echo "stub gh: unexpected edit flag: $2" >&2; return 1; }
          printf 'label %s %s\n' "$1" "$3" >"$STUB_CALLS/$n"
          return 0
          ;;
        *) echo "stub gh: unexpected issue verb: $verb" >&2; return 1 ;;
      esac
      title=""
      body=""
      label=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --title) title=$2 ;;
          --body) body=$2 ;;
          --label) label=$2 ;;
          *) echo "stub gh: unexpected argument: $1" >&2; return 1 ;;
        esac
        shift 2
      done
      [ "$verb" = create ] && header="create $title"
      n=$(find "$STUB_CALLS" -type f | wc -l | tr -d ' ')
      if [ "$verb" = create ]; then
        printf '%s\n%s\nlabel=%s' "$header" "$body" "$label" >"$STUB_CALLS/$n"
      else
        printf '%s\n%s' "$header" "$body" >"$STUB_CALLS/$n"
      fi
      ;;
    *) echo "stub gh: unexpected call: $*" >&2; return 1 ;;
  esac
}
EOF
cat "$tmp/stub.sh" "$tmp/step.sh" >"$tmp/run.sh"

# The decide job's classify block, cut with the same shape: the step is
# the one whose name is given below. The writer cases run it for real
# through `classify_case`.
awk '
  index($0, "- name: Classify the flaky tests by failing file") { armed = 1; next }
  armed && !started && $0 ~ /^ *run: \|$/ { started = 1; match($0, /[^ ]/); indent = RSTART - 1; next }
  started {
    if ($0 ~ /^ *$/) { print ""; next }
    match($0, /[^ ]/)
    if (RSTART - 1 <= indent) exit
    print
  }
' .github/workflows/ci.yml >"$tmp/classify.sh"
grep -Fq 'flake-classify' "$tmp/classify.sh" || fail "the classify step's script was not found in .github/workflows/ci.yml"
grep -Fq 'git diff --name-only' "$tmp/classify.sh" || fail "the classify step's file lists were not found in .github/workflows/ci.yml"

# The `git` function answers only the classify block's fixed history
# queries from the case's fixture and runs the real git for anything else.
# The main-side `diff --name-only` call is the one whose range ends in
# `origin/main`; it prints STUB_COMPARE, the other prints STUB_PR_FILES.
# `rev-parse <sha>^1` prints the first STUB_PARENTS word, `^2` the second,
# or nothing when the run has one parent. The case's bash sources it before
# the block, so no shim is executed through PATH: a test does not execute a
# file it wrote in the same run (docs/testing.md, "Waits and timeouts").
cat >"$tmp/git-stub.sh" <<'GIT_EOF'
git() {
  if [ "${1:-}" = rev-parse ] && [ $# -eq 2 ]; then
    case "$2" in
      *^1) printf '%s\n' "${STUB_PARENTS%% *}" ;;
      *^2)
        if [ -n "${STUB_REVPARSE_FAIL:-}" ]; then
          echo "stub git: fatal: unknown revision '$2'" >&2
          return 128
        fi
        case "$STUB_PARENTS" in
          *" "*) printf '%s\n' "${STUB_PARENTS##* }" ;;
          *) printf '\n' ;;
        esac
        ;;
      *) echo "stub git: unexpected rev-parse: $*" >&2; return 1 ;;
    esac
    return 0
  fi
  if [ "${1:-}" = diff ] && [ "${2:-}" = --name-only ] && [ $# -eq 3 ]; then
    if [ -n "${STUB_DIFF_FAIL:-}" ]; then
      echo "stub git: fatal: unable to read tree ($3)" >&2
      return 128
    fi
    local list
    case "$3" in
      *...origin/main)
        if [ -n "${STUB_NO_ORIGIN_MAIN:-}" ]; then
          echo "stub git: fatal: no such ref 'origin/main'" >&2
          return 128
        fi
        list=$STUB_COMPARE
        ;;
      *) list=$STUB_PR_FILES ;;
    esac
    if [ -n "$list" ]; then printf '%s\n' "$list"; fi
    return 0
  fi
  command git "$@"
}
GIT_EOF

# `jq` is absent on the Linux runners (docs/testing/running.md, "Running
# tests"), so the writer's fixed queries run against this minimal fake. It
# answers only the exact filters the step uses and fails any other filter,
# so a new query is added here deliberately. The full JSON contract lives
# in the Rust tests.
mkdir -p "$tmp/bin"
cat >"$tmp/bin/jq" <<'EOF'
#!/usr/bin/env python3
"""Minimal jq for the flake report writer's fixed queries only."""
import json
import sys


def fail(message):
    sys.stderr.write(f"stub jq: {message}\n")
    sys.exit(2)


argv = sys.argv[1:]
args = {}
positionals = []
i = 0
while i < len(argv):
    if argv[i] in ("-r", "-s", "-e", "-c"):
        pass
    elif argv[i] == "--arg":
        args[argv[i + 1]] = argv[i + 2]
        i += 2
    elif argv[i].startswith("-") and argv[i] != "-":
        fail(f"unsupported flag {argv[i]}")
    else:
        positionals.append(argv[i])
    i += 1
if not positionals:
    fail("want a filter")
fil = positionals[0]


def read_docs():
    if positionals[1:]:
        text = ""
        for path in positionals[1:]:
            with open(path, encoding="utf-8") as handle:
                text += handle.read() + "\n"
    else:
        text = sys.stdin.read()
    docs = []
    decoder = json.JSONDecoder()
    rest = text.strip()
    while rest:
        try:
            doc, end = decoder.raw_decode(rest)
        except json.JSONDecodeError as err:
            fail(f"invalid JSON: {err}")
        docs.append(doc)
        rest = rest[end:].strip()
    return docs


title = args.get("t", "")

if ".[0].number // empty" in fil:
    # The open lookup: slurped paginated pages, the first exact-title
    # issue that is not a pull request.
    for doc in read_docs():
        items = doc if isinstance(doc, list) else [doc]
        found = None
        for item in items:
            if (
                isinstance(item, dict)
                and item.get("title") == title
                and item.get("pull_request") is None
            ):
                found = item.get("number")
                break
        if isinstance(found, int):
            print(found)
            break
elif fil == "select(.title == $t)":
    # The decision for this title: one compact line per match.
    for doc in read_docs():
        if isinstance(doc, dict) and doc.get("title") == title:
            print(json.dumps(doc, sort_keys=True))
elif fil.startswith(".") and fil.endswith(" // empty"):
    # One field of a classification record or a selected decision line:
    # action, title, name, runner, detail, failing, base, tested, issue,
    # source. Absent fields print nothing.
    key = fil[1:].split()[0]
    for doc in read_docs():
        value = doc.get(key) if isinstance(doc, dict) else None
        if isinstance(value, str):
            print(value)
        elif isinstance(value, int):
            print(value)
elif ".pull_request == null and" in fil and ".state" in fil:
    # The reopen validation of the single fetched issue.
    docs = read_docs()
    fetched = docs[0] if docs else None
    labels = []
    if isinstance(fetched, dict):
        labels = [
            label.get("name")
            for label in fetched.get("labels", [])
            if isinstance(label, dict)
        ]
    ok = (
        isinstance(fetched, dict)
        and fetched.get("pull_request") is None
        and fetched.get("state") == "closed"
        and fetched.get("title") == title
        and "test-only" in labels
    )
    sys.exit(0 if ok else 1)
else:
    fail(f"unsupported filter: {fil}")
EOF
chmod +x "$tmp/bin/jq"
export PATH="$tmp/bin:$PATH"

sha=1111111111111111111111111111111111111111
base=2222222222222222222222222222222222222222
head=3333333333333333333333333333333333333333
url=https://github.example/aakshintala/fiber/actions/runs/1
name='main::flaky_probe fails_once_then_passes'
title='Flaky tests: main::flaky_probe'
detail='thread fails_once_then_passes panicked at crates/main/tests/flaky_probe.rs:10:9\nfirst attempt'
fence='```'

push_tested="tested $sha"
pr_tested="tested $sha = main $base + head $head"
plain="The test \`$name\` passed after a retry on linux: $url."
see_pr="$plain (see #12)"
belongs="The test \`$name\` passed after a retry on linux, but its failing file \`crates/main/tests/flaky_probe.rs\` belongs to #12 rather than main: $url."
unit_name='fakes process_group_tests::reaps_children'
unit_title='Flaky tests: fakes process_group'
unit_detail='thread reaps_children panicked at crates/fakes/tests/process_group.rs:10:9\nfirst attempt'
unit_decide='{"action": "file-new", "title": "'"$unit_title"'"}'

# The body is the sentence, the tested line, then the failure in a fence.
body() {
  printf '%s\n%s\n%s\n%s\n%s' "$1" "$2" "$fence" "$detail" "$fence"
}

# setup_case DIR: the sandbox for one case. The writer reads the
# combined artifact layout: the classification plus the decisions in one
# directory; the classify block reads the flaky lists from another.
setup_case() {
  dir=$tmp/$1
  mkdir -p "$dir/temp/flaky" "$dir/temp/report-data" "$dir/calls"
  printf '%s\t%s\n' "$name" "$detail" >"$dir/temp/flaky/flaky-tests-linux.txt"
}

# classify_case DIR EVENT PARENTS COMPARE PR_FILES EXTRA...: runs the real
# extracted classify block with the git shim answering history from the
# case fixtures (the main-side diff is the call whose range ends in
# origin/main) and cargo xtask for real, then lays out the writer's
# artifact: the produced flake-classes.jsonl plus the case's
# decisions.jsonl, both under $dir/temp/report-data. Prints the block's
# exit code. STUB_REVPARSE_FAIL, STUB_DIFF_FAIL and STUB_NO_ORIGIN_MAIN
# fail the matching history call instead, for the fail-closed cases.
classify_case() {
  dir=$1
  event=$2
  parents=$3
  compare=$4
  pr_files=$5
  shift 5
  code=0
  mkdir -p "$dir/temp/flake-report-data" "$dir/temp/report-data"
  cp "$dir/decisions.jsonl" "$dir/temp/report-data/decisions.jsonl"
  # The inner bash expands $1 and $2, so the -c script is single-quoted.
  # shellcheck disable=SC2086,SC2016
  env -i PATH="$orig_path" HOME="$HOME" TMPDIR="${TMPDIR:-/tmp}" FIBER_CHECK_RUN="${FIBER_CHECK_RUN:-}" \
    RUNNER_TEMP="$dir/temp" GITHUB_SHA="$sha" GITHUB_EVENT_NAME="$event" \
    GH_REPO=aakshintala/fiber \
    STUB_PARENTS="$parents" STUB_COMPARE="$compare" STUB_PR_FILES="$pr_files" \
    "$@" \
    bash --noprofile --norc -eo pipefail -c '. "$1"; . "$2"' classify "$tmp/git-stub.sh" "$tmp/classify.sh" >"$dir/classify-out" 2>"$dir/classify-err" || code=$?
  if [ "$code" -ne 0 ]; then
    echo "$code"
    return 0
  fi
  cp "$dir/temp/flake-report-data/flake-classes.jsonl" "$dir/temp/report-data/flake-classes.jsonl"
  echo "$code"
}

# run_step DIR EVENT PR OPEN ISSUE DECISIONS EXTRA...: runs the writer
# step and prints its exit code. OPEN is the open-issue list fixture,
# ISSUE the single-issue fixture, DECISIONS the JSON-lines decision file
# under the report-data dir; further VAR=value arguments reach the
# environment.
run_step() {
  dir=$1
  event=$2
  pr=$3
  open=$4
  issue=$5
  decisions=$6
  shift 6
  code=0
  # shellcheck disable=SC2086
  env -i PATH="$PATH" HOME="$dir" \
    RUNNER_TEMP="$dir/temp" GITHUB_SHA="$sha" GITHUB_EVENT_NAME="$event" \
    GITHUB_RUN_ID=1 GITHUB_STEP_SUMMARY="$dir/summary" \
    GH_REPO=aakshintala/fiber GH_TOKEN=test RUN_URL="$url" PR="$pr" \
    STUB_OPEN="$open" STUB_ISSUE="$issue" STUB_CALLS="$dir/calls" \
    DECIDE_RESULT=success DECIDE_FLAKES=true DECISIONS="$dir/temp/report-data/$decisions" CLASSES="$dir/temp/report-data/flake-classes.jsonl" \
    "$@" \
    bash --noprofile --norc -eo pipefail "$tmp/run.sh" 2>"$dir/err" || code=$?
  [ -s "$dir/err" ] && { cat "$dir/err" >&2; fail "$dir: the step printed to stderr"; }
  echo "$code"
}

writes() {
  find "$1/calls" -type f ! -name '.*' | wc -l | tr -d ' '
}

expect_write() {
  got=$(cat "$1/calls/$2")
  [ "$got" = "$3" ] || {
    echo "--- want:" >&2
    printf '%s\n' "$3" >&2
    echo "--- got:" >&2
    printf '%s\n' "$got" >&2
    fail "$1: the write differs"
  }
}

expect_summary() {
  got=$(cat "$1/summary" 2>/dev/null || true)
  [ "$got" = "$2" ] || {
    echo "--- want summary:" >&2
    printf '%s\n' "$2" >&2
    echo "--- got summary:" >&2
    printf '%s\n' "$got" >&2
    fail "$1: the summary differs"
  }
}

expect_exit() {
  [ "$2" = "$3" ] || fail "$1: want exit $3, got $2"
}

expect_writes() {
  got=$(writes "$1")
  [ "$got" = "$2" ] || fail "$1: want $2 writes, got $got"
}

# expect_present DIR WANT: WANT is among the writes, wherever it lands.
expect_present() {
  for f in "$1/calls/"*; do
    [ -f "$f" ] || continue
    if [ "$(cat "$f")" = "$2" ]; then return 0; fi
  done
  echo "--- want present:" >&2
  printf '%s\n' "$2" >&2
  echo "--- got writes:" >&2
  for f in "$1/calls/"*; do [ -f "$f" ] && printf '%s\n' "$(cat "$f")" >&2; done
  fail "$1: a documented write is missing"
}

empty_open="[]"
open7='[{"number": 7, "title": "'"$title"'"}]'
issue9='{"number": 9, "title": "'"$title"'", "state": "closed", "labels": [{"name": "test-only"}]}'
decide_new='{"action": "file-new", "title": "'"$title"'"}'
decide_reopen='{"action": "reopen", "issue": 9, "title": "'"$title"'"}'
decide_stale='{"action": "stale", "issue": 9, "title": "'"$title"'"}'
decide_unknown='{"action": "unknown", "source": "closed", "title": "'"$title"'"}'
decide_unknown_bare='{"action": "unknown", "title": "'"$title"'"}'

sighting=$(printf 'comment 9\n%s' "$(body "$plain" "$push_tested")")
probe_file=crates/main/tests/flaky_probe.rs
detail_nofile='thread fails_once_then_passes panicked at nowhere'
detail_nopanic="thread failed at $probe_file:10: some output"

# A push run with both file lists present and the failing file in both:
# a new issue carrying the test-only label, then a comment on the open
# one. The lists are ignored off a pull request event.
setup_case push-create
printf '%s\n' "$decide_new" >"$tmp/push-create/decisions.jsonl"
code=$(classify_case "$tmp/push-create" push "" "$probe_file" "$probe_file")
expect_exit push-create-classify "$code" 0
code=$(run_step "$tmp/push-create" push "" "$empty_open" "" decisions.jsonl)
expect_exit push-create "$code" 0
expect_writes "$tmp/push-create" 1
expect_write "$tmp/push-create" 0 "$(printf 'create %s\n%s\nlabel=test-only' "$title" "$(body "$plain" "$push_tested")")"

setup_case push-comment
: >"$tmp/push-comment/decisions.jsonl"
code=$(classify_case "$tmp/push-comment" push "" "" "")
expect_exit push-comment-classify "$code" 0
code=$(run_step "$tmp/push-comment" push "" "$open7" "" decisions.jsonl)
expect_exit push-comment "$code" 0
expect_writes "$tmp/push-comment" 1
expect_write "$tmp/push-comment" 0 "$(printf 'comment 7\n%s' "$(body "$plain" "$push_tested")")"

# A line with no TAB names the whole line and files without a fence.
setup_case push-no-tab
printf '%s\n' "$name" >"$tmp/push-no-tab/temp/flaky/flaky-tests-linux.txt"
printf '%s\n' "$decide_new" >"$tmp/push-no-tab/decisions.jsonl"
code=$(classify_case "$tmp/push-no-tab" push "" "" "")
expect_exit push-no-tab-classify "$code" 0
code=$(run_step "$tmp/push-no-tab" push "" "$empty_open" "" decisions.jsonl)
expect_exit push-no-tab "$code" 0
# docs/testing/running.md, "Flaky tests": "A failure with no panic path, or any failure on a push run, files as usual"
expect_writes "$tmp/push-no-tab" 1
expect_write "$tmp/push-no-tab" 0 "$(printf 'create %s\n%s\n%s\nlabel=test-only' "$title" "$plain" "$push_tested")"

# A unit-test flake files under its per-file title: the binary plus the
# test file from the first `*_tests` module segment.
setup_case push-create-unit
printf '%s\t%s\n' "$unit_name" "$unit_detail" >"$tmp/push-create-unit/temp/flaky/flaky-tests-linux.txt"
printf '%s\n' "$unit_decide" >"$tmp/push-create-unit/decisions.jsonl"
code=$(classify_case "$tmp/push-create-unit" push "" "" "")
expect_exit push-create-unit-classify "$code" 0
code=$(run_step "$tmp/push-create-unit" push "" "$empty_open" "" decisions.jsonl)
expect_exit push-create-unit "$code" 0
expect_writes "$tmp/push-create-unit" 1
unit_plain="The test \`$unit_name\` passed after a retry on linux: $url."
expect_write "$tmp/push-create-unit" 0 "$(printf 'create %s\n%s\nlabel=test-only' "$unit_title" "$(detail="$unit_detail" body "$unit_plain" "$push_tested")")"

# A pull request run with two parents, main then the pull request head: a
# new issue naming the pull request, a comment on the open one, a comment
# for a failing file the pull request changed, and nothing but a summary
# for a failing file main changed since the base.
setup_case pr-create
printf '%s\n' "$decide_new" >"$tmp/pr-create/decisions.jsonl"
code=$(classify_case "$tmp/pr-create" pull_request "$base $head" "" "other/file.rs")
expect_exit pr-create-classify "$code" 0
code=$(run_step "$tmp/pr-create" pull_request 12 "$empty_open" "" decisions.jsonl)
expect_exit pr-create "$code" 0
expect_writes "$tmp/pr-create" 1
expect_write "$tmp/pr-create" 0 "$(printf 'create %s\n%s\nlabel=test-only' "$title" "$(body "$see_pr" "$pr_tested")")"

setup_case pr-sighting
: >"$tmp/pr-sighting/decisions.jsonl"
code=$(classify_case "$tmp/pr-sighting" pull_request "$base $head" "" "other/file.rs")
expect_exit pr-sighting-classify "$code" 0
code=$(run_step "$tmp/pr-sighting" pull_request 12 "$open7" "" decisions.jsonl)
expect_exit pr-sighting "$code" 0
expect_writes "$tmp/pr-sighting" 1
expect_write "$tmp/pr-sighting" 0 "$(printf 'comment 7\n%s' "$(body "$see_pr" "$pr_tested")")"

setup_case pr-comment
: >"$tmp/pr-comment/decisions.jsonl"
code=$(classify_case "$tmp/pr-comment" pull_request "$base $head" "" "$probe_file")
expect_exit pr-comment-classify "$code" 0
code=$(run_step "$tmp/pr-comment" pull_request 12 "$empty_open" "" decisions.jsonl)
expect_exit pr-comment "$code" 0
# docs/testing/running.md, "Flaky tests": "when the pull request itself changed that file it comments on the pull request instead of filing"
expect_writes "$tmp/pr-comment" 1
expect_write "$tmp/pr-comment" 0 "$(printf 'comment 12\n%s' "$(body "$belongs" "$pr_tested")")"

setup_case pr-stale-base
: >"$tmp/pr-stale-base/decisions.jsonl"
code=$(classify_case "$tmp/pr-stale-base" pull_request "$base $head" "$probe_file" "other/file.rs")
expect_exit pr-stale-base-classify "$code" 0
code=$(run_step "$tmp/pr-stale-base" pull_request 12 "$empty_open" "" decisions.jsonl)
expect_exit pr-stale-base "$code" 0
# docs/testing/running.md, "Flaky tests": "when main changed that file since the run's tested base it files nothing and notes the stale base in the summary"
expect_writes "$tmp/pr-stale-base" 0
expect_summary "$tmp/pr-stale-base" "stale base: main changed $probe_file since $base"

# A stale base wins when both lists hold the failing file.
setup_case pr-stale-before-pr-owned
: >"$tmp/pr-stale-before-pr-owned/decisions.jsonl"
code=$(classify_case "$tmp/pr-stale-before-pr-owned" pull_request "$base $head" "$probe_file" "$probe_file")
