expect_exit duplicate-title-classify "$code" 0
code=$(run_step "$tmp/duplicate-title" push "" "$empty_open" "" decisions.jsonl)
expect_exit duplicate-title "$code" 0
# docs/testing/running.md, "Flaky tests": "Within one report job a file's title files or comments once; a repeat is skipped"
expect_writes "$tmp/duplicate-title" 1
arm_plain="The test \`$name\` passed after a retry on arm: $url."
expect_write "$tmp/duplicate-title" 0 "$(printf 'create %s\n%s\nlabel=test-only' "$title" "$(body "$arm_plain" "$push_tested")")"

# A missing history input fails the decide step, and the writer then
# files nothing: a failed rev-parse of the second parent, a failed diff,
# and a missing origin/main ref each end the classify block non-zero
# with the missing input named, and the writer exits 1 with no writes.
setup_case pr-missing-revparse
printf '%s\n' "$decide_new" >"$tmp/pr-missing-revparse/decisions.jsonl"
code=$(classify_case "$tmp/pr-missing-revparse" pull_request "$base $head" "" "" STUB_REVPARSE_FAIL=1)
[ "$code" -ne 0 ] || fail "pr-missing-revparse: the classify block must fail without the second parent"
[ ! -e "$tmp/pr-missing-revparse/temp/flake-report-data/flake-classes.jsonl" ] || fail "pr-missing-revparse: no classification may be written"
grep -q 'unknown revision' "$tmp/pr-missing-revparse/classify-err" || fail "pr-missing-revparse: the failure must name the missing revision"
code=$(run_step "$tmp/pr-missing-revparse" pull_request 12 "$empty_open" "" decisions.jsonl)
expect_exit pr-missing-revparse "$code" 1
expect_summary "$tmp/pr-missing-revparse" "flake_decide found flakes but their classification is missing: no write"

setup_case pr-missing-diff
printf '%s\n' "$decide_new" >"$tmp/pr-missing-diff/decisions.jsonl"
code=$(classify_case "$tmp/pr-missing-diff" pull_request "$base $head" "" "" STUB_DIFF_FAIL=1)
[ "$code" -ne 0 ] || fail "pr-missing-diff: the classify block must fail without the diff"
[ ! -e "$tmp/pr-missing-diff/temp/flake-report-data/flake-classes.jsonl" ] || fail "pr-missing-diff: no classification may be written"
grep -q 'unable to read tree' "$tmp/pr-missing-diff/classify-err" || fail "pr-missing-diff: the failure must name the missing input"
code=$(run_step "$tmp/pr-missing-diff" pull_request 12 "$empty_open" "" decisions.jsonl)
expect_exit pr-missing-diff "$code" 1
expect_summary "$tmp/pr-missing-diff" "flake_decide found flakes but their classification is missing: no write"

setup_case pr-missing-origin-main
printf '%s\n' "$decide_new" >"$tmp/pr-missing-origin-main/decisions.jsonl"
code=$(classify_case "$tmp/pr-missing-origin-main" pull_request "$base $head" "" "" STUB_NO_ORIGIN_MAIN=1)
[ "$code" -ne 0 ] || fail "pr-missing-origin-main: the classify block must fail without origin/main"
[ ! -e "$tmp/pr-missing-origin-main/temp/flake-report-data/flake-classes.jsonl" ] || fail "pr-missing-origin-main: no classification may be written"
grep -q "no such ref 'origin/main'" "$tmp/pr-missing-origin-main/classify-err" || fail "pr-missing-origin-main: the failure must name the missing ref"
code=$(run_step "$tmp/pr-missing-origin-main" pull_request 12 "$empty_open" "" decisions.jsonl)
expect_exit pr-missing-origin-main "$code" 1
expect_summary "$tmp/pr-missing-origin-main" "flake_decide found flakes but their classification is missing: no write"

# classify-real-git: the two three-dot diffs against a throwaway repo.
# main advances on another file after the PR branches, so the merge of
# old-main and the PR head lists a main-side file (stale-base) and a
# PR-side file (pr-owned). A second merge built from a rebased PR branch
# lists only the rebased changes, and a force-pushed head that rewrites
# the PR commit lists only the rewritten head's files. The ref layout
# matches a full-history checkout: refs/remotes/origin/main at the new
# main tip. cargo runs from the real checkout, since the block's working
# directory is the throwaway repo.
realgit=$tmp/real-git
mkdir -p "$realgit/work" "$realgit/temp/flaky"
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com
export GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
g() { "$real_git" -C "$realgit/work" "$@"; }
g init -q -b main
printf 'base\n' >"$realgit/work/base.txt"
g add base.txt
g commit -qm M1
m1=$(g rev-parse HEAD)
g checkout -qb pr
printf 'pr\n' >"$realgit/work/pr.rs"
g add pr.rs
g commit -qm P1
p1=$(g rev-parse HEAD)
g checkout -q main
printf 'main\n' >"$realgit/work/main.rs"
g add main.rs
g commit -qm M2
m2=$(g rev-parse HEAD)
g update-ref refs/remotes/origin/main "$m2"
g checkout -qb mg1 "$m1"
g merge -q --no-ff -m "merge pr" "$p1"
mg1=$(g rev-parse HEAD)
# cargo is a function the block's bash sources first, not an executable
# on PATH (docs/testing.md, "Waits and timeouts").
cat >"$realgit/cargo-stub.sh" <<CARGO_EOF
cargo() {
  [ "\$1" = xtask ] || { echo "stub cargo: unexpected call: \$*" >&2; return 1; }
  shift
  "$real_cargo" run --quiet --manifest-path "$toplevel/xtask/Cargo.toml" -- "\$@"
}
CARGO_EOF
classify_real() {
  rdir=$1
  rsha=$2
  code=0
  mkdir -p "$rdir/temp/flake-report-data"
  # The block's working directory is the throwaway repo, as in CI the
  # checkout is the working directory; the sourced cargo function
  # redirects cargo to the real checkout, and git is the real git.
  cd "$rdir/work" || fail "classify-real-git: cannot enter the throwaway repo"
  # shellcheck disable=SC2016 # the inner bash expands $1 and $2
  env -i PATH="$orig_path" HOME="$HOME" TMPDIR="${TMPDIR:-/tmp}" FIBER_CHECK_RUN="${FIBER_CHECK_RUN:-}" \
    RUNNER_TEMP="$rdir/temp" GITHUB_SHA="$rsha" GITHUB_EVENT_NAME=pull_request \
    GH_REPO=aakshintala/fiber \
    bash --noprofile --norc -eo pipefail -c '. "$1"; . "$2"' classify "$realgit/cargo-stub.sh" "$tmp/classify.sh" >"$rdir/classify-out" 2>"$rdir/classify-err" || code=$?
  cd "$toplevel" || fail "classify-real-git: cannot return to the checkout"
  [ "$code" = 0 ] || { cat "$rdir/classify-err" >&2; fail "classify-real-git: the classify block exited $code"; }
}
classify_action() {
  "$real_jq" -r --arg t "$2" "select(.title == \$t) | .action // empty" "$1"
}
# merge-head: the merge of old-main and the PR head.
printf 'main::old\tthread old panicked at main.rs:10\nmain::new\tthread new panicked at pr.rs:3\nmain::other\tthread other panicked at other.rs:5\n' >"$realgit/temp/flaky/flaky-tests-linux.txt"
classify_real "$realgit" "$mg1"
classes=$realgit/temp/flake-report-data/flake-classes.jsonl
[ "$(classify_action "$classes" 'Flaky tests: main::old')" = stale-base ] || fail "classify-real-git merge-head: main.rs must be stale-base"
[ "$(classify_action "$classes" 'Flaky tests: main::new')" = pr-owned ] || fail "classify-real-git merge-head: pr.rs must be pr-owned"
[ "$(classify_action "$classes" 'Flaky tests: main::other')" = lookup ] || fail "classify-real-git merge-head: other.rs must be lookup"
[ "$("$real_jq" -r --arg t 'Flaky tests: main::new' "select(.title == \$t) | .tested // empty" "$classes")" = "tested $mg1 = main $m1 + head $p1" ] || fail "classify-real-git merge-head: the tested line must name both parents"
# rebased-head: the PR branch rebased onto the new main and merged again.
# The new ^1...^2 range lists only the rebased changes.
g checkout -qb pr2 "$m2"
printf 'pr2\n' >"$realgit/work/pr2.rs"
g add pr2.rs
g commit -qm P2
p2=$(g rev-parse HEAD)
g checkout -qb mg2 "$m2"
g merge -q --no-ff -m "merge reprised" "$p2"
mg2=$(g rev-parse HEAD)
printf 'main::rebased\tthread rebased panicked at pr2.rs:3\nmain::oldpr\tthread oldpr panicked at pr.rs:3\nmain::main\tthread main panicked at main.rs:10\n' >"$realgit/temp/flaky/flaky-tests-linux.txt"
classify_real "$realgit" "$mg2"
[ "$(classify_action "$classes" 'Flaky tests: main::rebased')" = pr-owned ] || fail "classify-real-git rebased-head: pr2.rs must be pr-owned"
[ "$(classify_action "$classes" 'Flaky tests: main::oldpr')" = lookup ] || fail "classify-real-git rebased-head: pr.rs must be lookup, not pr-owned"
[ "$(classify_action "$classes" 'Flaky tests: main::main')" = lookup ] || fail "classify-real-git rebased-head: main.rs must be lookup, not stale"
[ "$("$real_jq" -r --arg t 'Flaky tests: main::rebased' "select(.title == \$t) | .tested // empty" "$classes")" = "tested $mg2 = main $m2 + head $p2" ] || fail "classify-real-git rebased-head: the tested line must name the rebased head"
# force-pushed-head: the PR commit is amended to drop pr2.rs and add
# pr3.rs, and the PR ref is force-updated to it, not a fast-forward. The
# merge of the rewritten head lists only its files, and the tested line
# names the rewritten head, not the one it replaced.
g checkout -q pr2
g rm -q pr2.rs
printf 'pr3\n' >"$realgit/work/pr3.rs"
g add pr3.rs
g commit -q --amend -m "P2 force-pushed"
p3=$(g rev-parse HEAD)
[ "$p3" != "$p2" ] || fail "classify-real-git: the force-pushed head must be a new commit"
[ "$(g rev-parse "$p3^")" = "$m2" ] || fail "classify-real-git: the force-pushed head must replace, not extend, the old head"
if g merge-base --is-ancestor "$p2" "$p3"; then
  fail "classify-real-git: the force-push must not be a fast-forward"
fi
g update-ref refs/remotes/origin/pr2 "$p2"
g update-ref refs/remotes/origin/pr2 "$p3" "$p2"
[ "$(g rev-parse refs/remotes/origin/pr2)" = "$p3" ] || fail "classify-real-git: the PR ref must point at the force-pushed head"
g checkout -qb mg3 "$m2"
g merge -q --no-ff -m "merge force-pushed" refs/remotes/origin/pr2
mg3=$(g rev-parse HEAD)
[ "$(g rev-parse "$mg3^2")" = "$p3" ] || fail "classify-real-git: the force-pushed merge must have the rewritten head as ^2"
printf 'main::rebased\tthread rebased panicked at pr2.rs:3\nmain::forced\tthread forced panicked at pr3.rs:3\nmain::main\tthread main panicked at main.rs:10\n' >"$realgit/temp/flaky/flaky-tests-linux.txt"
classify_real "$realgit" "$mg3"
[ "$(classify_action "$classes" 'Flaky tests: main::forced')" = pr-owned ] || fail "classify-real-git force-pushed-head: pr3.rs must be pr-owned"
[ "$(classify_action "$classes" 'Flaky tests: main::rebased')" = lookup ] || fail "classify-real-git force-pushed-head: pr2.rs, dropped by the force-push, must be lookup"
[ "$(classify_action "$classes" 'Flaky tests: main::main')" = lookup ] || fail "classify-real-git force-pushed-head: main.rs must be lookup"
[ "$("$real_jq" -r --arg t 'Flaky tests: main::forced' "select(.title == \$t) | .tested // empty" "$classes")" = "tested $mg3 = main $m2 + head $p3" ] || fail "classify-real-git force-pushed-head: the tested line must name the rewritten head"
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

# The Collate step titles one line per unique title, keyed by test file
# for unit-test binaries: the step is the one whose header contains
# "Collate this run", its `run: |` body up to the next step line. Each
# case runs it with the step's own env and asserts the exact titles
# file and the flakes output.
collate_dir=$tmp/collate
mkdir -p "$collate_dir"
awk '
  index($0, "Collate this run") { armed = 1; next }
  armed && !started && $0 ~ /^ *run: \|$/ { started = 1; match($0, /[^ ]/); indent = RSTART - 1; next }
  started {
    if ($0 ~ /^ *$/) { print ""; next }
    match($0, /[^ ]/)
    if (RSTART - 1 <= 8) exit
    print
  }
' .github/workflows/ci.yml >"$collate_dir/collate.sh"
[ -s "$collate_dir/collate.sh" ] || fail "the collate step's script was not found in .github/workflows/ci.yml"
grep -Fq 'Flaky tests:' "$collate_dir/collate.sh" || fail "the collate step does not title flakes"
# run_collate DIR: runs the extracted Collate step against DIR/flaky,
# writing DIR/out/flake-titles.txt and DIR/out/output.
run_collate() {
  dir=$1
  mkdir -p "$dir/out"
  : >"$dir/out/output"
  : >"$dir/out/summary"
  env -i PATH="$PATH" \
    FLAKY_DIR="$dir/flaky" LINUX_SELECTED=false LINUX_FLAKES=false LINUX_COMPLETE=true TEST_SELECTED=false \
    RUNNER_TEMP="$dir/out" GITHUB_OUTPUT="$dir/out/output" GITHUB_STEP_SUMMARY="$dir/out/summary" \
    bash --noprofile --norc -eo pipefail "$collate_dir/collate.sh" || fail "$dir: the collate step failed"
}
# expect_titles_sorted DIR WANT: the titles file holds exactly the titles in
# WANT as a set. The Collate step promises one line per unique title, not an
# order for distinct titles, so both sides are sorted before comparing; a
# duplicate or a missing title still fails.
# docs/testing/running.md, "Flaky tests": "Within one report job a file's title files or comments once; a repeat is skipped"
expect_titles_sorted() {
  got=$(LC_ALL=C sort "$1/out/flake-titles.txt")
  want=$(printf '%s\n' "$2" | LC_ALL=C sort)
  [ "$got" = "$want" ] || {
    echo "--- want titles (sorted):" >&2
    printf '%s\n' "$want" >&2
    echo "--- got titles (sorted):" >&2
    printf '%s\n' "$got" >&2
    fail "$1: the title set differs"
  }
}
# expect_titles DIR WANT: the titles file holds exactly WANT.
expect_titles() {
  got=$(cat "$1/out/flake-titles.txt")
  [ "$got" = "$2" ] || {
    echo "--- want titles:" >&2
    printf '%s\n' "$2" >&2
    echo "--- got titles:" >&2
    printf '%s\n' "$got" >&2
    fail "$1: the titles differ"
  }
}
expect_flakes() {
  got=$(cat "$1/out/output")
  [ "$got" = "$2" ] || fail "$1: want output $2, got $got"
}
# Two lines of one binary give exactly one title line.
collate_one=$tmp/collate-one
mkdir -p "$collate_one/flaky"
printf 'main::probe a\td1\nmain::probe b\td2\n' >"$collate_one/flaky/flaky-tests-linux.txt"
run_collate "$collate_one"
expect_titles "$collate_one" 'Flaky tests: main::probe'
expect_flakes "$collate_one" 'has_flakes=true'
# Two binaries give two title lines, in no promised order: the set, not the
# sequence, is asserted. Single-title cases above keep the exact comparison.
# docs/testing/running.md, "Flaky tests": "Within one report job a file's title files or comments once; a repeat is skipped"
collate_two=$tmp/collate-two
mkdir -p "$collate_two/flaky"
printf 'main::a t1\td1\nmain::b t1\td2\n' >"$collate_two/flaky/flaky-tests-linux.txt"
run_collate "$collate_two"
expect_titles_sorted "$collate_two" "$(printf 'Flaky tests: main::a\nFlaky tests: main::b')"
expect_flakes "$collate_two" 'has_flakes=true'
# A unit-test line with no `*_tests` module and the bare id give the
# one binary title: the module suffix is byte-exact, so a bare `tests`
# segment never names a file.
collate_unit=$tmp/collate-unit
mkdir -p "$collate_unit/flaky"
printf 'fiber-core tests::foo\td1\nfiber-core\td2\n' >"$collate_unit/flaky/flaky-tests-linux.txt"
run_collate "$collate_unit"
expect_titles "$collate_unit" 'Flaky tests: fiber-core'
expect_flakes "$collate_unit" 'has_flakes=true'
# A unit-test binary files one title per test file, while a unit test
# with no `*_tests` module, its bare id and an integration binary
# whose test name holds one keep the binary title. The shell and Rust
# derivations run over the same lines and agree byte-for-byte.
collate_key=$tmp/collate-key
mkdir -p "$collate_key/flaky"
{
  printf 'fakes process_group_tests::reaps_children\td1\nfakes signal_tests::delivers\td2\n'
  printf 'fakes tests::helper\td3\nfakes\td4\n'
  printf 'main::hub_exit_window helper_tests::case\td5\n'
} >"$collate_key/flaky/flaky-tests-linux.txt"
run_collate "$collate_key"
expect_titles_sorted "$collate_key" "$(printf 'Flaky tests: fakes process_group\nFlaky tests: fakes signal\nFlaky tests: fakes\nFlaky tests: main::hub_exit_window')"
expect_flakes "$collate_key" 'has_flakes=true'
"$real_cargo" run --quiet --manifest-path "$toplevel/xtask/Cargo.toml" -- flake-classify --flaky-dir "$collate_key/flaky" --event push --tested-commit "$sha" >"$collate_key/classes.jsonl" || fail "collate-key: flake-classify failed"
"$real_jq" -r .title "$collate_key/classes.jsonl" | LC_ALL=C sort >"$collate_key/rust.txt"
LC_ALL=C sort "$collate_key/out/flake-titles.txt" >"$collate_key/shell.txt"
cmp -s "$collate_key/rust.txt" "$collate_key/shell.txt" || {
  echo "--- rust titles:" >&2
  cat "$collate_key/rust.txt" >&2
  echo "--- shell titles:" >&2
  cat "$collate_key/shell.txt" >&2
  fail "collate-key: the shell and Rust titles differ"
}
# An empty list gives no flakes and an empty titles file.
collate_empty=$tmp/collate-empty
mkdir -p "$collate_empty/flaky"
: >"$collate_empty/flaky/flaky-tests-linux.txt"
run_collate "$collate_empty"
expect_flakes "$collate_empty" 'has_flakes=false'
[ ! -s "$collate_empty/out/flake-titles.txt" ] || fail "collate-empty: the titles file must be empty"
# Odd names go through both builders and agree: a leading-space name, a
# TAB-less line with spaces, and a name ending in a carriage return.
collate_odd=$tmp/collate-odd
mkdir -p "$collate_odd/flaky"
{
  printf 'main::probe a\td1\nmain::probe b\td2\n'
  printf ' x\td3\n'
  printf 'main::a x\n'
  printf 'main::c\r\td4\n'
} >"$collate_odd/flaky/flaky-tests-linux.txt"
run_collate "$collate_odd"
# Four distinct titles, in no promised order: the set is asserted here, and
# the sorted shell-vs-Rust parity check below pins the same set.
# docs/testing/running.md, "Flaky tests": "Within one report job a file's title files or comments once; a repeat is skipped"
expect_titles_sorted "$collate_odd" "$(printf 'Flaky tests: main::probe\nFlaky tests: \nFlaky tests: main::a\nFlaky tests: main::c\r')"
expect_flakes "$collate_odd" 'has_flakes=true'
"$real_cargo" run --quiet --manifest-path "$toplevel/xtask/Cargo.toml" -- flake-classify --flaky-dir "$collate_odd/flaky" --event push --tested-commit "$sha" >"$collate_odd/classes.jsonl" || fail "collate-odd: flake-classify failed"
"$real_jq" -r .title "$collate_odd/classes.jsonl" | LC_ALL=C sort >"$collate_odd/rust.txt"
LC_ALL=C sort "$collate_odd/out/flake-titles.txt" >"$collate_odd/shell.txt"
cmp -s "$collate_odd/rust.txt" "$collate_odd/shell.txt" || {
  echo "--- rust titles:" >&2
  cat "$collate_odd/rust.txt" >&2
  echo "--- shell titles:" >&2
  cat "$collate_odd/shell.txt" >&2
  fail "collate-odd: the shell and Rust titles differ"
}

# A malformed JUnit file fails collection with no list, so the producer
# marks the collection incomplete instead of a complete empty list. An
# empty file is the complete empty list. The marker is the file the
# workflow uploads beside the list: true only when the parser exits 0.
printf '<testsuite><broken' >"$tmp/malformed.xml"
if out=$(scripts/flaky-tests "$tmp/malformed.xml" 2>"$tmp/malformed.err"); then
  fail "malformed XML must fail collection"
fi
[ -z "$out" ] || fail "malformed XML must print no list"
[ -s "$tmp/malformed.err" ] || fail "malformed XML must explain itself"
if scripts/flaky-tests "$tmp/malformed.xml" >"$tmp/malformed-list.txt" 2>/dev/null; then
  complete=true
else
  complete=false
fi
[ "$complete" = false ] || fail "malformed XML must mark the collection incomplete"
[ -s "$tmp/malformed-list.txt" ] && fail "malformed XML must leave no list"
echo false >"$tmp/malformed-marker.txt"
[ "$(cat "$tmp/malformed-marker.txt")" = false ] || fail "the incomplete marker must read false"
: >"$tmp/empty.xml"
if scripts/flaky-tests "$tmp/empty.xml" >"$tmp/empty-list.txt" 2>/dev/null; then
  complete=true
else
  complete=false
fi
[ "$complete" = true ] || fail "empty XML must mark the collection complete"
[ ! -s "$tmp/empty-list.txt" ] || fail "empty XML must print no list"
echo true >"$tmp/empty-marker.txt"
[ "$(cat "$tmp/empty-marker.txt")" = true ] || fail "the complete marker must read true"

# Every listing reaches the decision as a file, never as an argument.
# This block extracts the decide job's steps in file order and runs them
# against stubs that make the closed listing larger than one argument.
decide_dir=$tmp/decide
mkdir -p "$decide_dir/blocks" "$decide_dir/bin" "$decide_dir/state" "$decide_dir/runner-temp"
awk -v outdir="$decide_dir/blocks" '
  BEGIN { idx=-1; in_job=0; seen_collate=0; done=0; capturing=0; in_env=0; in_run=0 }
  /^  flake_decide:/ { in_job=1; next }
  in_job && /^  [A-Za-z0-9_-]+:/ { in_job=0; capturing=0; in_run=0; in_env=0; next }
  !in_job { next }
  /^      - / {
    if (index($0, "Collate this run") > 0) { seen_collate=1; capturing=0; in_run=0; in_env=0; next }
    if (seen_collate && index($0, "upload-artifact") > 0) { capturing=0; done=1; in_run=0; in_env=0; next }
    if (seen_collate && !done) {
      capturing=1
      idx++
      printf "" > (outdir "/" sprintf("%02d.sh", idx))
      printf "" > (outdir "/" sprintf("%02d.env", idx))
      print $0 > (outdir "/" sprintf("%02d.header", idx))
      in_run=0; in_env=0
    }
    next
  }
  !capturing { next }
  /^        env:/ { in_env=1; in_run=0; next }
  /^        run: \| *$/ { in_env=0; in_run=1; next }
  /^        run: [^|]/ {
    in_env=0; in_run=0
    line=$0
    sub(/^        run: /, "", line)
    print line >> (outdir "/" sprintf("%02d.sh", idx))
    next
  }
  {
    if (in_env) {
      if ($0 ~ /^ *$/) { next }
      match($0, /[^ ]/)
      cur=RSTART-1
      if (cur <= 8) { in_env=0 }
      else if ($0 ~ /^          [A-Za-z_][A-Za-z0-9_]*:/) {
        line=$0
        sub(/^          /, "", line)
        n=index(line, ":")
        key=substr(line, 1, n-1)
        val=substr(line, n+1)
        sub(/^ +/, "", val)
        print key "=" val >> (outdir "/" sprintf("%02d.env", idx))
        next
      } else { in_env=0 }
    }
    if (in_run) {
      if ($0 ~ /^ *$/) { print "" >> (outdir "/" sprintf("%02d.sh", idx)); next }
      match($0, /[^ ]/)
      cur=RSTART-1
      if (cur <= 8) { in_run=0 }
      else { print $0 >> (outdir "/" sprintf("%02d.sh", idx)); next }
    }
  }
' .github/workflows/ci.yml
found=0
for block_sh in "$decide_dir"/blocks/*.sh; do
  [ -f "$block_sh" ] || continue
  [ -s "$block_sh" ] || continue
  found=1
  break
done
[ "$found" = 1 ] || fail "the flake decide steps were not found in .github/workflows/ci.yml"
# The stubs are executables on PATH, never shell functions: each step
# runs in its own shell. The closed listing is larger than one argument
# can hold, so passing it as an argument must fail.
decide_state=$decide_dir/state
decide_runner=$decide_dir/runner-temp
: >"$decide_state/gh-calls.log"
: >"$decide_state/classify-args.log"
: >"$decide_runner/output"
: >"$decide_runner/summary"
printf 'Flaky tests: probe\n' >"$decide_runner/flake-titles.txt"
cat >"$decide_dir/bin/gh" <<'GH_EOF'
#!/usr/bin/env bash
set -euo pipefail
log="${DECIDE_STATE_DIR:?}/gh-calls.log"
if [ -n "${GH_TOKEN:-}" ]; then
  printf 'token-set %s\n' "$*" >>"$log"
else
  printf 'token-unset %s\n' "$*" >>"$log"
fi
args="$*"
case "$args" in
  *"/events"*) printf '[]\n' ;;
  *"state=closed"*) python3 -c 'import json; items=[{"number": i, "title": "x"*100, "closed_at": "2026-10-24T00:00:00Z"} for i in range(1, 2001)]; print(json.dumps(items))' ;;
  *"state=open"*) printf '[]\n' ;;
  *) echo "stub gh: unexpected api call: $*" >&2; exit 1 ;;
esac
GH_EOF
cat >"$decide_dir/bin/cargo" <<'CARGO_EOF'
#!/usr/bin/env bash
set -euo pipefail
if [ -n "${GH_TOKEN:-}" ]; then
  echo "stub cargo: GH_TOKEN must be absent" >&2
  exit 99
fi
if [ "${1:-}" = "xtask" ] && [ "${2:-}" = "flake-report-events" ]; then
  cat >/dev/null
  exit 0
elif [ "${1:-}" = "xtask" ] && [ "${2:-}" = "flake-report" ]; then
  cat >"${DECIDE_STATE_DIR:?}/decide-input.json"
  printf '[]\n'
  exit 0
elif [ "${1:-}" = "xtask" ] && [ "${2:-}" = "flake-classify" ]; then
  printf '%s\n' "$*" >>"${DECIDE_STATE_DIR:?}/classify-args.log"
  exit 0
else
  echo "stub cargo: unexpected call: $*" >&2
  exit 1
fi
CARGO_EOF
cat >"$decide_dir/bin/rustup" <<'RUSTUP_EOF'
#!/usr/bin/env bash
exit 0
RUSTUP_EOF
chmod +x "$decide_dir/bin/gh" "$decide_dir/bin/cargo" "$decide_dir/bin/rustup"
cat >"$decide_dir/bin/jq" <<JQ_EOF
#!/usr/bin/env bash
limit=131072
for arg in "\$@"; do
  if [ "\${#arg}" -gt "\$limit" ]; then
    echo "/usr/bin/jq: Argument list too long" >&2
    exit 126
  fi
done
exec "$real_jq" "\$@"
JQ_EOF
chmod +x "$decide_dir/bin/jq"
# Each block runs in its own shell with its own step env. The job env
# carries only the repository name, never the token text.
decide_failed=""
for block_sh in "$decide_dir"/blocks/*.sh; do
  [ -f "$block_sh" ] || continue
  [ -s "$block_sh" ] || continue
  base=$(basename "$block_sh" .sh)
  block_env="$decide_dir/blocks/$base.env"
  block_err="$decide_dir/$base.stderr"
  code=0
  if grep -q '^GH_TOKEN=' "$block_env" 2>/dev/null; then
    env -i PATH="$decide_dir/bin:$orig_path" HOME="$tmp" FIBER_CHECK_RUN="${FIBER_CHECK_RUN:-}" RUNNER_TEMP="$decide_runner" GITHUB_SHA="1111111111111111111111111111111111111111" GH_REPO="aakshintala/fiber" GITHUB_OUTPUT="$decide_runner/output" GITHUB_STEP_SUMMARY="$decide_runner/summary" DECIDE_STATE_DIR="$decide_state" GH_TOKEN="test-token" bash --noprofile --norc -eo pipefail "$block_sh" 2>"$block_err" || code=$?
  else
    env -i PATH="$decide_dir/bin:$orig_path" HOME="$tmp" FIBER_CHECK_RUN="${FIBER_CHECK_RUN:-}" RUNNER_TEMP="$decide_runner" GITHUB_SHA="1111111111111111111111111111111111111111" GH_REPO="aakshintala/fiber" GITHUB_OUTPUT="$decide_runner/output" GITHUB_STEP_SUMMARY="$decide_runner/summary" DECIDE_STATE_DIR="$decide_state" bash --noprofile --norc -eo pipefail "$block_sh" 2>"$block_err" || code=$?
  fi
  if [ "$code" -ne 0 ]; then
    decide_failed="$base"
    break
  fi
done
if [ -n "$decide_failed" ]; then
  cat "$decide_dir/$decide_failed.stderr" >&2
  exit 1
fi
# The token lives only on the steps that call the API, never on the job
# and never on a step that only decides. The closed listing must arrive
# whole in the decision input.
job_env=$(awk '
  /^  flake_decide:/ { in_job=1; next }
  in_job && /^  [A-Za-z0-9_-]+:/ { exit }
  in_job && /^    env:/ { in_env=1; next }
  in_job && /^    [a-z]+:/ { if (in_env) exit }
  in_env { print }
' .github/workflows/ci.yml)
if printf '%s\n' "$job_env" | grep -q 'GH_TOKEN'; then
  fail "the flake_decide job must not set GH_TOKEN"
fi
for block_sh in "$decide_dir"/blocks/*.sh; do
  [ -f "$block_sh" ] || continue
  [ -s "$block_sh" ] || continue
  base=$(basename "$block_sh" .sh)
  block_env="$decide_dir/blocks/$base.env"
  if grep -q '^GH_TOKEN=' "$block_env" 2>/dev/null; then
    grep -q 'gh api' "$block_sh" || fail "a token-bearing decide block does not call gh ($base)"
    if grep -q 'cargo' "$block_sh"; then
      fail "a token-bearing decide block runs cargo ($base)"
    fi
  else
    if grep -q 'cargo' "$block_sh"; then
      : # a deciding block without the token is the rule
    fi
    if grep -q 'gh api' "$block_sh"; then
      fail "a decide block calls gh without the token ($base)"
    fi
    if grep -q 'jq' "$block_sh" && ! grep -q 'gh api' "$block_sh"; then
      : # a deciding jq block without the token is the rule
    fi
  fi
done
grep -q '^token-set.*state=open' "$decide_state/gh-calls.log" || fail "the token-bearing blocks did not fetch the open listing"
grep -q '^token-set.*state=closed' "$decide_state/gh-calls.log" || fail "the token-bearing blocks did not fetch the closed listing"
# The classify block ran without a token and without the API: it only
# decides. Its arguments name the flaky dir, the event and the tested
# commit; the block itself never calls gh.
[ -s "$decide_state/classify-args.log" ] || fail "the classify block did not run cargo xtask flake-classify"
grep -q -- '--flaky-dir' "$decide_state/classify-args.log" || fail "the classify block must name --flaky-dir"
grep -q -- '--event' "$decide_state/classify-args.log" || fail "the classify block must name --event"
grep -q -- '--tested-commit' "$decide_state/classify-args.log" || fail "the classify block must name --tested-commit"
for block_sh in "$decide_dir"/blocks/*.sh; do
  [ -f "$block_sh" ] || continue
  [ -s "$block_sh" ] || continue
  base=$(basename "$block_sh" .sh)
  if grep -q 'flake-classify' "$block_sh"; then
    if grep -q 'gh api' "$block_sh"; then
      fail "the classify block calls gh ($base)"
    fi
  fi
done
[ -f "$decide_state/decide-input.json" ] || fail "the decide input was not written"
closed_count=$("$real_jq" -e '.closed.issues | length' "$decide_state/decide-input.json" 2>/dev/null) || fail "the decide input has no closed issues"
[ "$closed_count" = 2000 ] || fail "want 2000 closed issues in the decide input, got $closed_count"
if ! python3 - "$decide_state/decide-input.json" <<'PY_EOF'
import json
import sys
path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    data = json.load(handle)
try:
    issues = data["closed"]["issues"]
except (KeyError, TypeError):
    print("the decide input has no closed issues", file=sys.stderr)
    sys.exit(1)
if not isinstance(issues, list) or len(issues) != 2000:
    got = len(issues) if isinstance(issues, list) else "non-list"
    print(f"want 2000 closed issues, got {got}", file=sys.stderr)
    sys.exit(1)
seen = set()
for index, item in enumerate(issues):
    want_number = index + 1
    want_title = "x" * 100
    want_closed_at = "2026-10-24T00:00:00Z"
    got_number = item.get("number") if isinstance(item, dict) else None
    got_title = item.get("title") if isinstance(item, dict) else None
    got_closed_at = item.get("closed_at") if isinstance(item, dict) else None
    if got_number != want_number or got_title != want_title or got_closed_at != want_closed_at:
        bad = []
        if got_number != want_number:
            bad.append("number")
        if got_title != want_title:
            bad.append("title")
        if got_closed_at != want_closed_at:
            bad.append("closed_at")
        print(f"closed issue mismatch at index {index}: {','.join(bad)}", file=sys.stderr)
        sys.exit(1)
    if got_number in seen:
        print(f"duplicate closed issue at index {index}", file=sys.stderr)
        sys.exit(1)
    seen.add(got_number)
PY_EOF
then
  fail "the closed issues differ from the generated fixture"
fi

echo "scripts/test-flake-report: ok"
