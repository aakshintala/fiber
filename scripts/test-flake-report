code=$(run_step "$tmp/pr-stale-before-pr-owned" pull_request 12 "$empty_open" "" decisions.jsonl)
expect_exit pr-stale-before-pr-owned "$code" 0
# docs/testing/running.md, "Flaky tests": "when main changed that file since the run's tested base it files nothing and notes the stale base in the summary"
expect_writes "$tmp/pr-stale-before-pr-owned" 0
expect_summary "$tmp/pr-stale-before-pr-owned" "stale base: main changed $probe_file since $base"

# A stale base skips the open lookup: an open exact-title issue gets no
