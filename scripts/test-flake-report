# A duplicate title across runner lists writes once.
setup_case duplicate-title
printf '%s\t%s\n%s\t%s\n' "$name" "$detail" "$name" "$detail" >"$tmp/duplicate-title/temp/flaky/flaky-tests-linux.txt"
printf '%s\t%s\n' "$name" "$detail" >"$tmp/duplicate-title/temp/flaky/flaky-tests-arm.txt"
printf '%s\n' "$decide_new" >"$tmp/duplicate-title/decisions.jsonl"
