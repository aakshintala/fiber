#!/usr/bin/env bash
# Stub cargo for scripts/test-bug-red: docs-only exits 0 only with
# BUG_RED_DOCS_ONLY=true (a docs-only pull request) and 1 otherwise,
# bug-filter records its file args in the file named by BUG_RED_RECORD
# and prints a filter plus one package, and nextest exits
# BUG_RED_NEXTEST_STATUS (a test failed by default).
set -euo pipefail
if [ "${1-}" = xtask ] && [ "${2-}" = docs-only ]; then
  if [ "${BUG_RED_DOCS_ONLY-}" = true ]; then
    exit 0
  fi
  exit 1
fi
if [ "${1-}" = xtask ] && [ "${2-}" = bug-filter ]; then
  shift 2
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@" >"$BUG_RED_RECORD"
    # Like the real bug-filter, only test files reach the filter: a
    # red commit with no test file prints an empty one.
    joined=""
    for f in "$@"; do
      case "$f" in
        */tests/*)
          if [ -z "$joined" ]; then
            joined="$f"
          else
            joined="$joined|$f"
          fi
          ;;
      esac
    done
    printf 'filter\t%s\n' "$joined"
  else
    : >"$BUG_RED_RECORD"
    printf 'filter\t\n'
  fi
  printf 'package\ta\n'
  exit 0
fi
if [ "${1-}" = nextest ]; then
  exit "${BUG_RED_NEXTEST_STATUS:-100}"
fi
echo "stub cargo: unexpected args: $*" >&2
exit 1
