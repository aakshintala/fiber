#!/usr/bin/env bash
# The self-test for scripts/bug-red: a throwaway git repo with a base
# commit, a red commit adding crates/a/tests/red.rs, and a later commit
# adding crates/a/tests/later.rs proves bug-red filters the red commit's
# own tests (red.rs, not later.rs); a further fixture proves a red commit
# with no test file exits 1.
#
# bug-red cds to the top level of its checkout, so each fixture cds into
# its throwaway repo and calls bug-red by absolute path. A stub cargo
# first on PATH stands in for the toolchain: docs-only exits 1 (not
# docs-only), bug-filter records its file args and prints a filter plus
# one package, and nextest exits 100 (a test failed). No background
# processes.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
top=$PWD

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "scripts/test-bug-red: $1" >&2
  exit 1
}

bug_red="$top/scripts/bug-red"
record="$tmp/filter-args.txt"
export BUG_RED_RECORD="$record"
real_cargo=$(command -v cargo)

mkdir -p "$tmp/bin"
ln -s "$top/scripts/test-bug-red-cargo" "$tmp/bin/cargo"
PATH="$tmp/bin:$PATH"
export PATH

new_repo() {
  git init -q "$1"
  git -C "$1" config user.email test@example.com
  git -C "$1" config user.name Test
  git -C "$1" commit -q --allow-empty -m base
}

# The red commit's own tests run at the red commit: the later commit's
# test file must not reach the filter.
repo="$tmp/repo"
new_repo "$repo"
mkdir -p "$repo/crates/a/tests" "$repo/crates/a/src"
printf '// red\n' >"$repo/crates/a/tests/red.rs"
git -C "$repo" add crates/a/tests/red.rs
git -C "$repo" commit -q -m red
printf '// later\n' >"$repo/crates/a/tests/later.rs"
printf '// fix\n' >"$repo/crates/a/src/fix.rs"
git -C "$repo" add crates/a/tests/later.rs crates/a/src/fix.rs
git -C "$repo" commit -q -m later
base=$(git -C "$repo" rev-parse HEAD~2)
cd "$repo"
head=$(git rev-parse HEAD)
rc=0
"$bug_red" >"$tmp/out-args-none.txt" 2>&1 || rc=$?
[ "$rc" -eq 2 ] || { cat "$tmp/out-args-none.txt" >&2; fail "no arguments exited $rc, want 2"; }
grep -Fq "usage: scripts/bug-red" "$tmp/out-args-none.txt" || { cat "$tmp/out-args-none.txt" >&2; fail "no arguments misses usage"; }
rc=0
"$bug_red" "$base" "$head" extra >"$tmp/out-args-extra.txt" 2>&1 || rc=$?
[ "$rc" -eq 2 ] || { cat "$tmp/out-args-extra.txt" >&2; fail "too many arguments exited $rc, want 2"; }
grep -Fq "usage: scripts/bug-red" "$tmp/out-args-extra.txt" || { cat "$tmp/out-args-extra.txt" >&2; fail "too many arguments misses usage"; }
rc=0
"$bug_red" "$base" "$head" >"$tmp/out1.txt" 2>&1 || rc=$?
cd "$top"
[ "$rc" -eq 0 ] || { cat "$tmp/out1.txt" >&2; fail "later-commit case exited $rc, want 0"; }
grep -Fq "crates/a/tests/red.rs" "$record" || fail "filter misses the red commit's test"
if grep -Fq "crates/a/tests/later.rs" "$record"; then
  cat "$tmp/out1.txt" >&2
  fail "filter holds the later commit's test"
fi

# A red commit with no test file exits 1, even when the later commit
# adds one.
repo2="$tmp/repo2"
new_repo "$repo2"
mkdir -p "$repo2/crates/a/src" "$repo2/crates/a/tests"
printf '// lib\n' >"$repo2/crates/a/src/lib.rs"
git -C "$repo2" add crates/a/src/lib.rs
git -C "$repo2" commit -q -m red
printf '// later\n' >"$repo2/crates/a/tests/later.rs"
git -C "$repo2" add crates/a/tests/later.rs
git -C "$repo2" commit -q -m later
base2=$(git -C "$repo2" rev-parse HEAD~2)
cd "$repo2"
head2=$(git rev-parse HEAD)
rc=0
"$bug_red" "$base2" "$head2" >"$tmp/out2.txt" 2>&1 || rc=$?
cd "$top"
[ "$rc" -eq 1 ] || { cat "$tmp/out2.txt" >&2; fail "no-test red commit exited $rc, want 1"; }
grep -Fq "changes no test file" "$tmp/out2.txt" || { cat "$tmp/out2.txt" >&2; fail "no-test red commit names no missing test file"; }

# Every other nextest exit code fails with its own message: the stub
# selects the code with BUG_RED_NEXTEST_STATUS, defaulting to 100, so a
# wrong branch in bug-red's case statement fails here.
cd "$repo"
for nextest_status in 0 101 4 2; do
  case "$nextest_status" in
    0) want="every one of the red commit's tests passes at the red commit" ;;
    101) want="does not build" ;;
    4) want="none of the red commit's tests runs at the red commit" ;;
    *) want="nextest exited $nextest_status" ;;
  esac
  export BUG_RED_NEXTEST_STATUS="$nextest_status"
  rc=0
  "$bug_red" "$base" "$head" >"$tmp/out-status.txt" 2>&1 || rc=$?
  unset BUG_RED_NEXTEST_STATUS
  [ "$rc" -eq 1 ] || { cat "$tmp/out-status.txt" >&2; fail "nextest $nextest_status exited $rc, want 1"; }
  grep -Fq "$want" "$tmp/out-status.txt" || { cat "$tmp/out-status.txt" >&2; fail "nextest $nextest_status misses \"$want\""; }
done
cd "$top"

# Report mode records nextest's result class and lets a separate collector
# decide. A red test, a green test, a build failure, no matches and an
# unexpected exit all reach that collector as data.
cd "$repo"
for nextest_status in 0 100 101 4 2; do
  : >"$tmp/github-output.txt"
  export BUG_RED_NEXTEST_STATUS="$nextest_status"
  GITHUB_OUTPUT="$tmp/github-output.txt" "$bug_red" --report "$base" "$head" >"$tmp/out-report.txt" 2>&1 || {
    cat "$tmp/out-report.txt" >&2
    fail "report mode with nextest $nextest_status failed before collection"
  }
  unset BUG_RED_NEXTEST_STATUS
  grep -Fxq "status=$nextest_status" "$tmp/github-output.txt" || {
    cat "$tmp/github-output.txt" >&2
    fail "report mode did not record nextest $nextest_status"
  }
done
cd "$top"

# The collector requires both legs to build and at least one red test to
# fail; a green leg is allowed when the other leg reproduces the bug.
rc=0
"$bug_red" --collect 100 0 >"$tmp/out-collect-red.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { cat "$tmp/out-collect-red.txt" >&2; fail "red on one leg exited $rc, want 0"; }
rc=0
"$bug_red" --collect 0 0 >"$tmp/out-collect-green.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-green.txt" >&2; fail "green on both legs exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 101 >"$tmp/out-collect-build.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-build.txt" >&2; fail "red that does not build on one leg exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 4 >"$tmp/out-collect-no-match.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { cat "$tmp/out-collect-no-match.txt" >&2; fail "red with no match on the other leg exited $rc, want 0"; }
rc=0
"$bug_red" --collect 4 0 >"$tmp/out-collect-no-red.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-no-red.txt" >&2; fail "no-match plus green exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 2 >"$tmp/out-collect-unexpected.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-unexpected.txt" >&2; fail "unexpected nextest result exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 "" >"$tmp/out-collect-missing.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-missing.txt" >&2; fail "missing leg result exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 invalid >"$tmp/out-collect-invalid.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-invalid.txt" >&2; fail "invalid leg result exited $rc, want 1"; }
rc=0
"$bug_red" --collect docs docs >"$tmp/out-collect-docs.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { cat "$tmp/out-collect-docs.txt" >&2; fail "docs-only on both legs exited $rc, want 0"; }
rc=0
"$bug_red" --collect docs 0 >"$tmp/out-collect-docs-mixed.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-docs-mixed.txt" >&2; fail "mixed docs-only and test result exited $rc, want 1"; }

# A pull request that changes only docs passes at once, before the
# one-commit check: the stub selects the branch with BUG_RED_DOCS_ONLY.
repo_docs="$tmp/repo-docs"
new_repo "$repo_docs"
mkdir -p "$repo_docs/docs"
printf 'notes\n' >"$repo_docs/docs/notes.md"
git -C "$repo_docs" add docs/notes.md
git -C "$repo_docs" commit -q -m docs
base_docs=$(git -C "$repo_docs" rev-parse HEAD~1)
cd "$repo_docs"
head_docs=$(git rev-parse HEAD)
export BUG_RED_DOCS_ONLY=true
rc=0
"$bug_red" "$base_docs" "$head_docs" >"$tmp/out-docs.txt" 2>&1 || rc=$?
unset BUG_RED_DOCS_ONLY
cd "$top"
[ "$rc" -eq 0 ] || { cat "$tmp/out-docs.txt" >&2; fail "docs-only case exited $rc, want 0"; }
grep -Fq "changes only docs" "$tmp/out-docs.txt" || { cat "$tmp/out-docs.txt" >&2; fail "docs-only case misses the docs-only message"; }
: >"$tmp/github-output.txt"
export BUG_RED_DOCS_ONLY=true
cd "$repo_docs"
GITHUB_OUTPUT="$tmp/github-output.txt" "$bug_red" --report "$base_docs" "$head_docs" >"$tmp/out-docs-report.txt" 2>&1 || {
  cat "$tmp/out-docs-report.txt" >&2
  fail "docs-only report mode failed"
}
unset BUG_RED_DOCS_ONLY
cd "$repo_docs"
grep -Fxq 'status=docs' "$tmp/github-output.txt" || {
  cat "$tmp/github-output.txt" >&2
  fail "docs-only report did not record its result"
}
cd "$top"

# A test file of a `test = false` target is one a plain nextest run never
# builds. The throwaway `unrun.rs` stands for it: this cargo wraps the stub
# and has bug-filter name `*/tests/unrun.rs` as `unrun` instead of putting
# it in the filter, as the real bug-filter does for such a target.
mkdir -p "$tmp/bin-unrun"
cat >"$tmp/bin-unrun/cargo" <<'WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
if [ "${1-}" = xtask ] && [ "${2-}" = bug-filter ]; then
  shift 2
  kept=()
  unrun=()
  for f in "$@"; do
    case "$f" in
      */tests/unrun.rs) unrun+=("$f") ;;
      *) kept+=("$f") ;;
    esac
  done
  "$BUG_RED_STUB_CARGO" xtask bug-filter ${kept[@]+"${kept[@]}"}
  for f in ${unrun[@]+"${unrun[@]}"}; do
    printf 'unrun\t%s\n' "$f"
  done
  exit 0
fi
exec "$BUG_RED_STUB_CARGO" "$@"
WRAPPER
chmod +x "$tmp/bin-unrun/cargo"
export BUG_RED_STUB_CARGO="$tmp/bin/cargo"
journey_msg="the red commit's only touched tests are journey tests, which pull-request CI does not run until #3899 step 6"

# A red commit whose only test file is in a `test = false` target passes
# and reports the journey sentinel, not the docs one; nextest never runs.
repo_j="$tmp/repo-journey"
new_repo "$repo_j"
mkdir -p "$repo_j/crates/a/tests" "$repo_j/crates/a/src"
printf '// journey\n' >"$repo_j/crates/a/tests/unrun.rs"
git -C "$repo_j" add crates/a/tests/unrun.rs
git -C "$repo_j" commit -q -m red
printf '// fix\n' >"$repo_j/crates/a/src/fix.rs"
git -C "$repo_j" add crates/a/src/fix.rs
git -C "$repo_j" commit -q -m fix
base_j=$(git -C "$repo_j" rev-parse HEAD~2)
cd "$repo_j"
head_j=$(git rev-parse HEAD)
export BUG_RED_NEXTEST_STATUS=2
rc=0
PATH="$tmp/bin-unrun:$PATH" "$bug_red" "$base_j" "$head_j" >"$tmp/out-journey.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { cat "$tmp/out-journey.txt" >&2; fail "journey-only case exited $rc, want 0"; }
grep -Fq "$journey_msg" "$tmp/out-journey.txt" || { cat "$tmp/out-journey.txt" >&2; fail "journey-only case misses the journey message"; }
if grep -Fq "only docs" "$tmp/out-journey.txt"; then
  cat "$tmp/out-journey.txt" >&2
  fail "journey-only case says the pull request changes only docs"
fi
: >"$tmp/github-output.txt"
GITHUB_OUTPUT="$tmp/github-output.txt" PATH="$tmp/bin-unrun:$PATH" "$bug_red" --report "$base_j" "$head_j" >"$tmp/out-journey-report.txt" 2>&1 || {
  cat "$tmp/out-journey-report.txt" >&2
  fail "journey-only report mode failed"
}
unset BUG_RED_NEXTEST_STATUS
grep -Fxq 'status=journey' "$tmp/github-output.txt" || {
  cat "$tmp/github-output.txt" >&2
  fail "journey-only report did not record its result"
}
cd "$top"

# A red commit that also holds a normal test still runs that test, and it
# still has to fail: the journey test only drops out of the filter.
repo_m="$tmp/repo-mixed"
new_repo "$repo_m"
mkdir -p "$repo_m/crates/a/tests" "$repo_m/crates/a/src"
printf '// journey\n' >"$repo_m/crates/a/tests/unrun.rs"
printf '// red\n' >"$repo_m/crates/a/tests/red.rs"
git -C "$repo_m" add crates/a/tests/unrun.rs crates/a/tests/red.rs
git -C "$repo_m" commit -q -m red
printf '// fix\n' >"$repo_m/crates/a/src/fix.rs"
git -C "$repo_m" add crates/a/src/fix.rs
git -C "$repo_m" commit -q -m fix
base_m=$(git -C "$repo_m" rev-parse HEAD~2)
cd "$repo_m"
head_m=$(git rev-parse HEAD)
for nextest_status in 100 0 4; do
  export BUG_RED_NEXTEST_STATUS="$nextest_status"
  rc=0
  PATH="$tmp/bin-unrun:$PATH" "$bug_red" "$base_m" "$head_m" >"$tmp/out-mixed.txt" 2>&1 || rc=$?
  unset BUG_RED_NEXTEST_STATUS
  want=1
  [ "$nextest_status" -eq 100 ] && want=0
  [ "$rc" -eq "$want" ] || { cat "$tmp/out-mixed.txt" >&2; fail "mixed plan with nextest $nextest_status exited $rc, want $want"; }
  grep -Fq "running crates/a/tests/red.rs at" "$tmp/out-mixed.txt" || { cat "$tmp/out-mixed.txt" >&2; fail "mixed plan does not run the normal test alone"; }
  if grep -Fq "$journey_msg" "$tmp/out-mixed.txt"; then
    cat "$tmp/out-mixed.txt" >&2
    fail "mixed plan with nextest $nextest_status says the plan is journey-only"
  fi
done
cd "$top"

# The collector passes on two journey legs and names why; it fails when the
# legs disagree, whatever the other leg reports.
rc=0
"$bug_red" --collect journey journey >"$tmp/out-collect-journey.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { cat "$tmp/out-collect-journey.txt" >&2; fail "journey on both legs exited $rc, want 0"; }
grep -Fq "$journey_msg" "$tmp/out-collect-journey.txt" || { cat "$tmp/out-collect-journey.txt" >&2; fail "journey on both legs misses the journey message"; }
for pair in "journey:100" "100:journey" "journey:0" "journey:4" "journey:docs" "docs:journey" "journey:"; do
  rc=0
  "$bug_red" --collect "${pair%%:*}" "${pair#*:}" >"$tmp/out-collect-journey-mixed.txt" 2>&1 || rc=$?
  [ "$rc" -eq 1 ] || { cat "$tmp/out-collect-journey-mixed.txt" >&2; fail "legs ($pair) exited $rc, want 1"; }
  grep -Fq "disagrees between legs" "$tmp/out-collect-journey-mixed.txt" || { cat "$tmp/out-collect-journey-mixed.txt" >&2; fail "legs ($pair) miss the disagreement message"; }
done

# A one-commit branch with no HEAD argument reports the one-commit
# message: the default HEAD resolves to a SHA, so the guard fires.
repo3="$tmp/repo3"
new_repo "$repo3"
mkdir -p "$repo3/crates/a/tests"
printf '// red\n' >"$repo3/crates/a/tests/red.rs"
git -C "$repo3" add crates/a/tests/red.rs
git -C "$repo3" commit -q -m only
base3=$(git -C "$repo3" rev-parse HEAD~1)
cd "$repo3"
rc=0
"$bug_red" "$base3" >"$tmp/out3.txt" 2>&1 || rc=$?
cd "$top"
[ "$rc" -eq 1 ] || { cat "$tmp/out3.txt" >&2; fail "one-commit case exited $rc, want 1"; }
grep -Fq "has one commit" "$tmp/out3.txt" || { cat "$tmp/out3.txt" >&2; fail "one-commit case misses the one-commit message"; }

# A branch that merges main after its red commit: main modifies a test
# file that already exists at the branch point and adds a new one. The
# merge base is main's tip, which the red commit does not descend from,
# so the red commit's own test file must reach the filter and neither of
# main's test files may.
repo4="$tmp/repo4"
new_repo "$repo4"
mkdir -p "$repo4/crates/a/tests"
printf '// existing v1\n' >"$repo4/crates/a/tests/existing.rs"
git -C "$repo4" add crates/a/tests/existing.rs
git -C "$repo4" commit -q -m base-tests
base4=$(git -C "$repo4" rev-parse HEAD)
git -C "$repo4" checkout -q -b feature
printf '// red\n' >"$repo4/crates/a/tests/red.rs"
git -C "$repo4" add crates/a/tests/red.rs
git -C "$repo4" commit -q -m red
git -C "$repo4" checkout -q -b main-side "$base4"
printf '// existing v2\n' >"$repo4/crates/a/tests/existing.rs"
printf '// main new\n' >"$repo4/crates/a/tests/main_new.rs"
git -C "$repo4" add crates/a/tests/existing.rs crates/a/tests/main_new.rs
git -C "$repo4" commit -q -m main
main4=$(git -C "$repo4" rev-parse HEAD)
git -C "$repo4" checkout -q feature
git -C "$repo4" merge -q --no-ff -m merge-main main-side
head4=$(git -C "$repo4" rev-parse HEAD)
cd "$repo4"
rc=0
"$bug_red" "$main4" "$head4" >"$tmp/out4.txt" 2>&1 || rc=$?
cd "$top"
[ "$rc" -eq 0 ] || { cat "$tmp/out4.txt" >&2; fail "merged-main case exited $rc, want 0"; }
grep -Fq "crates/a/tests/red.rs" "$record" || { cat "$tmp/out4.txt" >&2; fail "merged-main filter misses the red commit's test"; }
if grep -Fq "crates/a/tests/existing.rs" "$record" || grep -Fq "crates/a/tests/main_new.rs" "$record"; then
  cat "$tmp/out4.txt" >&2
  fail "merged-main filter names a test file main changed"
fi

# The wrapper stands in for a runner's `cargo nextest list`. bug-filter
# gains two planned tests, one of which each list omits, and narrow-plan
# is the real command from this checkout.
mkdir -p "$tmp/bin-cfg"
cat >"$tmp/bin-cfg/cargo" <<'WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
if [ "${1-}" = xtask ] && [ "${2-}" = narrow-plan ]; then
  shift 2
  exec "$BUG_RED_REAL_CARGO" run --quiet --manifest-path "$BUG_RED_TOP/Cargo.toml" --package xtask -- narrow-plan "$@"
fi
if [ "${1-}" = xtask ] && [ "${2-}" = bug-filter ]; then
  "$BUG_RED_STUB_CARGO" "$@"
  printf 'planned\ttools\t\ttrue\tshell::sandbox::tests::linux_one\n'
  printf 'planned\ttools\t\ttrue\tshell::sandbox::tests::macos_one\n'
  exit 0
fi
if [ "${1-}" = nextest ] && [ "${2-}" = list ]; then
  cat "$BUG_RED_LIST_FILE"
  exit 0
fi
if [ "${1-}" = nextest ] && [ "${2-}" = run ]; then
  printf '%s\n' "$@" >"$BUG_RED_NEXTEST_ARGS"
  exit "${BUG_RED_NEXTEST_STATUS:-100}"
fi
exec "$BUG_RED_STUB_CARGO" "$@"
WRAPPER
chmod +x "$tmp/bin-cfg/cargo"
export BUG_RED_STUB_CARGO="$tmp/bin/cargo"
export BUG_RED_REAL_CARGO="$real_cargo"
export BUG_RED_TOP="$top"

cat >"$tmp/list-linux.json" <<'JSON'
{"rust-suites":{"tools":{"package-name":"tools","binary-id":"tools","kind":"lib","testcases":{"shell::sandbox::tests::linux_one":{"filter-match":{"status":"matches"}}}}}}
JSON
cat >"$tmp/list-macos.json" <<'JSON'
{"rust-suites":{"tools":{"package-name":"tools","binary-id":"tools","kind":"lib","testcases":{"shell::sandbox::tests::macos_one":{"filter-match":{"status":"matches"}}}}}}
JSON
cat >"$tmp/list-empty.json" <<'JSON'
{"rust-suites":{}}
JSON

repo_c="$tmp/repo-cfg"
new_repo "$repo_c"
mkdir -p "$repo_c/crates/a/tests" "$repo_c/crates/a/src"
printf '// red\n' >"$repo_c/crates/a/tests/red.rs"
git -C "$repo_c" add crates/a/tests/red.rs
git -C "$repo_c" commit -q -m red
printf '// fix\n' >"$repo_c/crates/a/src/fix.rs"
git -C "$repo_c" add crates/a/src/fix.rs
git -C "$repo_c" commit -q -m fix
base_c=$(git -C "$repo_c" rev-parse HEAD~2)
head_c=$(git -C "$repo_c" rev-parse HEAD)

# A test the list contains stays in that leg's run. The test the list
# omits is named and excluded, so it is planned on the other leg alone.
a_test_present_on_one_leg_only_is_planned_on_that_leg_alone() {
  local list_file=$1
  local kept=$2
  local dropped=$3
  local out=$4
  local args=$5
  rm -f "$args"
  export BUG_RED_LIST_FILE="$list_file"
  export BUG_RED_NEXTEST_ARGS="$args"
  export BUG_RED_NEXTEST_STATUS=100
  local rc=0
  cd "$repo_c"
  PATH="$tmp/bin-cfg:$PATH" "$bug_red" "$base_c" "$head_c" >"$out" 2>&1 || rc=$?
  cd "$top"
  [ "$rc" -eq 0 ] || { cat "$out" >&2; fail "cfg leg ($kept) exited $rc, want 0"; }
  grep -Fq "bug-red: dropping tools shell::sandbox::tests::$dropped" "$out" || {
    cat "$out" >&2
    fail "leg ($kept) did not drop $dropped"
  }
  if grep -Fq "bug-red: dropping tools shell::sandbox::tests::$kept" "$out"; then
    cat "$out" >&2
    fail "leg ($kept) dropped $kept"
  fi
  [ -f "$args" ] || { cat "$out" >&2; fail "leg ($kept) did not run nextest"; }
  grep -Fq "$dropped" "$args" || { cat "$args" >&2; fail "leg ($kept) did not exclude $dropped"; }
  if grep -Fq "$kept" "$args"; then
    cat "$args" >&2
    fail "leg ($kept) names $kept in the filter, so the exclusion is not the dropped test alone"
  fi
}
a_test_present_on_one_leg_only_is_planned_on_that_leg_alone \
  "$tmp/list-linux.json" linux_one macos_one \
  "$tmp/out-linux-leg.txt" "$tmp/args-linux.txt"
a_test_present_on_one_leg_only_is_planned_on_that_leg_alone \
  "$tmp/list-macos.json" macos_one linux_one \
  "$tmp/out-macos-leg.txt" "$tmp/args-macos.txt"

# Neither leg compiles a planned test. Each reports the no-match status,
# and the collector fails. This is not the docs or journey pass.
a_plan_empty_on_both_legs_fails() {
  rm -f "$tmp/args-empty.txt"
  : >"$tmp/github-output.txt"
  export BUG_RED_LIST_FILE="$tmp/list-empty.json"
  export BUG_RED_NEXTEST_ARGS="$tmp/args-empty.txt"
  cd "$repo_c"
  GITHUB_OUTPUT="$tmp/github-output.txt" PATH="$tmp/bin-cfg:$PATH" "$bug_red" --report "$base_c" "$head_c" >"$tmp/out-empty-cfg.txt" 2>&1 || {
    cat "$tmp/out-empty-cfg.txt" >&2
    fail "empty intersection report failed"
  }
  cd "$top"
  grep -Fxq 'status=4' "$tmp/github-output.txt" || {
    cat "$tmp/github-output.txt" >&2
    fail "empty intersection did not record status 4"
  }
  if [ -f "$tmp/args-empty.txt" ]; then
    cat "$tmp/args-empty.txt" >&2
    fail "empty intersection ran nextest"
  fi
  if grep -Fq "journey" "$tmp/out-empty-cfg.txt" || grep -Fq "only docs" "$tmp/out-empty-cfg.txt"; then
    cat "$tmp/out-empty-cfg.txt" >&2
    fail "empty intersection took a pass"
  fi
  grep -Fq "none of the red commit's tests runs" "$tmp/out-empty-cfg.txt" || {
    cat "$tmp/out-empty-cfg.txt" >&2
    fail "empty intersection misses the no-match message"
  }
  local rc=0
  "$bug_red" --collect 4 4 >"$tmp/out-collect-cfg.txt" 2>&1 || rc=$?
  [ "$rc" -eq 1 ] || { cat "$tmp/out-collect-cfg.txt" >&2; fail "empty on both legs exited $rc, want 1"; }
  grep -Fq "no test ran" "$tmp/out-collect-cfg.txt" || {
    cat "$tmp/out-collect-cfg.txt" >&2
    fail "empty on both legs misses the failure"
  }
}
a_plan_empty_on_both_legs_fails
