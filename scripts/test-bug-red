#!/usr/bin/env bash
# The self-test for scripts/bug-red: a throwaway git repo with a base
# commit, a red commit adding crates/a/tests/red.rs, and a later commit
# adding crates/a/tests/later.rs proves bug-red filters the red commit's
# own tests (red.rs, not later.rs); a further fixture proves a red commit
# with no test file exits 1.
#
# bug-red cds to the top level of its checkout, so each fixture cds into
# its throwaway repo and calls bug-red by absolute path. A stub cargo
# first on PATH stands in for the toolchain: docs-only exits 1 (not
# docs-only), bug-filter records its file args and prints a filter plus
# one package, and nextest exits 100 (a test failed). No background
# processes.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
top=$PWD

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "scripts/test-bug-red: $1" >&2
  exit 1
}

bug_red="$top/scripts/bug-red"
record="$tmp/filter-args.txt"
export BUG_RED_RECORD="$record"

mkdir -p "$tmp/bin"
ln -s "$top/scripts/test-bug-red-cargo" "$tmp/bin/cargo"
PATH="$tmp/bin:$PATH"
export PATH

new_repo() {
  git init -q "$1"
  git -C "$1" config user.email test@example.com
  git -C "$1" config user.name Test
  git -C "$1" commit -q --allow-empty -m base
}

# The red commit's own tests run at the red commit: the later commit's
# test file must not reach the filter.
repo="$tmp/repo"
new_repo "$repo"
mkdir -p "$repo/crates/a/tests" "$repo/crates/a/src"
printf '// red\n' >"$repo/crates/a/tests/red.rs"
git -C "$repo" add crates/a/tests/red.rs
git -C "$repo" commit -q -m red
printf '// later\n' >"$repo/crates/a/tests/later.rs"
printf '// fix\n' >"$repo/crates/a/src/fix.rs"
git -C "$repo" add crates/a/tests/later.rs crates/a/src/fix.rs
git -C "$repo" commit -q -m later
base=$(git -C "$repo" rev-parse HEAD~2)
cd "$repo"
head=$(git rev-parse HEAD)
rc=0
"$bug_red" "$base" "$head" >"$tmp/out1.txt" 2>&1 || rc=$?
cd "$top"
[ "$rc" -eq 0 ] || { cat "$tmp/out1.txt" >&2; fail "later-commit case exited $rc, want 0"; }
grep -Fq "crates/a/tests/red.rs" "$record" || fail "filter misses the red commit's test"
if grep -Fq "crates/a/tests/later.rs" "$record"; then
  cat "$tmp/out1.txt" >&2
  fail "filter holds the later commit's test"
fi

# A red commit with no test file exits 1, even when the later commit
# adds one.
repo2="$tmp/repo2"
new_repo "$repo2"
mkdir -p "$repo2/crates/a/src" "$repo2/crates/a/tests"
printf '// lib\n' >"$repo2/crates/a/src/lib.rs"
git -C "$repo2" add crates/a/src/lib.rs
git -C "$repo2" commit -q -m red
printf '// later\n' >"$repo2/crates/a/tests/later.rs"
git -C "$repo2" add crates/a/tests/later.rs
git -C "$repo2" commit -q -m later
base2=$(git -C "$repo2" rev-parse HEAD~2)
cd "$repo2"
head2=$(git rev-parse HEAD)
rc=0
"$bug_red" "$base2" "$head2" >"$tmp/out2.txt" 2>&1 || rc=$?
cd "$top"
[ "$rc" -eq 1 ] || { cat "$tmp/out2.txt" >&2; fail "no-test red commit exited $rc, want 1"; }
grep -Fq "changes no test file" "$tmp/out2.txt" || { cat "$tmp/out2.txt" >&2; fail "no-test red commit names no missing test file"; }

# Every other nextest exit code fails with its own message: the stub
# selects the code with BUG_RED_NEXTEST_STATUS, defaulting to 100, so a
# wrong branch in bug-red's case statement fails here.
cd "$repo"
for nextest_status in 0 101 4 2; do
  case "$nextest_status" in
    0) want="every one of the red commit's tests passes at the red commit" ;;
    101) want="does not build" ;;
    4) want="none of the red commit's tests runs at the red commit" ;;
    *) want="nextest exited $nextest_status" ;;
  esac
  export BUG_RED_NEXTEST_STATUS="$nextest_status"
  rc=0
  "$bug_red" "$base" "$head" >"$tmp/out-status.txt" 2>&1 || rc=$?
  unset BUG_RED_NEXTEST_STATUS
  [ "$rc" -eq 1 ] || { cat "$tmp/out-status.txt" >&2; fail "nextest $nextest_status exited $rc, want 1"; }
  grep -Fq "$want" "$tmp/out-status.txt" || { cat "$tmp/out-status.txt" >&2; fail "nextest $nextest_status misses \"$want\""; }
done
cd "$top"

# Report mode records nextest's result class and lets a separate collector
# decide. A red test, a green test, a build failure, no matches and an
# unexpected exit all reach that collector as data.
cd "$repo"
for nextest_status in 0 100 101 4 2; do
  : >"$tmp/github-output.txt"
  export BUG_RED_NEXTEST_STATUS="$nextest_status"
  GITHUB_OUTPUT="$tmp/github-output.txt" "$bug_red" --report "$base" "$head" >"$tmp/out-report.txt" 2>&1 || {
    cat "$tmp/out-report.txt" >&2
    fail "report mode with nextest $nextest_status failed before collection"
  }
  unset BUG_RED_NEXTEST_STATUS
  grep -Fxq "status=$nextest_status" "$tmp/github-output.txt" || {
    cat "$tmp/github-output.txt" >&2
    fail "report mode did not record nextest $nextest_status"
  }
done
cd "$top"

# The collector requires both legs to build and at least one red test to
# fail; a green leg is allowed when the other leg reproduces the bug.
rc=0
"$bug_red" --collect 100 0 >"$tmp/out-collect-red.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { cat "$tmp/out-collect-red.txt" >&2; fail "red on one leg exited $rc, want 0"; }
rc=0
"$bug_red" --collect 0 0 >"$tmp/out-collect-green.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-green.txt" >&2; fail "green on both legs exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 101 >"$tmp/out-collect-build.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-build.txt" >&2; fail "red that does not build on one leg exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 4 >"$tmp/out-collect-no-match.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { cat "$tmp/out-collect-no-match.txt" >&2; fail "red with no match on the other leg exited $rc, want 0"; }
rc=0
"$bug_red" --collect 4 0 >"$tmp/out-collect-no-red.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-no-red.txt" >&2; fail "no-match plus green exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 2 >"$tmp/out-collect-unexpected.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-unexpected.txt" >&2; fail "unexpected nextest result exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 "" >"$tmp/out-collect-missing.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-missing.txt" >&2; fail "missing leg result exited $rc, want 1"; }
rc=0
"$bug_red" --collect 100 invalid >"$tmp/out-collect-invalid.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-invalid.txt" >&2; fail "invalid leg result exited $rc, want 1"; }
rc=0
"$bug_red" --collect docs docs >"$tmp/out-collect-docs.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { cat "$tmp/out-collect-docs.txt" >&2; fail "docs-only on both legs exited $rc, want 0"; }
rc=0
"$bug_red" --collect docs 0 >"$tmp/out-collect-docs-mixed.txt" 2>&1 || rc=$?
[ "$rc" -eq 1 ] || { cat "$tmp/out-collect-docs-mixed.txt" >&2; fail "mixed docs-only and test result exited $rc, want 1"; }

# A pull request that changes only docs passes at once, before the
# one-commit check: the stub selects the branch with BUG_RED_DOCS_ONLY.
repo_docs="$tmp/repo-docs"
new_repo "$repo_docs"
mkdir -p "$repo_docs/docs"
printf 'notes\n' >"$repo_docs/docs/notes.md"
git -C "$repo_docs" add docs/notes.md
git -C "$repo_docs" commit -q -m docs
base_docs=$(git -C "$repo_docs" rev-parse HEAD~1)
cd "$repo_docs"
head_docs=$(git rev-parse HEAD)
export BUG_RED_DOCS_ONLY=true
rc=0
"$bug_red" "$base_docs" "$head_docs" >"$tmp/out-docs.txt" 2>&1 || rc=$?
unset BUG_RED_DOCS_ONLY
cd "$top"
[ "$rc" -eq 0 ] || { cat "$tmp/out-docs.txt" >&2; fail "docs-only case exited $rc, want 0"; }
grep -Fq "changes only docs" "$tmp/out-docs.txt" || { cat "$tmp/out-docs.txt" >&2; fail "docs-only case misses the docs-only message"; }
: >"$tmp/github-output.txt"
export BUG_RED_DOCS_ONLY=true
cd "$repo_docs"
GITHUB_OUTPUT="$tmp/github-output.txt" "$bug_red" --report "$base_docs" "$head_docs" >"$tmp/out-docs-report.txt" 2>&1 || {
  cat "$tmp/out-docs-report.txt" >&2
  fail "docs-only report mode failed"
}
unset BUG_RED_DOCS_ONLY
cd "$repo_docs"
grep -Fxq 'status=docs' "$tmp/github-output.txt" || {
  cat "$tmp/github-output.txt" >&2
  fail "docs-only report did not record its result"
}
cd "$top"

# A one-commit branch with no HEAD argument reports the one-commit
# message: the default HEAD resolves to a SHA, so the guard fires.
repo3="$tmp/repo3"
new_repo "$repo3"
mkdir -p "$repo3/crates/a/tests"
printf '// red\n' >"$repo3/crates/a/tests/red.rs"
git -C "$repo3" add crates/a/tests/red.rs
git -C "$repo3" commit -q -m only
base3=$(git -C "$repo3" rev-parse HEAD~1)
cd "$repo3"
rc=0
"$bug_red" "$base3" >"$tmp/out3.txt" 2>&1 || rc=$?
cd "$top"
[ "$rc" -eq 1 ] || { cat "$tmp/out3.txt" >&2; fail "one-commit case exited $rc, want 1"; }
grep -Fq "has one commit" "$tmp/out3.txt" || { cat "$tmp/out3.txt" >&2; fail "one-commit case misses the one-commit message"; }

# A branch that merges main after its red commit: main modifies a test
# file that already exists at the branch point and adds a new one. The
# merge base is main's tip, which the red commit does not descend from,
# so the red commit's own test file must reach the filter and neither of
# main's test files may.
repo4="$tmp/repo4"
new_repo "$repo4"
mkdir -p "$repo4/crates/a/tests"
printf '// existing v1\n' >"$repo4/crates/a/tests/existing.rs"
git -C "$repo4" add crates/a/tests/existing.rs
git -C "$repo4" commit -q -m base-tests
base4=$(git -C "$repo4" rev-parse HEAD)
git -C "$repo4" checkout -q -b feature
printf '// red\n' >"$repo4/crates/a/tests/red.rs"
git -C "$repo4" add crates/a/tests/red.rs
git -C "$repo4" commit -q -m red
git -C "$repo4" checkout -q -b main-side "$base4"
printf '// existing v2\n' >"$repo4/crates/a/tests/existing.rs"
printf '// main new\n' >"$repo4/crates/a/tests/main_new.rs"
git -C "$repo4" add crates/a/tests/existing.rs crates/a/tests/main_new.rs
git -C "$repo4" commit -q -m main
main4=$(git -C "$repo4" rev-parse HEAD)
git -C "$repo4" checkout -q feature
git -C "$repo4" merge -q --no-ff -m merge-main main-side
head4=$(git -C "$repo4" rev-parse HEAD)
cd "$repo4"
rc=0
"$bug_red" "$main4" "$head4" >"$tmp/out4.txt" 2>&1 || rc=$?
cd "$top"
[ "$rc" -eq 0 ] || { cat "$tmp/out4.txt" >&2; fail "merged-main case exited $rc, want 0"; }
grep -Fq "crates/a/tests/red.rs" "$record" || { cat "$tmp/out4.txt" >&2; fail "merged-main filter misses the red commit's test"; }
if grep -Fq "crates/a/tests/existing.rs" "$record" || grep -Fq "crates/a/tests/main_new.rs" "$record"; then
  cat "$tmp/out4.txt" >&2
  fail "merged-main filter names a test file main changed"
fi
