#!/usr/bin/env bash
# The negate-check for scripts/leak-scan (docs/testing.md, "Running tests"):
# a thrown-away nonce proves the scan names a leaked process, ignores a
# sibling run's processes, refuses an empty nonce, and stays silent once the
# leakers are reaped.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

err=$(mktemp)
leaker1=
leaker2=
# SIGKILL by explicit pid only: never a group id, never pkill, so a wrong
# pid can only miss, never signal what this test did not start.
kill_one() {
  local target=$1
  if [ -z "$target" ]; then
    return 0
  fi
  # An id of 1 or less is never signalled: kill -- 0 would reach the
  # caller's own group, and kill(-1) every process the user owns.
  if [ "$target" -gt 1 ] 2>/dev/null; then
    if kill -KILL "$target" 2>/dev/null; then
      :
    fi
    if wait "$target" 2>/dev/null; then
      :
    fi
  fi
}
cleanup() {
  kill_one "$leaker1"
  kill_one "$leaker2"
  rm -f "$err"
}
trap cleanup EXIT

n="self-test-$$-$(date +%s)-$RANDOM"
other="sibling-$$-$(date +%s)-$RANDOM"

# A leaker in this process group. It stays in python: macOS ps shows the
# environment of python but not of sh or sleep, so only a python leaker
# proves the scan names it. It ignores SIGTERM like the fixtures, so only
# SIGKILL reaps it, and time.sleep starts no child to outlive it.
FIBER_CHECK_RUN=$n python3 -c 'import signal, time; signal.signal(signal.SIGTERM, signal.SIG_IGN); time.sleep(10000)' &
leaker1=$!

if LEAK_SCAN_GRACE=0 scripts/leak-scan "$n" 2>"$err"; then
  echo "scripts/test-leak-scan: leak-scan exited 0 with leaker $leaker1 alive" >&2
  exit 1
fi
if ! grep -Fq "leaked process $leaker1:" "$err"; then
  echo "scripts/test-leak-scan: leak-scan did not name leaker $leaker1:" >&2
  cat "$err" >&2
  exit 1
fi

# A leaker that escapes its process group: no group reap reaches it, and it
# stays in python for the same reason as the first leaker. python3 is
# already required by scripts/check, and macOS ships no setsid.
FIBER_CHECK_RUN=$n python3 -c 'import os, signal, time; signal.signal(signal.SIGTERM, signal.SIG_IGN); os.setsid(); time.sleep(10000)' &
leaker2=$!

if LEAK_SCAN_GRACE=0 scripts/leak-scan "$n" 2>"$err"; then
  echo "scripts/test-leak-scan: leak-scan exited 0 with leakers $leaker1 and $leaker2 alive" >&2
  exit 1
fi
if ! grep -Fq "leaked process $leaker1:" "$err"; then
  echo "scripts/test-leak-scan: leak-scan did not name leaker $leaker1:" >&2
  cat "$err" >&2
  exit 1
fi
if ! grep -Fq "leaked process $leaker2:" "$err"; then
  echo "scripts/test-leak-scan: leak-scan did not name group-escaping leaker $leaker2:" >&2
  cat "$err" >&2
  exit 1
fi

# A sibling run's nonce never matches this run's leakers.
if LEAK_SCAN_GRACE=0 scripts/leak-scan "$other" 2>"$err"; then
  :
else
  echo "scripts/test-leak-scan: leak-scan named this run's leakers for a sibling nonce:" >&2
  cat "$err" >&2
  exit 1
fi
if [ -s "$err" ]; then
  echo "scripts/test-leak-scan: clean sibling scan printed output:" >&2
  cat "$err" >&2
  exit 1
fi

# An empty nonce would match everything, so the scan refuses it.
empty_rc=0
if scripts/leak-scan "" 2>"$err"; then
  echo "scripts/test-leak-scan: leak-scan accepted an empty NONCE" >&2
  exit 1
else
  empty_rc=$?
fi
if [ "$empty_rc" -ne 2 ]; then
  echo "scripts/test-leak-scan: empty NONCE exited $empty_rc, want 2" >&2
  exit 1
fi

kill_one "$leaker1"
kill_one "$leaker2"
leaker1=
leaker2=
if LEAK_SCAN_GRACE=0 scripts/leak-scan "$n" 2>"$err"; then
  :
else
  echo "scripts/test-leak-scan: leak-scan still names the reaped leakers:" >&2
  cat "$err" >&2
  exit 1
fi
if [ -s "$err" ]; then
  echo "scripts/test-leak-scan: clean scan printed output:" >&2
  cat "$err" >&2
  exit 1
fi
