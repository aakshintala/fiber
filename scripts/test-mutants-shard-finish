#!/usr/bin/env bash
# The self-test for scripts/mutants-shard-finish: the finished-shard
# status mapping the scheduled mutants workflow reads in its mutants
# step. Each case pins the exit status and what reaches the step summary,
# including a description that itself holds colons and the empty-input
# and non-numeric edges.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "scripts/test-mutants-shard-finish: $1" >&2
  exit 1
}

# A capture file holding two missed mutants, one whose description holds
# colons, plus a line that is not a missed mutant.
cat >"$tmp/captured.txt" <<'EOF'
   Mutants tested: 512
MISSED crates/tui/src/login_view.rs:411:23: delete ! in Login::draw
MISSED crates/hub/src/session.rs:87:5: replace Ok(()): () with Err(()): ()
Caught: 510 missed: 2
EOF

# Status 0 exits 0 silently: empty stdout and an empty summary.
GITHUB_STEP_SUMMARY="$tmp/summary0.txt" scripts/mutants-shard-finish 0 "$tmp/captured.txt" >"$tmp/got0.txt" 2>"$tmp/err0.txt" \
  || fail "status 0 exited $?"
[ -s "$tmp/got0.txt" ] && fail "status 0 printed stdout"
[ -s "$tmp/err0.txt" ] && fail "status 0 printed stderr"
[ -e "$tmp/summary0.txt" ] && [ -s "$tmp/summary0.txt" ] && fail "status 0 wrote the summary"

# Status 2 exits 0 and appends each missed mutant's file:line to the
# summary; the description's colons never leak in, and other lines are
# ignored.
GITHUB_STEP_SUMMARY="$tmp/summary2.txt" scripts/mutants-shard-finish 2 "$tmp/captured.txt" >"$tmp/got2.txt" 2>"$tmp/err2.txt" \
  || fail "status 2 exited $?"
[ -s "$tmp/got2.txt" ] && fail "status 2 printed stdout when the summary is set"
[ -s "$tmp/err2.txt" ] && fail "status 2 printed stderr"
printf '%s\n' 'crates/tui/src/login_view.rs:411' 'crates/hub/src/session.rs:87' >"$tmp/want2.txt"
cmp -s "$tmp/want2.txt" "$tmp/summary2.txt" || {
  echo "--- want:" >&2
  cat "$tmp/want2.txt" >&2
  echo "--- got:" >&2
  cat "$tmp/summary2.txt" >&2
  fail "status 2 summary differs"
}

# Status 2 with an empty capture still exits 0, leaving an empty summary.
: >"$tmp/empty.txt"
GITHUB_STEP_SUMMARY="$tmp/summary-empty.txt" scripts/mutants-shard-finish 2 "$tmp/empty.txt" >"$tmp/got-empty.txt" 2>"$tmp/err-empty.txt" \
  || fail "status 2 with empty input exited $?"
[ -s "$tmp/got-empty.txt" ] && fail "status 2 with empty input printed stdout"
[ -s "$tmp/err-empty.txt" ] && fail "status 2 with empty input printed stderr"
[ -e "$tmp/summary-empty.txt" ] && [ -s "$tmp/summary-empty.txt" ] && fail "status 2 with empty input wrote the summary"

# With no summary file configured, status 2 falls back to stdout.
env -u GITHUB_STEP_SUMMARY scripts/mutants-shard-finish 2 "$tmp/captured.txt" >"$tmp/got-fallback.txt" 2>"$tmp/err-fallback.txt" \
  || fail "status 2 without a summary exited $?"
[ -s "$tmp/err-fallback.txt" ] && fail "status 2 without a summary printed stderr"
cmp -s "$tmp/want2.txt" "$tmp/got-fallback.txt" || {
  echo "--- want:" >&2
  cat "$tmp/want2.txt" >&2
  echo "--- got:" >&2
  cat "$tmp/got-fallback.txt" >&2
  fail "status 2 stdout fallback differs"
}

# Any other status passes through unchanged.
for other in 1 3; do
  rc=0
  GITHUB_STEP_SUMMARY="$tmp/summary$other.txt" scripts/mutants-shard-finish "$other" "$tmp/captured.txt" \
    >"$tmp/got$other.txt" 2>"$tmp/err$other.txt" || rc=$?
  [ "$rc" -eq "$other" ] || fail "status $other exited $rc, want $other"
done

# A non-numeric status exits 2 with empty stdout.
rc=0
GITHUB_STEP_SUMMARY="$tmp/summary-bad.txt" scripts/mutants-shard-finish abc "$tmp/captured.txt" \
  >"$tmp/got-bad.txt" 2>"$tmp/err-bad.txt" || rc=$?
[ "$rc" -eq 2 ] || fail "non-numeric status exited $rc, want 2"
[ -s "$tmp/got-bad.txt" ] && fail "non-numeric status printed stdout"
[ -s "$tmp/err-bad.txt" ] || fail "non-numeric status printed no message"
