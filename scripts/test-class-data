#!/usr/bin/env bash
# The offline self-test for scripts/class-data (#2446): with a fixture
# directory as the fourth argument, the fast "Terminal to its first
# frame, attaching" 10 MiB run reproduces the committed file's entries
# for the fixture's main files byte for byte; usage errors, unknown
# classes, unknown rows and unknown fixtures exit 2; and an artifact
# whose CPU is outside the class stays out of the output.
# No network: a shadow gh on the PATH fails the test if the script calls it.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fixture=$PWD/scripts/class-data-fixture
committed=xtask/tests/class_data/9v45-attach-10mib.json
row="Terminal to its first frame, attaching"
err=$(mktemp)
tmp=$(mktemp -d)
cleanup() {
  rc=$?
  rm -rf "$tmp" || true
  rm -f "$err" || true
  exit "$rc"
}
trap cleanup EXIT

fail() {
  echo "scripts/test-class-data: $*" >&2
  exit 1
}

# No network in this test: any gh call fails loudly.
mkdir -p "$tmp/bin"
printf '#!/usr/bin/env bash\necho "scripts/test-class-data: unexpected gh call: $*" >&2\nexit 1\n' >"$tmp/bin/gh"
chmod +x "$tmp/bin/gh"
PATH="$tmp/bin:$PATH"

# Usage errors exit 2: no arguments, one argument, two arguments, and
# five arguments (the usage takes three or four).
rc=0
scripts/class-data >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "no arguments exited $rc, want 2"
rc=0
scripts/class-data fast >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "one argument exited $rc, want 2"
rc=0
scripts/class-data fast "$row" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "two arguments exited $rc, want 2"
rc=0
scripts/class-data fast "$row" "10 MiB" "$fixture" extra >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "five arguments exited $rc, want 2"

# An unknown class exits 2, and so do an unknown row and an unknown fixture.
rc=0
scripts/class-data plaid "$row" "10 MiB" "$fixture" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "unknown class exited $rc, want 2"
rc=0
scripts/class-data fast "Terminal to its first frame" "10 MiB" "$fixture" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "unknown row exited $rc, want 2"
rc=0
scripts/class-data fast "$row" "1 MiB" "$fixture" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "unknown fixture exited $rc, want 2"

# The fast attaching 10 MiB run over the fixture directory.
if ! scripts/class-data fast "$row" "10 MiB" "$fixture" >"$tmp/out.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data fast attaching 10 MiB failed:" >&2; cat "$err" >&2; exit 1
fi

# The fixture's main files, in file order: the set the script must emit.
jq -r '[.artifacts[] | .name | sub("^benchmarks-"; "") | .[0:8] | "main " + .] | sort | .[]' "$fixture/listing.json" >"$tmp/files.txt"
[ -s "$tmp/files.txt" ] || fail "the fixture holds no artifacts"
want=$(wc -l <"$tmp/files.txt" | tr -d ' ')
entries=$(grep -c '"file"' "$tmp/out.json" || true)
[ "$entries" -eq "$want" ] || fail "emitted $entries entries for $want fixture files"
# The committed file's lines for those files, the last comma dropped:
# the script's whole document must equal this, byte for byte.
{
  echo "["
  while IFS= read -r f; do
    grep -F "\"file\": \"$f\"" "$committed" || fail "the committed file has no entry for $f"
  done <"$tmp/files.txt" >"$tmp/lines.txt"
  sed '$ s/,$//' "$tmp/lines.txt"
  echo "]"
} >"$tmp/expected.json"
if ! diff "$tmp/expected.json" "$tmp/out.json" >/dev/null; then
  echo "scripts/test-class-data: output differs from the committed entries:" >&2
  diff "$tmp/expected.json" "$tmp/out.json" >&2
  exit 1
fi

# A mixed-CPU fixture: the fast head, a slow head, an expired fast head,
# a fast head from another branch, a fast head from a forked repository
# and a non-benchmark artifact record. Only the live fast head may appear
# in the fast output, and only the slow head in the slow output.
# The non-benchmark record has no directory: the name guard must skip it
# before any read, so a flipped guard fails the run with exit 1.
mixed=$tmp/mixed
mkdir -p "$mixed"
fast_name=$(jq -r '.artifacts[0].name' "$fixture/listing.json")
mkdir -p "$mixed/$fast_name"
cp "$fixture/$fast_name/head.json" "$mixed/$fast_name/head.json"
stripped=${fast_name#benchmarks-}
fast_short=${stripped:0:8}
slow_full="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
slow_name="benchmarks-$slow_full"
mkdir -p "$mixed/$slow_name"
jq '.cpu = "AMD EPYC 7763 64-Core Processor"' "$mixed/$fast_name/head.json" >"$mixed/$slow_name/head.json"
gone_full="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
gone_name="benchmarks-$gone_full"
mkdir -p "$mixed/$gone_name"
cp "$mixed/$fast_name/head.json" "$mixed/$gone_name/head.json"
fork_full="1111111111111111111111111111111111111111111111111111111111111111"
fork_name="benchmarks-$fork_full"
mkdir -p "$mixed/$fork_name"
cp "$mixed/$fast_name/head.json" "$mixed/$fork_name/head.json"
stranger_full="2222222222222222222222222222222222222222222222222222222222222222"
stranger_name="benchmarks-$stranger_full"
mkdir -p "$mixed/$stranger_name"
cp "$mixed/$fast_name/head.json" "$mixed/$stranger_name/head.json"
jq --arg fast "$fast_name" --arg slow "$slow_name" --arg gone "$gone_name" --arg fork "$fork_name" --arg stranger "$stranger_name" \
  '.artifacts[0] as $one | {total_count: 6, artifacts: [$one, ($one | .name = $slow), ($one | .name = $gone | .expired = true), ($one | .name = $fork | .workflow_run.head_branch = "other"), ($one | .name = $stranger | .workflow_run.head_repository_id = 1), ($one | .name = "mutants-0")]}' \
  "$fixture/listing.json" >"$mixed/listing.json"

if ! scripts/class-data fast "$row" "10 MiB" "$mixed" >"$tmp/fast.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data over the mixed fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/fast.json" || true)" -eq 1 ] || fail "fast output over the mixed fixture has no single entry:"
grep -Fq "\"file\": \"main $fast_short\"" "$tmp/fast.json" || fail "fast output lost the fast head"
grep -Fq "${slow_full:0:8}" "$tmp/fast.json" && fail "fast output holds the slow head"
grep -Fq "${gone_full:0:8}" "$tmp/fast.json" && fail "fast output holds the expired head"
grep -Fq "${fork_full:0:8}" "$tmp/fast.json" && fail "fast output holds the other-branch head"
grep -Fq "${stranger_full:0:8}" "$tmp/fast.json" && fail "fast output holds the forked-repository head"
if ! scripts/class-data slow "$row" "10 MiB" "$mixed" >"$tmp/slow.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data slow over the mixed fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/slow.json" || true)" -eq 1 ] || fail "slow output over the mixed fixture has no single entry"
grep -Fq "\"file\": \"main ${slow_full:0:8}\"" "$tmp/slow.json" || fail "slow output lost the slow head"
grep -Fq "$fast_short" "$tmp/slow.json" && fail "slow output holds the fast head"
# The middle class holds none of the mixed heads: an empty document.
if ! scripts/class-data middle "$row" "10 MiB" "$mixed" >"$tmp/middle.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data middle over the mixed fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/middle.json" || true)" -eq 0 ] || fail "middle output over the mixed fixture is not empty"
# A head in the class without this row's samples contributes no entry.
nosamples=$tmp/nosamples
mkdir -p "$nosamples"
jq '{total_count: 1, artifacts: [.artifacts[0]]}' "$fixture/listing.json" >"$nosamples/listing.json"
mkdir -p "$nosamples/$fast_name"
jq '.metrics = {}' "$fixture/$fast_name/head.json" >"$nosamples/$fast_name/head.json"
if ! scripts/class-data fast "$row" "10 MiB" "$nosamples" >"$tmp/nosamples.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data over the sample-less fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/nosamples.json" || true)" -eq 0 ] || fail "sample-less head contributed an entry"

# A listing entry with no artifact on disk is a read failure, exit 1.
missing=$tmp/missing
mkdir -p "$missing"
jq '{total_count: 1, artifacts: [.artifacts[0]]}' "$fixture/listing.json" >"$missing/listing.json"
rc=0
scripts/class-data fast "$row" "10 MiB" "$missing" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 1 ] || fail "missing head.json exited $rc, want 1"

# --- #2668 the session_list row reads plain-number samples ---
# A hand-written session_list fixture under /tmp: its own listing plus
# head.json files, never the committed 9v45-session-list.json. The
# session_list row takes the fixture "none" and emits plain numbers.
session_row="\`session_list\`, waiting for every running session's status"
slist=$tmp/slist
mkdir -p "$slist"
# The two heads below are written by hand, plain numbers only.
fast_a="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
fast_b="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
mkdir -p "$slist/benchmarks-$fast_a" "$slist/benchmarks-$fast_b"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [25.8, 25.4, 25.0, 26.0, 26.1]}}\n' >"$slist/benchmarks-$fast_a/head.json"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [24.1, 24.3, 24.0, 24.2, 24.4]}}\n' >"$slist/benchmarks-$fast_b/head.json"
jq -n --arg a "$fast_a" --arg b "$fast_b" '{total_count: 2, artifacts: [{name: ("benchmarks-" + $a), expired: false, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}, {name: ("benchmarks-" + $b), expired: false, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}]}' >"$slist/listing.json"

# The accepted row+none pair emits the fixture's plain numbers.
if ! scripts/class-data fast "$session_row" none "$slist" >"$tmp/slist.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data fast session_list none failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/slist.json" || true)" -eq 2 ] || fail "session_list output has no two entries:"
grep -Fq '"file": "main aaaaaaaa", "samples": [25.8, 25.4, 25, 26, 26.1]' "$tmp/slist.json" || fail "session_list output lost the first head's samples"
grep -Fq '"file": "main bbbbbbbb", "samples": [24.1, 24.3, 24, 24.2, 24.4]' "$tmp/slist.json" || fail "session_list output lost the second head's samples"

# A fixture value for the session_list row exits 2, as does the bare id.
rc=0
scripts/class-data fast "$session_row" "10 MiB" "$slist" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "session_list with a fixture exited $rc, want 2"
rc=0
scripts/class-data fast "session_list" none "$slist" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "bare session_list row exited $rc, want 2"

# A mixed-CPU session_list fixture: the fast, 7763 and 9V74 heads carry
# both metrics, plus an expired fast head and an other-branch fast head.
# The fast session_list output holds only the fast head; the slow output
# holds both slow CPUs; the middle output is empty. The attach slow output
# over the same heads holds only 7763: the 9V74 widening is session_list's.
smixed=$tmp/smixed
mkdir -p "$smixed"
fast_full="cccccccccccccccccccccccccccccccccccccccc"
slow_full="dddddddddddddddddddddddddddddddddddddddd"
nine_full="eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
gone2_full="ffffffffffffffffffffffffffffffffffffffff"
branch_full="1212121212121212121212121212121212121212"
mkdir -p "$smixed/benchmarks-$fast_full" "$smixed/benchmarks-$slow_full" "$smixed/benchmarks-$nine_full" "$smixed/benchmarks-$gone2_full" "$smixed/benchmarks-$branch_full"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [25.8, 25.4, 25.0, 26.0, 26.1], "terminal_attach_ms": [{"fixture": "10 MiB", "log_bytes": 10490016, "ms": 88.0}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 88.5}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 88.2}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 87.9}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 88.4}]}}\n' >"$smixed/benchmarks-$fast_full/head.json"
printf '{"cpu": "AMD EPYC 7763 64-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [30.2, 30.0, 30.5, 30.1, 30.3], "terminal_attach_ms": [{"fixture": "10 MiB", "log_bytes": 10490016, "ms": 98.0}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 98.5}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 98.2}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 97.9}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 98.4}]}}\n' >"$smixed/benchmarks-$slow_full/head.json"
printf '{"cpu": "AMD EPYC 9V74 80-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [28.4, 28.0, 28.6, 28.2, 28.5], "terminal_attach_ms": [{"fixture": "10 MiB", "log_bytes": 10490016, "ms": 95.0}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 95.5}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 95.2}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 94.9}, {"fixture": "10 MiB", "log_bytes": 10490016, "ms": 95.4}]}}\n' >"$smixed/benchmarks-$nine_full/head.json"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [25.8, 25.4, 25.0, 26.0, 26.1]}}\n' >"$smixed/benchmarks-$gone2_full/head.json"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [25.8, 25.4, 25.0, 26.0, 26.1]}}\n' >"$smixed/benchmarks-$branch_full/head.json"
jq -n --arg fast "$fast_full" --arg slow "$slow_full" --arg nine "$nine_full" --arg gone "$gone2_full" --arg branch "$branch_full" '{total_count: 5, artifacts: [{name: ("benchmarks-" + $fast), expired: false, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}, {name: ("benchmarks-" + $slow), expired: false, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}, {name: ("benchmarks-" + $nine), expired: false, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}, {name: ("benchmarks-" + $gone), expired: true, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}, {name: ("benchmarks-" + $branch), expired: false, workflow_run: {head_branch: "other", head_repository_id: 7, repository_id: 7}}]}' >"$smixed/listing.json"
if ! scripts/class-data fast "$session_row" none "$smixed" >"$tmp/sfast.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data fast session_list over the mixed fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/sfast.json" || true)" -eq 1 ] || fail "fast session_list output over the mixed fixture has no single entry"
grep -Fq '"file": "main cccccccc"' "$tmp/sfast.json" || fail "fast session_list output lost the fast head"
grep -Fq "dddddddd" "$tmp/sfast.json" && fail "fast session_list output holds the 7763 head"
grep -Fq "eeeeeeee" "$tmp/sfast.json" && fail "fast session_list output holds the 9V74 head"
if ! scripts/class-data slow "$session_row" none "$smixed" >"$tmp/sslow.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data slow session_list over the mixed fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/sslow.json" || true)" -eq 2 ] || fail "slow session_list output over the mixed fixture has no two entries"
grep -Fq '"file": "main dddddddd"' "$tmp/sslow.json" || fail "slow session_list output lost the 7763 head"
grep -Fq '"file": "main eeeeeeee"' "$tmp/sslow.json" || fail "slow session_list output lost the 9V74 head"
if ! scripts/class-data middle "$session_row" none "$smixed" >"$tmp/smiddle.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data middle session_list over the mixed fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/smiddle.json" || true)" -eq 0 ] || fail "middle session_list output over the mixed fixture is not empty"
if ! scripts/class-data slow "$row" "10 MiB" "$smixed" >"$tmp/sattach.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data slow attaching over the session_list fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/sattach.json" || true)" -eq 1 ] || fail "slow attaching output over the session_list fixture has no single entry"
grep -Fq '"file": "main dddddddd"' "$tmp/sattach.json" || fail "slow attaching output lost the 7763 head"
grep -Fq "eeeeeeee" "$tmp/sattach.json" && fail "slow attaching output holds the 9V74 head"

# A session_list head without the metric contributes no entry.
nometric=$tmp/nometric
mkdir -p "$nometric"
jq -n --arg a "$fast_a" '{total_count: 1, artifacts: [{name: ("benchmarks-" + $a), expired: false, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}]}' >"$nometric/listing.json"
mkdir -p "$nometric/benchmarks-$fast_a"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {}}\n' >"$nometric/benchmarks-$fast_a/head.json"
if ! scripts/class-data fast "$session_row" none "$nometric" >"$tmp/nometric.json" 2>"$err"; then
  echo "scripts/test-class-data: class-data over the metric-less session_list fixture failed:" >&2; cat "$err" >&2; exit 1
fi
[ "$(grep -c '"file"' "$tmp/nometric.json" || true)" -eq 0 ] || fail "metric-less session_list head contributed an entry"

# A session_list entry shaped like an object, not a plain number, fails
# the run instead of emitting silently: array-of-objects and bare object.
objshape=$tmp/objshape
mkdir -p "$objshape"
jq -n --arg a "$fast_a" '{total_count: 1, artifacts: [{name: ("benchmarks-" + $a), expired: false, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}]}' >"$objshape/listing.json"
mkdir -p "$objshape/benchmarks-$fast_a"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [{"ms": 25.8}]}}\n' >"$objshape/benchmarks-$fast_a/head.json"
rc=0
scripts/class-data fast "$session_row" none "$objshape" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 1 ] || fail "object-shaped session_list samples exited $rc, want 1"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": {"ms": 25.8}}}\n' >"$objshape/benchmarks-$fast_a/head.json"
rc=0
scripts/class-data fast "$session_row" none "$objshape" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 1 ] || fail "object-valued session_list metric exited $rc, want 1"

# session_list_rejects_non_finite_or_negative_sample: a -1, NaN or
# infinite plain-number sample fails the run instead of emitting.
badnum=$tmp/badnum
mkdir -p "$badnum"
jq -n --arg a "$fast_a" '{total_count: 1, artifacts: [{name: ("benchmarks-" + $a), expired: false, workflow_run: {head_branch: "main", head_repository_id: 7, repository_id: 7}}]}' >"$badnum/listing.json"
mkdir -p "$badnum/benchmarks-$fast_a"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [25.8, 25.4, 25.0, 26.0, -1]}}\n' >"$badnum/benchmarks-$fast_a/head.json"
rc=0
scripts/class-data fast "$session_row" none "$badnum" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 1 ] || fail "session_list_rejects_non_finite_or_negative_sample: -1 exited $rc, want 1"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [25.8, 25.4, 25.0, 26.0, NaN]}}\n' >"$badnum/benchmarks-$fast_a/head.json"
rc=0
scripts/class-data fast "$session_row" none "$badnum" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 1 ] || fail "session_list_rejects_non_finite_or_negative_sample: NaN exited $rc, want 1"
printf '{"cpu": "AMD EPYC 9V45 96-Core Processor", "schema": 1, "runs": 5, "metrics": {"session_list_ms": [25.8, 25.4, 25.0, 26.0, 1e999]}}\n' >"$badnum/benchmarks-$fast_a/head.json"
rc=0
scripts/class-data fast "$session_row" none "$badnum" >/dev/null 2>"$err" || rc=$?
[ "$rc" -eq 1 ] || fail "session_list_rejects_non_finite_or_negative_sample: infinite exited $rc, want 1"
