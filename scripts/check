#!/usr/bin/env bash
# The gate (docs/workflow.md, "The gate"). Runs the checks docs/ci.md,
# "Selection", chooses for the diff.
#
# Usage: scripts/check [--base REV] [--platform-only | --shared-only]
#
#   --base REV       compare against the merge base with REV (default origin/main);
#                    uncommitted and untracked files count as changed
#   --platform-only  only clippy, nextest and doc-tests: what CI runs on
#                    every platform
#   --shared-only    only the platform-independent checks: what CI runs on
#                    Linux x86_64 alone. The unsafe table and dependency list
#                    are not among them: CI's selection job runs those.
set -euo pipefail
# The last line says pass or fail, so a caller reading only the tail of the
# output (`| tail`) cannot mistake a failure for a pass.
log=
rc=0
# Set inside the EXIT trap below; initialised here so shellcheck sees the
# assignment (the trap string is the only other place it is set).
leak_rc=0
# Set to 1 once the test run's nonce is exported: the EXIT trap then scans
# for leaked processes, failing a passing run that leaked any.
scan_leaks=0
# Epoch seconds when the check began: the macOS orphan scan lists only
# processes owned by the user with ppid 1 that started after this time.
check_start=$(date +%s)
export FIBER_CHECK_START=$check_start
trap 'rc=$?; rm -f "$log"; if [ "$scan_leaks" = 1 ]; then echo "== leak scan"; if scripts/leak-scan "$FIBER_CHECK_RUN" "$check_start"; then :; else leak_rc=$?; echo "scripts/check: leaked processes (exit $leak_rc)" >&2; if [ "$rc" -eq 0 ]; then rc=$leak_rc; fi; fi; fi; if [ $rc -eq 0 ]; then echo "scripts/check: PASS"; else echo "scripts/check: FAIL (exit $rc)"; fi; exit $rc' EXIT
cd "$(git rev-parse --show-toplevel)"

base=origin/main
scope=all
while [ $# -gt 0 ]; do
  case $1 in
    --base) base=$2; shift 2 ;;
    --platform-only) scope=platform; shift ;;
    --shared-only) scope=shared; shift ;;
    *) sed -n '5,14p' "$0" >&2; exit 2 ;;
  esac
done

selection=$(cargo xtask select --base "$base")
value() { sed -n "s/^$1=//p" <<<"$selection"; }
mode=$(value mode)
packages=$(value packages)
package_specs=$(value package_specs)
library_specs=$(value library_specs)
extension_packages=$(value extension_packages)
echo "== selection: $mode; crates: ${packages:-none}"
echo "== extension cases: ${extension_packages:-none}"

# cargo fmt only matches a bare name among workspace members. The other
# commands below resolve `-p` against the whole dependency graph, so they
# need a spec that still names one package once a workspace crate shares a
# name with a dependency (docs/ci.md, "Selection").
package_args=()
for p in $packages; do package_args+=(-p "$p"); done
package_spec_args=()
for p in $package_specs; do package_spec_args+=(-p "$p"); done

log=$(mktemp)
# Sums the numbers in every match of $1 in the last command's output, with
# colour codes removed (CI sets CARGO_TERM_COLOR=always). No match is an error.
count() {
  local matches
  matches=$(sed $'s/\033\\[[0-9;]*m//g' "$log" | grep -oE "$1") || {
    echo "scripts/check: no \"$1\" in the output, so the test count is unknown" >&2
    return 1
  }
  grep -oE '[0-9]+' <<<"$matches" | awk '{ s += $1 } END { print s + 0 }'
}

if [ "$scope" != platform ]; then
  echo "== docs check"
  scripts/check-docs
  if [ "$scope" = all ]; then
    echo "== unsafe table, dependency list"
    cargo xtask unsafe-table
    cargo xtask dependency-list
  fi
  # research/tui-prototype is not a workspace member, so nothing else here lints
  # it, and a diff that touches only research/ is mode docs. It has its own
  # manifest and target directory; lint it when the diff touches it
  # (docs/ci.md, "On every pull request that changes code").
  prototype=research/tui-prototype
  if { git diff --name-only "$(git merge-base "$base" HEAD)"; git ls-files --others --exclude-standard; } | grep -q "^$prototype/"; then
    echo "== tui-prototype: cargo fmt --check, cargo clippy"
    cargo fmt --check --manifest-path "$prototype/Cargo.toml"
    cargo clippy --all-targets --manifest-path "$prototype/Cargo.toml" -- -D warnings
  fi
  if [ "$mode" != docs ]; then
    if [ ${#package_args[@]} -gt 0 ]; then
      echo "== cargo fmt --check"
      cargo fmt --check "${package_args[@]}"
    fi
    echo "== signal sites, compiled-in list, image and tui isolation"
    cargo xtask signal-sites
    cargo xtask compiled-in
    cargo xtask image-isolation
    cargo xtask tui-isolation
    # CI runs this on Linux x86_64 alone (docs/ci.md), where the runner
    # ships shellcheck, so a missing one fails rather than skips.
    if [ "$(uname -s)" = Linux ]; then
      echo "== shellcheck"
      shellcheck --shell=sh scripts/install.sh \
        crates/main/tests/install_fixture/fiber \
        crates/main/tests/install_fixture/bin/uname \
        crates/main/tests/install_fixture/bin/sysctl
      shellcheck --shell=bash scripts/flaky-tests scripts/test-flaky-tests scripts/leak-scan scripts/test-leak-scan scripts/test-leak-probe
    else
      echo "== shellcheck: Linux only (docs/ci.md), not run here"
    fi
  fi
fi

if [ "$scope" != shared ] && [ ${#package_args[@]} -gt 0 ]; then
  echo "== leak-scan self-test"
  scripts/test-leak-scan
  echo "== flaky-tests self-test"
  scripts/test-flaky-tests
  echo "== cargo clippy --all-targets -- -D warnings"
  cargo clippy --all-targets "${package_spec_args[@]}" -- -D warnings
  # A per-run nonce in the environment: every descendant inherits it, so
  # the EXIT trap's scan names only this run's leaked processes. uuidgen
  # ships on Linux CI and macOS; the fallback needs only bash and date.
  if [ -z "${FIBER_CHECK_RUN-}" ]; then
    if ! FIBER_CHECK_RUN=$(uuidgen 2>/dev/null); then
      FIBER_CHECK_RUN="$$-$(date +%s)-$RANDOM"
    fi
  fi
  export FIBER_CHECK_RUN
  scan_leaks=1
  echo "== cargo nextest run"
  # One timing flake must not hide the other tests' results: a failed run
  # reports every failure, so a rerun is not needed to see them.
  cargo nextest run --no-fail-fast "${package_spec_args[@]}" 2>&1 | tee "$log"
  nextest=$(count '[0-9]+ tests? run')
  case " $packages " in
    *" main "*)
      echo "== leak probe"
      scripts/test-leak-probe
      ;;
  esac
  if [ -n "$extension_packages" ]; then
    echo "== fiber extension test"
    target_directory=$(cargo metadata --format-version 1 --no-deps | \
      python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')
    cargo build -p main --bin fiber
    fiber="$target_directory/debug/fiber"
    for package in $extension_packages; do
      echo "== $fiber extension test $package"
      "$fiber" extension test "$package"
    done
  fi
  # A crate with no library has no doc-tests, and cargo refuses to look.
  doctests=0
  if [ -n "$library_specs" ]; then
    library_spec_args=()
    for p in $library_specs; do library_spec_args+=(-p "$p"); done
    echo "== cargo test --doc"
    cargo test --doc "${library_spec_args[@]}" 2>&1 | tee "$log"
    doctests=$(count '[0-9]+ passed')
  fi
  echo "tests run: $nextest under nextest, $doctests doc-tests"
fi
