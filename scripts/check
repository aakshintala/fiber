#!/usr/bin/env bash
# The gate (docs/workflow.md, "The gate"). Runs the checks docs/ci.md,
# "Selection", chooses for the diff.
#
# Usage: scripts/check [--base REV] [--platform-only | --shared-only]
#
#   --base REV       compare against the merge base with REV (default origin/main);
#                    uncommitted and untracked files count as changed
#   --platform-only  only clippy, nextest and doc-tests: what CI runs on
#                    every platform
#   --shared-only    only the platform-independent checks: what CI runs on
#                    Linux x86_64 alone. The unsafe table and dependency list
#                    are not among them: CI's selection job runs those.
set -euo pipefail
# The last line says pass or fail, so a caller reading only the tail of the
# output (`| tail`) cannot mistake a failure for a pass.
log=
# The resource-exhaustion cause for the FAIL line: set by the preflight and
# by step_failed when classify matches, empty otherwise.
resource_cause=
rc=0
# Set inside the EXIT trap below; initialised here so shellcheck sees the
# assignment (the trap string is the only other place it is set).
leak_rc=0
# Set to 1 once the test run's nonce is exported: the EXIT trap then scans
# for leaked processes, failing a passing run that leaked any.
scan_leaks=0
# Epoch seconds when the check began: the macOS orphan scan lists only
# processes owned by the user with ppid 1 that started after this time.
check_start=$(date +%s)
export FIBER_CHECK_START=$check_start
trap 'rc=$?; if [ $rc -eq 0 ]; then rm -f "$log"; fi; if [ "$scan_leaks" = 1 ]; then echo "== leak scan"; if scripts/leak-scan "$FIBER_CHECK_RUN" "$check_start"; then :; else leak_rc=$?; echo "scripts/check: leaked processes (exit $leak_rc)" >&2; if [ "$rc" -eq 0 ]; then rc=$leak_rc; fi; fi; fi; if [ $rc -eq 0 ]; then echo "scripts/check: PASS"; else [ -n "$log" ] && [ -s "$log" ] && echo "scripts/check: full output in $log"; if [ -n "$resource_cause" ]; then echo "scripts/check: FAIL (exit $rc): $resource_cause"; else echo "scripts/check: FAIL (exit $rc)"; fi; fi; exit $rc' EXIT
cd "$(git rev-parse --show-toplevel)"

base=origin/main
scope=all
while [ $# -gt 0 ]; do
  case $1 in
    --base) base=$2; shift 2 ;;
    --platform-only) scope=platform; shift ;;
    --shared-only) scope=shared; shift ;;
    *) sed -n '5,14p' "$0" >&2; exit 2 ;;
  esac
done

# A compile or link step, wrapped: the pipeline status is the step's (tee
# exits 0, and pipefail keeps cargo's), so a pass truncates the shared log
# and a failure classifies the output. Runs in the main shell, so a failure
# exits the script. Defined beside count would run too late: the select step
# below already calls step_failed.
build_step() {
  if "$@" 2>&1 | tee "$log"; then : >"$log"; else step_rc=$?; step_failed "$step_rc"; fi
}

# The failure branch of a wrapped step: classify turns a killed compile or
# link step into exit 75 and keeps the cause for the FAIL line, and every
# other failure keeps the step's code. The substitution is an if condition,
# so set -e cannot pre-empt it.
step_failed() {
  if resource_cause=$(scripts/check-resources classify "$log"); then
    resource_cause=
    exit "$1"
  else
    classify_rc=$?
  fi
  if [ "$classify_rc" -eq 75 ]; then
    exit 75
  else
    resource_cause=
    exit "$1"
  fi
}

# The preflight runs before any build step and before the log exists: a
# refusal exits here, so no build step ran. On exit 75 the refusal sentence
# becomes the FAIL line's cause; any other preflight failure keeps its code.
if pre=$(scripts/check-resources preflight); then echo "== preflight: $pre"; else pre_rc=$?; [ "$pre_rc" -ne 75 ] || resource_cause=$pre; exit "$pre_rc"; fi

log=$(mktemp)

# The select step's stderr goes to the log and is replayed after the step
# ends; a cold xtask build shows no progress until it finishes. A pass
# truncates the log, so a later failure cannot mislabel this output as its
# own. step_failed turns a killed compile or link step into exit 75.
if selection=$(cargo xtask select --base "$base" 2>"$log"); then step_rc=0; else step_rc=$?; fi
cat "$log" >&2
if [ "$step_rc" -ne 0 ]; then step_failed "$step_rc"; fi
: >"$log"
value() { sed -n "s/^$1=//p" <<<"$selection"; }
mode=$(value mode)
packages=$(value packages)
package_specs=$(value package_specs)
library_specs=$(value library_specs)
extension_packages=$(value extension_packages)
echo "== selection: $mode; crates: ${packages:-none}"
echo "== extension cases: ${extension_packages:-none}"

# cargo fmt only matches a bare name among workspace members. The other
# commands below resolve `-p` against the whole dependency graph, so they
# need a spec that still names one package once a workspace crate shares a
# name with a dependency (docs/ci.md, "Selection").
package_args=()
for p in $packages; do package_args+=(-p "$p"); done
package_spec_args=()
for p in $package_specs; do package_spec_args+=(-p "$p"); done

# Sums the numbers in every match of $1 in the last command's output, with
# colour codes removed (CI sets CARGO_TERM_COLOR=always). No match is an error.
count() {
  local matches
  matches=$(sed $'s/\033\\[[0-9;]*m//g' "$log" | grep -oE "$1") || {
    echo "scripts/check: no \"$1\" in the output, so the test count is unknown" >&2
    return 1
  }
  grep -oE '[0-9]+' <<<"$matches" | awk '{ s += $1 } END { print s + 0 }'
}

if [ "$scope" != platform ]; then
  echo "== docs check"
  scripts/check-docs
  if [ "$scope" = all ]; then
    echo "== unsafe table, dependency list"
    cargo xtask unsafe-table
    cargo xtask dependency-list
  fi
  # research/tui-prototype is not a workspace member, so nothing else here lints
  # it, and a diff that touches only research/ is mode docs. It has its own
  # manifest and target directory; lint it when the diff touches it
  # (docs/ci.md, "On every pull request that changes code").
  prototype=research/tui-prototype
  if { git diff --name-only "$(git merge-base "$base" HEAD)"; git ls-files --others --exclude-standard; } | grep -q "^$prototype/"; then
    echo "== tui-prototype: cargo fmt --check, cargo clippy"
    cargo fmt --check --manifest-path "$prototype/Cargo.toml"
    build_step cargo clippy --all-targets --manifest-path "$prototype/Cargo.toml" -- -D warnings
  fi
  if [ "$mode" != docs ]; then
    if [ ${#package_args[@]} -gt 0 ]; then
      echo "== cargo fmt --check"
      cargo fmt --check "${package_args[@]}"
    fi
    echo "== signal sites, compiled-in list, image and tui isolation, crate edges, preserve-order"
    cargo xtask signal-sites
    cargo xtask compiled-in
    cargo xtask image-isolation
    cargo xtask tui-isolation
    cargo xtask crate-edges
    cargo xtask preserve-order
    echo "== architecture rules 3, 4 and 5"
    cargo xtask session-paths
    cargo xtask fiber-home-paths
    cargo xtask loop-tool-names
    echo "== must-succeed bounds"
    cargo xtask must-succeed
    echo "== budget bounds"
    cargo xtask budget-bounds --base "$base"
    echo "== grid-read ratchet"
    # A grid read outside a wait observes a frame no wait settled, so the
    # frame it compares can differ from the waited one
    # (docs/testing/screens.md, "Screens"). Each file under
    # crates/main/tests/ holds at most its inline maximum of unmarked
    # grid-read lines (`.screen()`, `.cell(`, `.contents`, `.rows`), and a
    # file missing from the list holds none: a line inside a `wait_screen`
    # call's span is the wait's own check, while the literal text
    # `// settled:` on the read line or the line before it exempts a read,
    # even inside a string literal, since the count is a conservative
    # upper bound. `crates/main/tests/support/` is outside the rule,
    # and a `.screen` field access (as in `login.rs`) is not a call. Read
    # detection, wait-span tracking, comment recognition and the per-file
    # comparison live in `cargo xtask screen-ratchet`
    # (docs/testing.md, "Levels").
    cargo xtask screen-ratchet <<'EOF'
crates/main/tests/approval_look.rs 53
crates/main/tests/ask_user_form_look.rs 66
crates/main/tests/at_path_search.rs 1
crates/main/tests/attach_first_frame.rs 4
crates/main/tests/cache_countdown.rs 2
crates/main/tests/call_view.rs 34
crates/main/tests/change_workspace.rs 1
crates/main/tests/changed_files_editor.rs 4
crates/main/tests/clear.rs 2
crates/main/tests/credential_signals.rs 3
crates/main/tests/delegates.rs 31
crates/main/tests/delete.rs 13
crates/main/tests/doctor_command.rs 3
crates/main/tests/exit_alias.rs 1
crates/main/tests/group_look.rs 38
crates/main/tests/handoff_look.rs 24
crates/main/tests/history_page_failed.rs 4
crates/main/tests/home_rail.rs 17
crates/main/tests/hover_look.rs 9
crates/main/tests/hub_pairing.rs 1
crates/main/tests/hub_remote_terminal.rs 5
crates/main/tests/hub_version.rs 11
crates/main/tests/inline_images.rs 10
crates/main/tests/item_views_look.rs 31
crates/main/tests/journeys.rs 19
crates/main/tests/light_no_color_look.rs 61
crates/main/tests/line_start_end.rs 6
crates/main/tests/link_look.rs 21
crates/main/tests/look.rs 163
crates/main/tests/look_diff.rs 6
crates/main/tests/look_markdown.rs 29
crates/main/tests/main_journeys.rs 63
crates/main/tests/model_picker_keys.rs 14
crates/main/tests/model_picker_name.rs 3
crates/main/tests/opened_call_look.rs 52
crates/main/tests/panel_look.rs 38
crates/main/tests/pinned_call_row.rs 19
crates/main/tests/placeholders_picker.rs 2
crates/main/tests/pty_sync_output.rs 13
crates/main/tests/quit_after_completed.rs 4
crates/main/tests/quota_fetch_session.rs 9
crates/main/tests/rail_focus.rs 17
crates/main/tests/rail_look.rs 18
crates/main/tests/rail_shown.rs 2
crates/main/tests/rail_state_tints.rs 3
crates/main/tests/release_notes.rs 5
crates/main/tests/reviewer_setup.rs 15
crates/main/tests/search_look.rs 91
crates/main/tests/slash_aliases.rs 8
crates/main/tests/steer_drawn.rs 11
crates/main/tests/stream_closed_notice.rs 13
crates/main/tests/swapped_panels_look.rs 50
crates/main/tests/terminal.rs 24
crates/main/tests/tui_context_after_cd.rs 0
crates/main/tests/tui_extensions.rs 7
crates/main/tests/tui_key_whole_screen.rs 8
crates/main/tests/tui_timing_tests.rs 2
crates/main/tests/wheel_scroll.rs 10
crates/main/tests/working_line_look.rs 69
crates/main/tests/workspace_picker.rs 1
EOF
    echo "== kinds ratchet"
    cargo xtask kinds-ratchet --max 238 --support-max 36
    echo "== census ratchet"
    # String-typed closed-set sites (ticket #3982): each production file
    # under crates/ holds at most its inline count of the census pattern
    # (`kind: String`, `code: String` / `code: &str`, `.kind.as_str(`-style
    # calls, `.kind == "`-style compares, `["kind"]`-style indexes and
    # `.get("kind")`-style lookups, for kind, code, view and format). A file
    # whose count rises fails; lowering a count is always free, and a file
    # missing from the list holds none. Detection and the per-file
    # comparison live in `cargo xtask census-ratchet`
    # (docs/code-quality.md, "Types").
    cargo xtask census-ratchet <<'EOF'
crates/bench/examples/bench/attach.rs 3
crates/bench/examples/bench/busy.rs 1
crates/bench/examples/bench/debug.rs 1
crates/bench/examples/bench/idle.rs 2
crates/bench/examples/bench/resume.rs 1
crates/bench/examples/bench/run.rs 1
crates/bench/examples/bench/session_list.rs 2
crates/bench/examples/bench/wheel.rs 2
crates/cli/src/doctor/files.rs 2
crates/cli/src/feedback.rs 1
crates/cli/src/hub_pair.rs 2
crates/cli/src/login/browser.rs 1
crates/cli/src/login/reviewer.rs 1
crates/cli/src/sessions.rs 1
crates/contract/src/envelope.rs 2
crates/contract/src/events.rs 1
crates/doors/src/attach.rs 2
crates/doors/src/client/writer.rs 3
crates/doors/src/hub.rs 1
crates/doors/src/isolation.rs 2
crates/doors/src/session.rs 4
crates/extensions/src/attend.rs 2
crates/extensions/src/case/format.rs 1
crates/extensions/src/case/run.rs 5
crates/extensions/src/host.rs 2
crates/extensions/src/host/failure.rs 1
crates/extensions/src/host/script.rs 1
crates/extensions/src/oauth/mod.rs 2
crates/extensions/src/process/context.rs 1
crates/extensions/src/process/context/native/oauth.rs 1
crates/extensions/src/repository/store.rs 1
crates/fakes/src/oauth_server.rs 1
crates/hub/src/attention.rs 1
crates/hub/src/device_login.rs 1
crates/hub/src/fake.rs 1
crates/hub/src/feed.rs 1
crates/hub/src/pairing.rs 1
crates/hub/src/resume.rs 2
crates/hub/src/rewind.rs 2
crates/hub/src/sessions_stop/transport.rs 1
crates/hub/src/spawn.rs 2
crates/hub/src/start.rs 2
crates/jobs/src/error.rs 1
crates/log/src/diag.rs 4
crates/log/src/escalations.rs 2
crates/log/src/escalations/reviewer_shell_calls.rs 2
crates/log/src/name.rs 1
crates/log/src/rate.rs 1
crates/log/src/read.rs 1
crates/log/src/scan.rs 3
crates/log/src/search/session.rs 1
crates/log/src/write.rs 4
crates/loop/src/conversation.rs 2
crates/loop/src/history.rs 7
crates/loop/src/resume.rs 10
crates/loop/src/rewind.rs 5
crates/loop/src/rewind/command.rs 9
crates/loop/src/rewind/stop.rs 1
crates/loop/src/rewind/workspace.rs 1
crates/loop/src/status.rs 3
crates/loop/src/suspend.rs 2
crates/main/src/configure/login.rs 1
crates/main/src/configure/remote.rs 1
crates/main/src/delegates.rs 5
