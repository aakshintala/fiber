crates/mcp/src/login.rs 3
crates/mcp/src/rpc.rs 1
crates/provider/src/error.rs 3
crates/provider/src/hosted.rs 1
crates/provider/src/openai_responses.rs 1
crates/provider/src/scripted.rs 1
crates/tools/src/error.rs 1
crates/tools/src/files.rs 1
crates/tools/src/web_search.rs 2
crates/tui/src/app.rs 11
crates/tui/src/app/attach_fold.rs 4
crates/tui/src/app/call_view.rs 2
crates/tui/src/app/change_workspace.rs 1
crates/tui/src/app/clear.rs 1
crates/tui/src/app/commands_testkit.rs 1
crates/tui/src/app/config_views.rs 1
crates/tui/src/app/config_views/credential.rs 1
crates/tui/src/app/delegates.rs 2
crates/tui/src/app/find/state.rs 1
crates/tui/src/app/form.rs 1
crates/tui/src/app/home.rs 8
crates/tui/src/app/home/open.rs 3
crates/tui/src/app/home/prompt.rs 1
crates/tui/src/app/home/prompt/hooks_offer.rs 2
crates/tui/src/app/home/recent.rs 1
crates/tui/src/app/items.rs 3
crates/tui/src/app/items/output.rs 1
crates/tui/src/app/items/retry.rs 1
crates/tui/src/app/overlay.rs 2
crates/tui/src/app/panel.rs 3
crates/tui/src/app/panel/quota.rs 1
crates/tui/src/app/reviewer_setup.rs 3
crates/tui/src/app/rewind/fold.rs 2
crates/tui/src/app/rewind/send.rs 1
crates/tui/src/app/session_views.rs 1
crates/tui/src/approvals.rs 1
crates/tui/src/configure.rs 1
crates/tui/src/context_view.rs 1
crates/tui/src/event_loop/hub.rs 1
crates/tui/src/ext.rs 1
crates/tui/src/highlight.rs 1
crates/tui/src/history.rs 1
crates/tui/src/jigs.rs 2
crates/tui/src/link.rs 2
crates/tui/src/login_view.rs 1
crates/tui/src/login_worker.rs 2
crates/tui/src/markdown.rs 3
crates/tui/src/notices.rs 8
crates/tui/src/offer.rs 1
crates/tui/src/remote/decode.rs 4
crates/tui/src/remote/login.rs 1
crates/tui/src/remote/router.rs 1
crates/tui/src/turn.rs 3
crates/tui/src/turn/answers.rs 1
crates/tui/src/turn/crash.rs 2
crates/tui/src/turn/handoff.rs 1
crates/tui/src/view/notice_rows.rs 5
crates/tui/src/window.rs 3
crates/tui/src/window/images.rs 1
EOF
    # CI runs this on Linux x86_64 alone (docs/ci.md), where the runner
    # ships shellcheck, so a missing one fails rather than skips.
    if [ "$(uname -s)" = Linux ]; then
      echo "== shellcheck"
      shellcheck --shell=sh scripts/install.sh \
        crates/main/tests/install_fixture/fiber \
        crates/main/tests/install_fixture/bin/uname \
        crates/main/tests/install_fixture/bin/sysctl \
        crates/main/tests/release_pack_fixture/bin/gh
      shellcheck --shell=bash scripts/check scripts/flaky-tests scripts/test-flaky-tests scripts/test-flake-report scripts/leak-scan scripts/test-leak-scan scripts/look-diff scripts/test-look-diff scripts/test-leak-probe scripts/bug-red scripts/test-bug-red scripts/test-bug-red-cargo scripts/cache-prune scripts/check-docs scripts/check-resources scripts/test-check-resources scripts/class-data scripts/test-class-data scripts/install-shells scripts/mutants-rotation scripts/test-mutants-rotation scripts/mutants-shard-finish scripts/test-mutants-shard-finish scripts/paging-jig scripts/release-size scripts/release-pack scripts/stored-results scripts/lib/release.sh
      shellcheck --shell=bash scripts/test-journey-report
    else
      echo "== shellcheck: Linux only (docs/ci.md), not run here"
    fi
    # The notices file the release publishes (docs/dependencies.md, "Supply
    # chain"): the same cargo about generate the release runs, so a licence
    # the root about.toml rejects fails the pull request, not the release.
    # CI's lint job installs cargo-about; a local run without it skips.
    if command -v cargo-about > /dev/null; then
      echo "== cargo-about notices parity"
      notices_parity=$(mktemp)
      cargo about generate --manifest-path crates/main/Cargo.toml about.hbs --output-file "$notices_parity" ||
        { printf 'scripts/check: %s\n' "cargo about generate failed; the release would fail the same way." >&2; exit 1; }
      [ -s "$notices_parity" ] || { printf 'scripts/check: %s\n' "cargo about generate wrote an empty notices file." >&2; exit 1; }
      grep -q "Apache-2.0" "$notices_parity" || { printf 'scripts/check: %s\n' "cargo about generate names no Apache-2.0 licence." >&2; exit 1; }
      rm -f "$notices_parity"
    else
      echo "== cargo-about notices parity: skipped (cargo-about is not installed; CI installs it)"
    fi
  fi
fi

if [ "$scope" != shared ] && [ ${#package_args[@]} -gt 0 ]; then
  echo "== leak-scan self-test"
  scripts/test-leak-scan
  echo "== look-diff self-test"
  scripts/test-look-diff
  echo "== flaky-tests self-test"
  scripts/test-flaky-tests
  echo "== flake-report self-test"
  scripts/test-flake-report
  echo "== journey-report self-test"
  scripts/test-journey-report
  echo "== mutants-rotation self-test"
  scripts/test-mutants-rotation
  echo "== mutants-shard-finish self-test"
  scripts/test-mutants-shard-finish
  echo "== bug-red self-test"
  scripts/test-bug-red
  echo "== class-data self-test"
  scripts/test-class-data
  echo "== check-resources self-test"
  scripts/test-check-resources
  echo "== cargo clippy -q --all-targets -- -D warnings"
  build_step cargo clippy -q --all-targets "${package_spec_args[@]}" -- -D warnings
  # A per-run nonce in the environment: every descendant inherits it, so
  # the EXIT trap's scan names only this run's leaked processes. uuidgen
  # ships on Linux CI and macOS; the fallback needs only bash and date.
  if [ -z "${FIBER_CHECK_RUN-}" ]; then
    if ! FIBER_CHECK_RUN=$(uuidgen 2>/dev/null); then
      FIBER_CHECK_RUN="$$-$(date +%s)-$RANDOM"
    fi
  fi
  export FIBER_CHECK_RUN
  scan_leaks=1
  # nextest builds the fakes library as a dev dependency but not its
  # example; ProcessFixture::example_path starts that example, so build
  # it for every selection, since any crate's tests may use ProcessFixture.
  echo "== build the process-extension example"
  build_step cargo build -q -p fakes --example process-extension
  # One thread per CPU the host has free, from the load when the run
  # starts: a loaded host runs fewer tests at once rather than starving
  # each of them. CI runners keep their own counts.
  threads=
  if [ -n "${GITHUB_ACTIONS-}" ]; then
    echo "== nextest threads: keeping the runner's own count (GITHUB_ACTIONS is set)"
  else
    if [ "$(uname -s)" = Darwin ]; then
      cpus=$(getconf _NPROCESSORS_ONLN)
      load=$(sysctl -n vm.loadavg | tr -d '{}' | awk '{print $1}')
    else
      cpus=$(getconf _NPROCESSORS_ONLN)
      load=$(awk '{print $1}' /proc/loadavg)
    fi
    threads=$(cargo xtask threads "$cpus" "$load")
    echo "== nextest threads: $threads ($cpus cpus, load $load)"
  fi
  echo "== cargo nextest run"
  # One timing flake must not hide the other tests' results: a failed run
  # reports every failure, so a rerun is not needed to see them.
  if [ -n "$threads" ]; then
    if cargo nextest run --no-fail-fast --status-level fail --final-status-level flaky --cargo-quiet --test-threads "$threads" "${package_spec_args[@]}" 2>&1 | tee "$log"; then :; else step_rc=$?; step_failed "$step_rc"; fi
  else
    if cargo nextest run --no-fail-fast --status-level fail --final-status-level flaky --cargo-quiet "${package_spec_args[@]}" 2>&1 | tee "$log"; then :; else step_rc=$?; step_failed "$step_rc"; fi
  fi
  nextest=$(count '[0-9]+ tests? run')
  case " $packages " in
    *" main "*)
      echo "== leak probe"
      scripts/test-leak-probe
      ;;
  esac
  if [ -n "$extension_packages" ]; then
    # The binary builds once here, wrapped so a killed link fails 75; the
    # loop below only runs it.
    echo "== fiber extension build"
    build_step cargo build -q -p main --bin fiber
    echo "== fiber extension test"
    # cargo run builds the binary and runs it from Cargo's own target
    # directory, so no path is read back from cargo metadata.
    for package in $extension_packages; do
      echo "== fiber extension test $package"
      cargo run -q -p main --bin fiber -- extension test "$package"
    done
  fi
  # A crate with no library has no doc-tests, and cargo refuses to look.
  doctests=0
  if [ -n "$library_specs" ]; then
    library_spec_args=()
    for p in $library_specs; do library_spec_args+=(-p "$p"); done
    echo "== cargo test --doc"
    # The full output goes to the log; the console keeps only the summary,
    # so a passing run stays short. A failure prints everything, since the
    # failing test's name and output are what the failure needs.
    if cargo test --doc "${library_spec_args[@]}" >"$log" 2>&1; then :; else step_rc=$?; cat "$log"; step_failed "$step_rc"; fi
    grep "test result" "$log" || true
    doctests=$(count '[0-9]+ passed')
  fi
  echo "tests run: $nextest under nextest, $doctests doc-tests"
fi
