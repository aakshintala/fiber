#!/usr/bin/env bash
# PROBE (see #2360; dropped before merge): builds the tui crate's paging
# jig (docs/testing.md, "Jigs") in the release profile for the target that
# ships, x86_64-unknown-linux-musl, AND for x86_64-unknown-linux-gnu, so the
# release job can report the scale-16 re-count growth on both and tell a
# musl-allocator effect apart from the head's own cost. The remarks below
# describe the musl paths the benchmark job uses; the gnu paths are the
# probe's and go away with it.
#
# Usage: scripts/paging-jig
# When scripts/release-size left $RUNNER_TEMP/release/base/commit (a pull
# request whose base comparison is not skipped), the base jig is also built
# at that commit, the base or the ancestor standing in for it, in a git
# worktree reusing this checkout's target directory. A base with no jig, or
# whose jig does not build, has none: the script says so, exits 0, and the
# base's paging timings are reported unavailable. Only a failed head build
# fails the script.
#
# Outputs: $RUNNER_TEMP/release/head/paging, and $RUNNER_TEMP/release/base/paging
# when the base has a jig that builds. Runs on Linux. PROBE: also
# $RUNNER_TEMP/release/head/paging-gnu and $RUNNER_TEMP/release/base/paging-gnu
# (dropped before merge).
set -euo pipefail
shopt -s inherit_errexit 2> /dev/null || true # bash 4.4; macOS ships 3.2
# Shared release mechanics, sibling to this script: the checkout this
# operates on (a fixture in tests) holds no scripts/ of its own, and the
# base worktree never provides them.
# shellcheck source=scripts/lib/release.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/release.sh"
cd "$(git rev-parse --show-toplevel)"

readonly source=crates/tui/examples/paging.rs
# PROBE (see #2360; dropped before merge): the second target the probe builds.
readonly gnu=x86_64-unknown-linux-gnu
out="${RUNNER_TEMP:?}/release"
base_commit=
if [ -f "$out/base/commit" ]; then
  base_commit=$(cat "$out/base/commit")
fi
top=$PWD

# Builds the jig of the checkout in the current directory into the shared
# target directory and copies it to $1. Each step is chained, so a failed
# build fails the function even where errexit does not apply, and never
# copies a jig an earlier build left in target/.
build_paging() {
  build -p tui --example paging &&
    mkdir -p "${1%/*}" &&
    cp "$top/target/$target/release/examples/paging" "$1"
}

# Builds the jig of the checkout in the current directory for $1 (a target
# triple) into the shared target directory and copies it to $2. Each step is
# chained, so a failed build fails the function even where errexit does not
# apply, and never copies a jig an earlier build left in target/. The
# release-size test's stub cargo ignores --target and always writes the musl
# path, so a missing triple path falls back to it there; a real build always
# takes the triple path. PROBE (see #2360; dropped before merge).
build_paging_target() {
  CARGO_TARGET_DIR="$top/target" cargo build --release --locked --target "$1" -p tui --example paging &&
    mkdir -p "${2%/*}" &&
    if [ -f "$top/target/$1/release/examples/paging" ]; then
      cp "$top/target/$1/release/examples/paging" "$2"
    else
      cp "$top/target/$target/release/examples/paging" "$2"
    fi
}

# The head is copied out of target/ before any base build overwrites it.
# PROBE (see #2360; dropped before merge): the gnu jig alongside the musl one.
build_paging "$out/head/paging"
build_paging_target "$gnu" "$out/head/paging-gnu"
echo "paging-jig: head $(git rev-parse --short HEAD) musl and gnu jigs built"

if [ -n "$base_commit" ]; then
  base_sha=$(git rev-parse --short "$base_commit")
  if ! git cat-file -e "$base_commit:$source" 2>/dev/null; then
    echo "paging-jig: the base $base_sha has no paging jig; its paging timings are unavailable"
    exit 0
  fi
  worktree="$RUNNER_TEMP/paging-base"
  trap 'git -C "$top" worktree remove --force "$worktree"' EXIT
  base_worktree "$base_commit" "$worktree"
  # The base may pin another toolchain; each command reads its
  # rust-toolchain.toml. PROBE (see #2360; dropped before merge): both targets.
  if (cd "$worktree" && rustup toolchain install && rustup target add "$target" && rustup target add "$gnu" &&
    build_paging "$out/base/paging" && build_paging_target "$gnu" "$out/base/paging-gnu"); then
    echo "paging-jig: base $base_sha musl and gnu jigs built"
  else
    rm -f "$out/base/paging" "$out/base/paging-gnu"
    echo "paging-jig: the base $base_sha jig did not build; its paging timings are unavailable"
  fi
fi
