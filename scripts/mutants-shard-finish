#!/usr/bin/env bash
# The finished-shard mapping for the scheduled mutants workflow: a shard
# that finishes with only missed mutants (cargo-mutants exit 2) is green,
# with each missed mutant's file:line in the step summary. Any other
# status exits as cargo-mutants did. Usage:
# scripts/mutants-shard-finish <status> <captured-stdout-file>.
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "scripts/mutants-shard-finish: want <status> <captured-stdout-file>" >&2
  exit 2
fi
status=$1
log=$2
case $status in
  '' | *[!0-9]*) echo "scripts/mutants-shard-finish: status '$status' is not a non-negative integer" >&2; exit 2 ;;
esac

if [ "$status" -eq 2 ]; then
  # Survivors alone still pass; the summary names each missed mutant's
  # file and line. A MISSED line reads
  # `MISSED <path>:<line>:<col>: <description>`, so the file:line is the
  # text before the line's third colon. Outside Actions there is no
  # summary file, so the list goes to stdout instead.
  summary=${GITHUB_STEP_SUMMARY:-/dev/stdout}
  grep '^MISSED ' "$log" 2>/dev/null | sed 's/^MISSED //; s/^\([^:]*:[^:]*\):.*/\1/' >>"$summary" || true
  exit 0
fi
exit "$status"
