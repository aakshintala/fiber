#!/usr/bin/env bash
# Installs zsh and fish on a Linux CI runner (docs/ci.md, "Job time limits").
# With a cached archive directory holding .deb files, it installs them with
# dpkg and makes no network call; a failure there fails the script, with no
# network fallback. Otherwise the network part, `apt-get update` and
# `apt-get install --download-only`, runs under a 90-second bound per attempt
# and is retried after 5 seconds until it succeeds (apt keeps partial archives,
# so each attempt resumes), leaving the step's timeout as the outer bound. The
# downloaded archives are copied into the directory for the workflow to cache.
# The install has no bound, because killing dpkg mid-unpack leaves the dpkg
# lock held and a package half configured.
#
# Usage: scripts/install-shells [DIR]
# DIR is the archive cache directory. With no DIR, no archives are kept.
# APT_OPTS holds apt-get's options; it is split on whitespace on purpose.
set -euo pipefail

apt_opts="${APT_OPTS:-}"
archives=/var/cache/apt/archives
dir="${1:-}"

if [ -n "$dir" ] && compgen -G "$dir/*.deb" >/dev/null; then
  echo "install-shells: installing cached archives from $dir"
  sudo dpkg -i "$dir"/*.deb
  exit 0
fi

download() {
  # shellcheck disable=SC2016 # $1 expands in the inner shell
  sudo timeout 90 sh -c \
    'apt-get $1 update && apt-get $1 install --download-only -y zsh fish' \
    sh "$apt_opts"
}

attempt=1
until download; do
  echo "install-shells: download attempt $attempt failed or passed 90 s; retrying in 5 s" >&2
  attempt=$((attempt + 1))
  sleep 5
done

if [ -n "$dir" ] && compgen -G "$archives/*.deb" >/dev/null; then
  mkdir -p "$dir"
  cp "$archives"/*.deb "$dir"/
fi

# shellcheck disable=SC2086 # apt_opts is a list of options
sudo apt-get $apt_opts install -y zsh fish
