#!/bin/bash
# Self-test for the `scripts/check --rules-by-path` branch (`docs/workflow.md`,
# "Rules by path"; issue #4861): usage conflicts, closed invalid base, seven-name coupling against the doc,
# and crate-list narrowing through the built xtask.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
top=$PWD

fail() { echo "test-check-rules-by-path: $1" >&2; exit 1; }

work=$(mktemp -d)
trap 'git worktree remove --force "${proto_wt-}" 2>/dev/null || true; rm -rf "$work" "${proto_parent-}"' EXIT

# A flag conflict prints usage and exits 2, like any unknown flag.
code=0
scripts/check --rules-by-path --platform-only >"$work/usage" 2>&1 || code=$?
[ "$code" -eq 2 ] || fail "--rules-by-path --platform-only exited $code, not 2"
grep -q -- "--rules-by-path" "$work/usage" || fail "usage text names no --rules-by-path"
code=0
scripts/check --rules-by-path --shared-only >"$work/conflict" 2>&1 || code=$?
[ "$code" -eq 2 ] || fail "--rules-by-path --shared-only exited $code, not 2"

# An unknown flag still exits 2.
code=0
scripts/check --bogus >"$work/bogus" 2>&1 || code=$?
[ "$code" -eq 2 ] || fail "--bogus exited $code, not 2"

# An invalid base fails closed: non-zero exit, no PASS line.
code=0
scripts/check --rules-by-path --base nonexistent-base >"$work/closed" 2>&1 || code=$?
[ "$code" -ne 0 ] || fail "invalid base passed"
grep -q "scripts/check: PASS" "$work/closed" && fail "invalid base printed PASS"

# The seven xtask names in the rules branch equal the doc list.
expected="$work/expected"
printf '%s\n' compiled-in crate-edges dependency-list image-isolation must-succeed signal-sites tui-isolation >"$expected"
sed -n '/# rules-by-path: start/,/# rules-by-path: end/p' scripts/check \
  | grep -vE '^[[:space:]]*#' | grep -oE 'cargo xtask [a-z-]+' | awk '{print $3}' | grep -v '^select$' | sort -u >"$work/branch"
diff "$expected" "$work/branch" || fail "branch xtask names differ from the doc list"
while IFS= read -r name; do
  grep -q "cargo xtask $name" docs/workflow.md || fail "docs/workflow.md names no cargo xtask $name"
done <"$expected"

# The prototype trigger matches a prototype-only changed list with a single
# slash: `prototype` carries no trailing slash, so the grep tests for
# `^research/tui-prototype/`, never `^research/tui-prototype//`
# (`docs/workflow.md`, "Rules by path").
pattern=$(sed -n 's/^  prototype=//p' scripts/check | head -1)
[ -n "$pattern" ] || fail "no prototype= line in scripts/check"
case "$pattern" in
*/ ) fail "prototype '$pattern' carries a trailing slash" ;;
esac
printf '%s\n' "research/tui-prototype/src/main.rs" >"$work/changed"
grep -q "^$pattern/" "$work/changed" || fail "a prototype-only diff trips no trigger"
printf '%s\n' "crates/log/src/lib.rs" >"$work/unchanged"
grep -q "^$pattern/" "$work/unchanged" && fail "a non-prototype file trips the prototype trigger"

# A narrowed smoke run through the built xtask carries no dependent crate.
cargo build -q -p xtask
fixture="$work/fixture"
mkdir -p "$fixture/crates/a/src" "$fixture/crates/b/src"
cat >"$fixture/Cargo.toml" <<'EOF'
[workspace]
members = ["crates/a", "crates/b"]
resolver = "3"
EOF
cat >"$fixture/crates/a/Cargo.toml" <<'EOF'
[package]
name = "a"
version = "0.0.0"
edition = "2021"
EOF
cat >"$fixture/crates/b/Cargo.toml" <<'EOF'
[package]
name = "b"
version = "0.0.0"
edition = "2021"

[dependencies]
a = { path = "../a" }
EOF
echo '//! a' >"$fixture/crates/a/src/lib.rs"
echo '//! b' >"$fixture/crates/b/src/lib.rs"
git -C "$fixture" init -q -b main
git -C "$fixture" -c user.email=t@t -c user.name=t add .
git -C "$fixture" -c user.email=t@t -c user.name=t commit -qm base
echo '//! a, changed' >"$fixture/crates/a/src/lib.rs"
narrowed=$(git -C "$fixture" rev-parse HEAD >/dev/null && (cd "$fixture" && "$top/target/debug/xtask" select --base HEAD --rules-by-path))
packages=$(sed -n 's/^packages=//p' <<<"$narrowed")
[ "$packages" = "a" ] || fail "narrowed packages are '$packages', not 'a'"
mkdir -p "$fixture/scripts"
echo true >"$fixture/scripts/noop"
narrowed=$(cd "$fixture" && "$top/target/debug/xtask" select --base HEAD --rules-by-path)
packages=$(sed -n 's/^packages=//p' <<<"$narrowed")
[ "$packages" = "a" ] || fail "a scripts file changed the narrowed packages to '$packages'"

# A prototype-only diff through scripts/check prints the prototype step
# (`docs/workflow.md`, "Rules by path"): a scratch worktree at HEAD plus one
# untracked prototype file is a prototype-only diff against HEAD. cargo is
# stubbed except for `xtask select`, so the prototype trio and check-docs
# succeed without building; the `== tui-prototype` line comes from the rules
# branch itself, so a deleted branch or a changed `changed` computation fails
# this test.
proto_parent=$(mktemp -d)
proto_wt="$proto_parent/wt"
git worktree add -q --detach "$proto_wt" HEAD
touch "$proto_wt/research/tui-prototype/.rules-selftest-probe"
mkdir -p "$work/bin"
real_cargo=$(command -v cargo)
cat >"$work/bin/cargo" <<STUB
#!/bin/bash
if [[ " \$* " == *" xtask select "* || " \$* " == *" metadata "* ]]; then
  exec "$real_cargo" "\$@"
fi
exit 0
STUB
chmod +x "$work/bin/cargo"
code=0
(cd "$proto_wt" && PATH="$work/bin:$PATH" CARGO_TARGET_DIR="$top/target" bash "$top/scripts/check" --rules-by-path --base HEAD >"$work/proto" 2>&1) || code=$?
[ "$code" -eq 0 ] || { cat "$work/proto" >&2; fail "prototype-only scripts/check exited $code, not 0"; }
grep -q "== tui-prototype" "$work/proto" || { cat "$work/proto" >&2; fail "prototype-only diff printed no '== tui-prototype'"; }

echo "test-check-rules-by-path: ok"
