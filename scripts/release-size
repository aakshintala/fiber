#!/usr/bin/env bash
# Builds the release profile for the target that ships,
# x86_64-unknown-linux-musl, strips it, prints its size, and fails when the
# stripped head binary is 20 MiB or more (docs/ci.md, "On every pull request
# that changes code"; docs/dependencies.md). The checkout's HEAD is the head.
#
# Usage: scripts/release-size [BASE_COMMIT]
# With a base commit (a pull request), the base binary is also stripped and
# its size printed beside the head's; the base size never fails the script.
# BASE_CACHED=true means the workflow restored the base binary and its
# checksum into $RUNNER_TEMP/release/cache; anything else builds the base in
# a git worktree, reusing this checkout's target directory. A base that does
# not build does not fail the script: BASE_MATCHED_KEY, the cache key the
# workflow restored under (release-musl-<sha>, empty when none matched), then
# names the nearest first-parent ancestor of the base with a stored binary,
# which stands in as the base. With none, the base comparison is skipped.
# Either way the line "base <sha> does not build" goes to stdout and to
# $GITHUB_STEP_SUMMARY, and only a failed head build or a head over the
# limit fails the script. Without a base commit (a push), the head binary and
# its checksum are also written to $RUNNER_TEMP/release/cache for the
# workflow to store under the commit.
#
# Outputs: $RUNNER_TEMP/release/head/fiber, and $RUNNER_TEMP/release/base/fiber
# with a base commit whose comparison is not skipped; both stripped and
# executable. base/commit then holds the full hash of the commit the base
# binary is from: the base, or the ancestor that stands in for it. Runs on Linux (sha256sum, strip).
set -euo pipefail
shopt -s inherit_errexit 2> /dev/null || true # bash 4.4; macOS ships 3.2
cd "$(git rev-parse --show-toplevel)"

readonly target=x86_64-unknown-linux-musl
readonly limit=20971520 # 20 * 1024 * 1024
base_commit=${1:-}
out="${RUNNER_TEMP:?}/release"
top=$PWD

# Builds the checkout in the current directory into the shared target
# directory and writes the stripped binary to $1. Each step is chained, so a
# failed build fails the function even where errexit does not apply.
build() {
  CARGO_TARGET_DIR="$top/target" cargo build --release --locked --target "$target" --bin fiber &&
    mkdir -p "${1%/*}" &&
    strip -o "$1" "$top/target/$target/release/fiber"
}

# Prints $* and adds it to the job summary.
note() {
  echo "release-size: $*"
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    echo "$*" >> "$GITHUB_STEP_SUMMARY"
  fi
}

# Copies the stored binary in $out/cache to $out/base/fiber after checking its
# checksum.
use_stored() {
  if [ ! -f "$out/cache/fiber" ] || [ ! -f "$out/cache/fiber.sha256" ] ||
    ! (cd "$out/cache" && sha256sum --check --strict fiber.sha256); then
    echo "release-size: the stored base binary for $1 is missing or fails its checksum"
    exit 1
  fi
  cp "$out/cache/fiber" "$out/base/fiber"
}

# Prints "<bytes> <MiB to 2 decimals>" for the file $1.
size() {
  local bytes mib
  bytes=$(wc -c < "$1" | tr -d ' ')
  mib=$(awk -v b="$bytes" 'BEGIN { printf "%.2f", b / 1048576 }')
  echo "$bytes $mib"
}

head_sha=$(git rev-parse --short HEAD)
# The head is stripped out of target/ before any base build overwrites it.
build "$out/head/fiber"
head_size=$(size "$out/head/fiber")
read -r head_bytes head_mib <<<"$head_size"
echo "release-size: head $head_sha fiber is $head_bytes bytes ($head_mib MiB); the limit is $limit bytes"

if [ -z "$base_commit" ]; then
  mkdir -p "$out/cache"
  cp "$out/head/fiber" "$out/cache/fiber"
  (cd "$out/cache" && sha256sum fiber > fiber.sha256)
else
  base_sha=$(git rev-parse --short "$base_commit")
  mkdir -p "$out/base"
  compare=true
  compared=$(git rev-parse "$base_commit")
  if [ "${BASE_CACHED:-}" = true ]; then
    how=stored
    use_stored "$base_commit"
  else
    how=built
    worktree="$RUNNER_TEMP/release-base"
    trap 'git -C "$top" worktree remove --force "$worktree" 2> /dev/null || true' EXIT
    # The base may pin another toolchain; each command reads its
    # rust-toolchain.toml.
    if ! { git worktree add --detach "$worktree" "$base_commit" &&
      (
        cd "$worktree" &&
          rustup toolchain install &&
          rustup target add "$target" &&
          build "$out/base/fiber"
      ); }; then
      rm -f "$out/base/fiber"
      ancestor=${BASE_MATCHED_KEY:-}
      ancestor=${ancestor#release-musl-}
      if [ -n "$ancestor" ]; then
        how=stored
        use_stored "$ancestor"
        compared=$ancestor
        note "The base $base_sha does not build. Its size is compared against the nearest first-parent ancestor with a stored binary, $(git rev-parse --short "$ancestor")."
      else
        compare=false
        note "The base $base_sha does not build and no first-parent ancestor has a stored binary. The base comparison and the timing gates are skipped; the head's size check and benchmarks still gate."
      fi
    fi
  fi
  if [ "$compare" = true ]; then
    # The commit the base binary is from, for the jig's base (scripts/paging-jig).
    echo "$compared" > "$out/base/commit"
    base_size=$(size "$out/base/fiber")
    read -r base_bytes base_mib <<<"$base_size"
    echo "release-size: base $(git rev-parse --short "$compared") fiber is $base_bytes bytes ($base_mib MiB), $how"
    delta=$((head_bytes - base_bytes))
    if [ "$delta" -ge 0 ]; then
      delta="+$delta"
    fi
    echo "release-size: head - base = $delta bytes"
  fi
fi

if [ "$head_bytes" -ge "$limit" ]; then
  echo "release-size: the stripped head binary is $head_bytes bytes, at or over the 20 MiB limit (docs/dependencies.md)"
  exit 1
fi
