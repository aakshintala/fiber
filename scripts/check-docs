#!/usr/bin/env python3
"""The docs check (docs/ci.md, "The docs check").

Checks docs/, CONTEXT.md, AGENTS.md and README.md, offline, for relative
Markdown links and anchors that do not resolve, section citations naming a
heading the file does not have, and backticked repository paths that do not
exist. Run from the repository root.
"""

import re
import sys
from pathlib import Path

CHECKED = ["CONTEXT.md", "AGENTS.md", "README.md"]
LINK = re.compile(r"\[[^\]]*\]\(([^)\s]+)(?:\s+\"[^\"]*\")?\)")
CITATION = re.compile(r"`([^`\s]+\.md)`,\s+\"([^\"]+)\"")
PATH = re.compile(r"`((?:docs|crates|scripts|research|\.github)/[^`]*)`")
PLACEHOLDER = re.compile(r"[<>*{}\s]")
HEADING = re.compile(r"(#{1,6})\s+(.*?)\s*#*\s*$")
FENCE = re.compile(r"^\s*(```|~~~)")


def prose(markdown):
    """`markdown` with fenced code blocks blanked, line numbers kept."""
    out, fenced = [], False
    for line in markdown.split("\n"):
        if FENCE.match(line):
            fenced = not fenced
            out.append("")
        else:
            out.append("" if fenced else line)
    return "\n".join(out)


def headings(markdown):
    return [m.group(2) for line in prose(markdown).split("\n") if (m := HEADING.match(line))]


def slug(heading):
    """GitHub's anchor for a heading."""
    text = re.sub(r"[^\w\- ]", "", heading.lower())
    return text.replace(" ", "-")


def anchors(markdown):
    seen, result = {}, set()
    for heading in headings(markdown):
        base = slug(heading)
        count = seen.get(base, 0)
        seen[base] = count + 1
        result.add(base if count == 0 else f"{base}-{count}")
    return result


def line_of(text, offset):
    return text.count("\n", 0, offset) + 1


def check_file(path, root):
    """Failures in the Markdown file at `path`, relative to `root`."""
    source = (root / path).read_text()
    text = prose(source)
    failures = []

    def fail(offset, message):
        failures.append(f"{path}:{line_of(text, offset)}: {message}")

    for match in LINK.finditer(text):
        target = match.group(1)
        if re.match(r"[a-z][a-z0-9+.-]*:", target):
            continue
        file_part, _, anchor = target.partition("#")
        resolved = (root / path).parent / file_part if file_part else root / path
        if not resolved.exists():
            fail(match.start(), f"link to {target}: no such file")
        elif anchor and resolved.suffix == ".md" and anchor not in anchors(resolved.read_text()):
            fail(match.start(), f"link to {target}: no such anchor")

    for match in CITATION.finditer(text):
        cited, heading = match.group(1), " ".join(match.group(2).split())
        candidates = [root / cited, (root / path).parent / cited]
        target = next((c for c in candidates if c.is_file()), None)
        if target is None:
            fail(match.start(), f"citation of {cited}: no such file")
        elif heading not in headings(target.read_text()):
            fail(match.start(), f'citation of {cited}, "{heading}": no such heading')

    for match in PATH.finditer(text):
        cited = match.group(1)
        if PLACEHOLDER.search(cited):
            continue
        if not (root / cited).exists():
            fail(match.start(), f"path {cited}: does not exist")

    return failures


def checked_files(root):
    files = sorted(p.relative_to(root).as_posix() for p in (root / "docs").rglob("*.md"))
    return files + [f for f in CHECKED if (root / f).exists()]


def main():
    root = Path.cwd()
    failures = [f for path in checked_files(root) for f in check_file(path, root)]
    for line in failures:
        print(line)
    if failures:
        print(f"check-docs: {len(failures)} problems")
        return 1
    print("check-docs: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
