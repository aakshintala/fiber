#!/usr/bin/env bash
# Reports this check run's leaked processes (docs/testing.md, "Running
# tests"). It only reports: it sends no signal.
#
# Usage: scripts/leak-scan NONCE [CHECK_START]
#
# CHECK_START is the epoch seconds when scripts/check began, or
# FIBER_CHECK_START when no second argument is given. Without either the
# macOS orphan scan below is skipped.
#
# Every descendant of scripts/check inherits FIBER_CHECK_RUN, so a process
# whose environment still holds FIBER_CHECK_RUN=NONCE started under this run
# and outlived the tests. A sibling run carries another nonce and never
# matches.
set -euo pipefail

nonce=${1-}
# An empty match would name every process the scan sees, so refuse it.
if [ -z "$nonce" ]; then
  echo "scripts/leak-scan: refusing an empty NONCE: it matches every process" >&2
  exit 2
fi

orphan_start=${2-${FIBER_CHECK_START-}}

# How long a normally exiting process gets before the scan lists.
sleep "${LEAK_SCAN_GRACE:-2}"

self=$$
# Helpers run with FIBER_CHECK_RUN unset so the listing never names them,
# and matching stays in this shell, so no child carries the nonce. -e lists
# every process: without it ps shows only the caller's terminal session,
# and the ancestor walk below would stop before scripts/check.
map=$(env -u FIBER_CHECK_RUN ps -e -o pid=,ppid=)

# The scan's own process, its ancestors (scripts/check itself carries the
# variable), and its own descendants: none is a leak.
ancestors=" $self "
lineage=$self
while true; do
  parent=
  while read -r pid ppid _rest; do
    if [ "$pid" = "$lineage" ]; then
      parent=$ppid
      break
    fi
  done <<<"$map"
  case $parent in '' | *[!0-9]* | 0 | 1) break ;; esac
  case $ancestors in *" $parent "*) break ;; esac
  ancestors="$ancestors$parent "
  lineage=$parent
done
members=" $self "
grew=1
while [ "$grew" -eq 1 ]; do
  grew=0
  while read -r pid ppid _rest; do
    case $pid in '' | *[!0-9]*) continue ;; esac
    case $ppid in '' | *[!0-9]*) continue ;; esac
    case $members in *" $pid "*) continue ;; esac
    case $members in *" $ppid "*) members="$members$pid " && grew=1 ;; esac
  done <<<"$map"
done
excluded=$ancestors$members

# Whether $1 holds the exact token $2, whitespace-delimited: pad both
# sides with a space so the token must start/end at a boundary. The
# token stays quoted, so it matches literally (no glob expansion).
# Callers pass FIBER_CHECK_RUN=$nonce as the token, so a value like
# UNRELATED_TOKEN=$nonce never matches.
holds_token() {
  [[ " $1 " == *" $2 "* ]]
}

leaks=0
if [ "$(uname -s)" = Darwin ]; then
  table=$(env -u FIBER_CHECK_RUN ps -E -ww -o pid=,command= -U "$USER")
  while IFS= read -r line; do
    if IFS=' ' read -r pid rest <<<"$line"; then
      :
    else
      continue
    fi
    case $pid in '' | *[!0-9]*) continue ;; esac
    case $excluded in *" $pid "*) continue ;; esac
    if holds_token "$line" "FIBER_CHECK_RUN=$nonce"; then
      # The -E row is matched internally only: the report refetches the
      # command without -E, so no environment value reaches the log.
      if cmd=$(env -u FIBER_CHECK_RUN ps -ww -o command= -p "$pid" 2>/dev/null); then
        :
      else
        continue
      fi
      cmd=${cmd#"${cmd%%[![:space:]]*}"}
      if [ -z "$cmd" ]; then
        cmd="(no command line)"
      fi
      echo "leaked process $pid: $cmd" >&2
      leaks=$((leaks + 1))
    fi
  done <<<"$table"
else
  for envfile in /proc/[0-9]*/environ; do
    pid=${envfile#/proc/}
    pid=${pid%/environ}
    case $pid in '' | *[!0-9]*) continue ;; esac
    case $excluded in *" $pid "*) continue ;; esac
    # One exact line FIBER_CHECK_RUN=NONCE among the NUL-separated entries;
    # an unreadable file belongs to a process that already exited.
    # No -q: grep consumes the whole stream, so tr never dies of SIGPIPE
    # under pipefail when the match comes early; matches go to /dev/null.
    if env -u FIBER_CHECK_RUN tr '\0' '\n' <"$envfile" 2>/dev/null | env -u FIBER_CHECK_RUN grep -Fx "FIBER_CHECK_RUN=$nonce" >/dev/null; then
      if cmd=$(env -u FIBER_CHECK_RUN tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null); then
        if [ -z "$cmd" ]; then
          if cmd=$(env -u FIBER_CHECK_RUN ps -o command= -p "$pid" 2>/dev/null); then
            :
          else
            continue
          fi
        fi
      else
        continue
      fi
      cmd=${cmd% }
      cmd=${cmd#"${cmd%%[![:space:]]*}"}
      if [ -z "$cmd" ]; then
        cmd="(no command line)"
      fi
      echo "leaked process $pid: $cmd" >&2
      leaks=$((leaks + 1))
    fi
  done
fi

case $orphan_start in '' | *[!0-9]*) orphan_start= ;; esac
if [ "$(uname -s)" = Darwin ] && [ -n "$orphan_start" ]; then
  scan_root=${LEAK_SCAN_ROOT:-$(git rev-parse --show-toplevel)}
  target_prefix="$scan_root/target/"
  # Owned by the user, reparented to init, started after the check
  # began: on macOS ps withholds the environment of sh and sleep, so the
  # nonce scan above cannot see them. A path under this worktree's target/
  # is this run's leak and fails the scan; sh, bash or sleep may belong to
  # another run, so they warn only. Anything else is ignored. The single
  # -gt holds all three boundaries: at the start is ignored, a second
  # before is ignored, a second after is listed.
  orphans=$(env -u FIBER_CHECK_RUN ps -U "${USER:-$(id -un)}" -o pid=,ppid=,lstart=,command=)
  while IFS= read -r line; do
    IFS=' ' read -r pid ppid dow mon day ctime cyear cmd <<<"$line"
    case $pid in '' | *[!0-9]*) continue ;; esac
    case $ppid in 1) ;; *) continue ;; esac
    case $excluded in *" $pid "*) continue ;; esac
    if [ -z "${dow-}" ] || [ -z "${mon-}" ] || [ -z "${day-}" ] || [ -z "${ctime-}" ] || [ -z "${cyear-}" ]; then
      continue
    fi
    lstart="$dow $mon $day $ctime $cyear"
    if ! started=$(env -u FIBER_CHECK_RUN date -j -f "%a %b %e %T %Y" "$lstart" "+%s" 2>/dev/null); then
      continue
    fi
    case $started in '' | *[!0-9]*) continue ;; esac
    if [ "$started" -gt "$orphan_start" ]; then
      :
    else
      continue
    fi
    # Only the executable (argv0, the first word) names this run's leak:
    # a shell carrying a target/ path in its arguments may belong to
    # another run, so it falls through to the sh/bash/sleep warning.
    word=${cmd-}
    word=${word%% *}
    case $word in
    "$target_prefix"*)
      echo "leaked process $pid: $cmd" >&2
      leaks=$((leaks + 1))
      continue
      ;;
    esac
    case $word in '' ) continue ;; esac
    base=${word##*/}
    case $base in sh | bash | sleep)
      echo "warning: orphan process $pid: $cmd (started $lstart; may belong to another run)" >&2
      ;;
    esac
  done <<<"$orphans"
fi

if [ "$leaks" -eq 0 ]; then
  exit 0
fi
echo "scripts/leak-scan: found $leaks leaked process(es)" >&2
exit 1
