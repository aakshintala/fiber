#!/usr/bin/env bash
# Lists every merge to main in the last 48 hours whose pull request head had no
# green `CI` check, and fails on one whose body does not start with
# `Break-glass:` (docs/ci.md, "The break-glass audit"). Any unreadable or
# malformed API result fails the run, so a green run always means every merge
# in the window was read.
#
# Env: GITHUB_REPOSITORY (default aakshintala/fiber), GH_TOKEN for gh, NOW
# (epoch seconds, default the current time; the self-test sets it).
set -euo pipefail

if [ $# -ne 0 ]; then
  echo "usage: scripts/break-glass-audit (no arguments)" >&2
  exit 2
fi

repo=${GITHUB_REPOSITORY:-aakshintala/fiber}
window=172800
now=${NOW:-$(date +%s)}

die() {
  if [ -n "${GITHUB_ACTIONS-}" ]; then
    echo "::error::$1" >&2
  else
    echo "error: $1" >&2
  fi
  exit 1
}

command -v gh >/dev/null || die "gh is not on PATH"
command -v jq >/dev/null || die "jq is not on PATH"

# api_paginated PATH: one JSON array of every page. gh prints one array per
# page; jq -s joins them and rejects a page that is not an array.
api_paginated() {
  local out
  out=$(gh api --paginate "$1" 2>&1) || die "gh api --paginate $1 failed: $out"
  printf '%s' "$out" | jq -s -c \
    'if length > 0 and all(.[]; type == "array") then add // [] else error("not a list of arrays") end' ||
    die "gh api --paginate $1 returned something other than a JSON array"
}

# api PATH: the response body, or exit 1 on a gh failure.
api() {
  local out
  out=$(gh api "$1" 2>&1) || die "gh api $1 failed: $out"
  printf '%s' "$out"
}

since=$(jq -n -r --argjson now "$now" --argjson w "$window" \
  '($now - $w) | strftime("%Y-%m-%dT%H:%M:%SZ")') || die "cannot compute the window start"

commits=$(api_paginated "repos/$repo/commits?sha=main&since=$since&per_page=100")
shas=$(printf '%s' "$commits" | jq -r \
  'if all(.[]; type == "object" and (.sha | type) == "string") then .[].sha else error("commit without a sha") end') ||
  die "the commits list has an entry without a sha"

audited=0
nogreen=0
undeclared=0

while IFS= read -r sha; do
  [ -n "$sha" ] || continue
  audited=$((audited + 1))

  pulls=$(api "repos/$repo/commits/$sha/pulls")
  # One tab-separated line: PR number, head sha, declared flag, ticket; or the
  # word none when no merged PR on main carries the commit. The body is data
  # for jq and never reaches a shell.
  found=$(printf '%s' "$pulls" | jq -r '
    def declared: (.body // "") | startswith("Break-glass:");
    def ticket: ((if declared then (.body | ltrimstr("Break-glass:")) else (.body // "") end)
      | [scan("#[0-9]+")] | .[0]) // "-";
    if type != "array" then error("pulls is not an array")
    elif all(.[]; type == "object" and has("body") and ((.body | type) | . == "null" or . == "string")
        and (.number | type) == "number" and (.head.sha | type) == "string"
        and (.base.ref | type) == "string" and ((.merged_at | type) | . == "null" or . == "string"))
    then ([.[] | select(.merged_at != null and .base.ref == "main")] | .[0]
      | if . == null then "none"
        else [(.number | tostring), .head.sha, (declared | tostring), ticket] | join("\t") end)
    else error("malformed pull request entry") end') ||
    die "the pull requests for $sha are malformed"

  if [ "$found" = none ]; then
    nogreen=$((nogreen + 1))
    undeclared=$((undeclared + 1))
    line="merge $sha head none PR none ticket - undeclared"
    echo "$line"
    [ -z "${GITHUB_ACTIONS-}" ] || echo "::error::$line"
    continue
  fi

  IFS=$'\t' read -r number head is_declared ticket <<<"$found"

  checks=$(api "repos/$repo/commits/$head/check-runs?check_name=CI&filter=latest&per_page=100")
  # green is true only for the newest run named exactly CI, completed with
  # success. Anything else, including no run, is not green.
  green=$(printf '%s' "$checks" | jq -r '
    if (.total_count | type) == "number" and (.check_runs | type) == "array"
        and all(.check_runs[]; type == "object" and (.id | type) == "number"
          and (.name | type) == "string" and (.status | type) == "string")
        and .total_count <= (.check_runs | length)
    then ([.check_runs[] | select(.name == "CI")] | max_by(.id)
      | (. != null and .status == "completed" and .conclusion == "success") | tostring)
    else error("malformed check-runs response") end') ||
    die "the check runs for $head (PR #$number) are malformed or truncated"

  [ "$green" = true ] && continue
  [ "$green" = false ] || die "unreadable CI result for $head"

  nogreen=$((nogreen + 1))
  if [ "$is_declared" = true ]; then
    verdict=declared
  else
    verdict=undeclared
    undeclared=$((undeclared + 1))
  fi
  line="merge $sha head $head PR #$number ticket $ticket $verdict"
  echo "$line"
  if [ "$verdict" = undeclared ] && [ -n "${GITHUB_ACTIONS-}" ]; then
    echo "::error::$line"
  fi
done <<<"$shas"

echo "audited $audited merges, $nogreen without green CI, $undeclared undeclared"
[ "$undeclared" -eq 0 ]
