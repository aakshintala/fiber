#!/usr/bin/env bash
# The self-test for scripts/check-resources (issue #3954). A fixture `df`
# on PATH prints POSIX `df -Pk` text and logs its arguments, so the
# preflight cases pin the parsing, the two constants and the shared-sum rule
# without touching a real disk. A fixture `cargo` and a fixture
# `shellcheck` stand in for the toolchain in the throwaway repos where the
# `scripts/check` wiring cases run. No wait, no clock, no signal, no
# background process; one `mktemp -d` holds every fixture and case file.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
top=$PWD

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "scripts/test-check-resources: $1" >&2
  exit 1
}

check_resources=$top/scripts/check-resources
[ -x "$check_resources" ] || fail "scripts/check-resources is not executable"

# The constants live in the script; the cases below read them, so a
# measurement update moves every boundary with it.
tmp_min=$(sed -n 's/^PREFLIGHT_TMPDIR_MIN_MIB=//p' "$check_resources")
tgt_min=$(sed -n 's/^PREFLIGHT_TARGET_MIN_MIB=//p' "$check_resources")
case $tmp_min in
  '' | *[!0-9]*) fail "PREFLIGHT_TMPDIR_MIN_MIB is not a plain number" ;;
esac
case $tgt_min in
  '' | *[!0-9]*) fail "PREFLIGHT_TARGET_MIN_MIB is not a plain number" ;;
esac

mkdir -p "$tmp/bin"
df_log=$tmp/df-args.txt
cargo_log=$tmp/cargo-args.txt

# Fixture df: logs its arguments, answers from FIX_DF_*, and never touches a
# disk. The directory equal to FIX_DF_TMPDIR takes the TMP figures, every
# other directory the target figures. FIX_DF_SHARED=1 answers both calls
# with one device and mount; FIX_DF_FAIL and FIX_DF_NONNUMERIC take
# 1|both|tmp|tgt.
cat >"$tmp/bin/df" <<'EOF'
#!/usr/bin/env bash
echo "$*" >>"$FIX_DF_LOG"
dir=
for a in "$@"; do dir=$a; done
which=target
if [ "$dir" = "${FIX_DF_TMPDIR-}" ]; then which=tmp; fi
case ${FIX_DF_FAIL-} in
  1 | both) exit 1 ;;
  tmp) if [ "$which" = tmp ]; then exit 1; fi ;;
  tgt) if [ "$which" = target ]; then exit 1; fi ;;
esac
if [ "$which" = tmp ]; then
  kib=${FIX_DF_TMP_KIB-0}
  dev=${FIX_DF_DEV_TMP-tmpfs}
  mnt=${FIX_DF_MNT_TMP-/tmp}
else
  kib=${FIX_DF_TGT_KIB-0}
  dev=${FIX_DF_DEV_TGT-/dev/testroot}
  mnt=${FIX_DF_MNT_TGT-/}
fi
if [ "${FIX_DF_SHARED-}" = 1 ]; then
  dev=${FIX_DF_DEV-testfs}
  mnt=${FIX_DF_MNT-/testmnt}
fi
avail=$kib
case ${FIX_DF_NONNUMERIC-} in
  1 | both) avail=- ;;
  tmp) if [ "$which" = tmp ]; then avail=-; fi ;;
  tgt) if [ "$which" = target ]; then avail=-; fi ;;
esac
printf 'Filesystem  1024-blocks  Used Available Capacity Mounted on\n'
printf '%s  200000000  100000000  %s  50%%  %s\n' "$dev" "$avail" "$mnt"
EOF
chmod 755 "$tmp/bin/df"

# Fixture cargo for the wiring cases: logs every call; `xtask select`
# reports an empty docs selection or fails with FIX_SELECT_STDERR at 101;
# `clippy` replays FIX_CLIPPY_OUT at FIX_CLIPPY_RC; every other call exits 0.
cat >"$tmp/bin/cargo" <<'EOF'
#!/usr/bin/env bash
echo "$*" >>"$FIX_CARGO_LOG"
if [ "${1-}" = xtask ] && [ "${2-}" = select ]; then
  if [ -n "${FIX_SELECT_STDERR-}" ]; then
    cat "$FIX_SELECT_STDERR" >&2
    exit 101
  fi
  printf 'mode=docs\npackages=\npackage_specs=\nlibrary_specs=\nextension_packages=\n'
  exit 0
fi
if [ "${1-}" = clippy ]; then
  if [ -n "${FIX_CLIPPY_OUT-}" ]; then
    cat "$FIX_CLIPPY_OUT" >&2
  fi
  exit "${FIX_CLIPPY_RC-0}"
fi
exit 0
EOF
chmod 755 "$tmp/bin/cargo"

# Fixture shellcheck: the throwaway repos hold no install.sh or test stubs,
# so the real check would fail there; the wiring cases pin exit codes, and
# the real shellcheck gate runs on this repo's scripts directly.
cat >"$tmp/bin/shellcheck" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod 755 "$tmp/bin/shellcheck"

PATH="$tmp/bin:$PATH"
export PATH

# --- preflight ---

# Plenty free on two filesystems: exit 0, stdout holds both directories and
# the figures.
rm -f "$df_log"
export FIX_DF_LOG=$df_log
export FIX_DF_TMPDIR=$tmp/scratch
mkdir -p "$tmp/scratch"
export FIX_DF_TMP_KIB=$(((tmp_min + 50) * 1024))
export FIX_DF_TGT_KIB=$(((tgt_min + 70) * 1024))
out=$tmp/out.txt
err=$tmp/err.txt
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 0 ] || { cat "$out" "$err" >&2; fail "plenty free exited $rc, want 0"; }
grep -qF "$tmp/scratch" "$out" || { cat "$out" >&2; fail "plenty report names no TMPDIR"; }
grep -qF "$tmp/target" "$out" || { cat "$out" >&2; fail "plenty report names no target"; }
grep -qF "$((tmp_min + 50)) MiB free" "$out" || { cat "$out" >&2; fail "plenty report holds no TMPDIR figure"; }
grep -qF "(need $tmp_min and $tgt_min)" "$out" || { cat "$out" >&2; fail "plenty report holds no need figures"; }
[ -s "$err" ] && { cat "$err" >&2; fail "plenty free wrote to stderr"; }

# TMPDIR short: exit 75, naming TMPDIR, the directory, free MiB, the
# constant and the fix text.
rm -f "$df_log"
export FIX_DF_TMP_KIB=0
export FIX_DF_TGT_KIB=$(((tgt_min + 70) * 1024))
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "TMPDIR short exited $rc, want 75"; }
grep -qF "TMPDIR=$tmp/scratch has 0 MiB free" "$out" || { cat "$out" >&2; fail "TMPDIR refusal names no directory and figure"; }
grep -qF "the gate needs $tmp_min MiB (PREFLIGHT_TMPDIR_MIN_MIB)" "$out" || { cat "$out" >&2; fail "TMPDIR refusal names no constant"; }
grep -qF "set TMPDIR= to a larger filesystem" "$out" || { cat "$out" >&2; fail "TMPDIR refusal holds no fix text"; }

# Target short: exit 75, naming the target path and "free space under".
rm -f "$df_log"
export FIX_DF_TMP_KIB=$(((tmp_min + 50) * 1024))
export FIX_DF_TGT_KIB=512
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "target short exited $rc, want 75"; }
grep -qF "target ($tmp/target) has 0 MiB free" "$out" || { cat "$out" >&2; fail "target refusal names no path and figure"; }
grep -qF "free space under $tmp/target" "$out" || { cat "$out" >&2; fail "target refusal holds no fix text"; }

# Boundary per constant on two filesystems: exactly the limit passes, one
# KiB under refuses.
for side in tmp tgt; do
  if [ "$side" = tmp ]; then
    limit=$tmp_min
    export FIX_DF_TMP_KIB=$((limit * 1024))
    export FIX_DF_TGT_KIB=$(((tgt_min + 70) * 1024))
    env_tmp=$tmp/scratch
    env_tgt=$tmp/target
  else
    limit=$tgt_min
    export FIX_DF_TMP_KIB=$(((tmp_min + 50) * 1024))
    export FIX_DF_TGT_KIB=$((limit * 1024))
    env_tmp=$tmp/scratch
    env_tgt=$tmp/target
  fi
  rc=0
  TMPDIR=$env_tmp CARGO_TARGET_DIR=$env_tgt "$check_resources" preflight >"$out" 2>"$err" || rc=$?
  [ "$rc" -eq 0 ] || { cat "$out" "$err" >&2; fail "$side at exactly the limit exited $rc, want 0"; }
  if [ "$side" = tmp ]; then
    export FIX_DF_TMP_KIB=$((limit * 1024 - 1))
  else
    export FIX_DF_TGT_KIB=$((limit * 1024 - 1))
  fi
  rc=0
  TMPDIR=$env_tmp CARGO_TARGET_DIR=$env_tgt "$check_resources" preflight >"$out" 2>"$err" || rc=$?
  [ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "$side one KiB under the limit exited $rc, want 75"; }
done
unset FIX_DF_TMP_KIB FIX_DF_TGT_KIB

# Shared filesystem: free between the larger constant and the sum refuses;
# free at exactly the sum passes; one KiB under the sum refuses; the line
# names both directories.
if [ "$tmp_min" -gt "$tgt_min" ]; then big=$tmp_min; else big=$tgt_min; fi
sum=$((tmp_min + tgt_min))
export FIX_DF_SHARED=1
export FIX_DF_TMPDIR=$tmp/scratch
export FIX_DF_TMP_KIB=$(((big * 1024) + 512))
export FIX_DF_TGT_KIB=0
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "shared between max and sum exited $rc, want 75"; }
grep -qF "$tmp/scratch" "$out" || { cat "$out" >&2; fail "shared refusal names no TMPDIR"; }
grep -qF "target ($tmp/target)" "$out" || { cat "$out" >&2; fail "shared refusal names no target"; }
grep -qF "(PREFLIGHT_TMPDIR_MIN_MIB + PREFLIGHT_TARGET_MIN_MIB)" "$out" || { cat "$out" >&2; fail "shared refusal names no summed constants"; }
export FIX_DF_TMP_KIB=$((sum * 1024))
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 0 ] || { cat "$out" "$err" >&2; fail "shared at exactly the sum exited $rc, want 0"; }
grep -qF "need $sum MiB" "$out" || { cat "$out" >&2; fail "shared report names no sum"; }
export FIX_DF_TMP_KIB=$((sum * 1024 - 1))
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "shared one KiB under the sum exited $rc, want 75"; }
unset FIX_DF_SHARED FIX_DF_TMP_KIB FIX_DF_TGT_KIB

# Two tmpfs mounts with different mount points count as two filesystems: a
# shared device name alone does not trigger the sum rule.
export FIX_DF_TMPDIR=$tmp/scratch
export FIX_DF_DEV_TMP=tmpfs
export FIX_DF_MNT_TMP=/tmp
export FIX_DF_DEV_TGT=tmpfs
export FIX_DF_MNT_TGT=/var/tmp
export FIX_DF_TMP_KIB=$(((tmp_min + 50) * 1024))
export FIX_DF_TGT_KIB=$(((tgt_min + 50) * 1024))
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 0 ] || { cat "$out" "$err" >&2; fail "two tmpfs mounts exited $rc, want 0"; }
grep -qF "(need $tmp_min and $tgt_min)" "$out" || { cat "$out" >&2; fail "two tmpfs mounts used the sum rule"; }
unset FIX_DF_DEV_TMP FIX_DF_MNT_TMP FIX_DF_DEV_TGT FIX_DF_MNT_TGT
unset FIX_DF_TMP_KIB FIX_DF_TGT_KIB

# Both short on two filesystems: one sentence naming both, exit 75.
export FIX_DF_TMP_KIB=0
export FIX_DF_TGT_KIB=0
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "both short exited $rc, want 75"; }
[ "$(wc -l <"$out")" -eq 1 ] || { cat "$out" >&2; fail "both-short refusal is not one line"; }
grep -qF "TMPDIR=$tmp/scratch" "$out" || { cat "$out" >&2; fail "both-short refusal names no TMPDIR"; }
grep -qF "target ($tmp/target)" "$out" || { cat "$out" >&2; fail "both-short refusal names no target"; }
unset FIX_DF_TMP_KIB FIX_DF_TGT_KIB

# TMPDIR unset: df is asked for /tmp and stdout says unset.
rm -f "$df_log"
export FIX_DF_TMPDIR=/tmp
export FIX_DF_TMP_KIB=$(((tmp_min + 50) * 1024))
export FIX_DF_TGT_KIB=$(((tgt_min + 50) * 1024))
rc=0
env -u TMPDIR CARGO_TARGET_DIR="$tmp/target" "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 0 ] || { cat "$out" "$err" >&2; fail "unset TMPDIR exited $rc, want 0"; }
grep -qF "(unset, using /tmp)" "$out" || { cat "$out" >&2; fail "unset TMPDIR report says nothing about unset"; }
grep -qF -- "-Pk /tmp" "$df_log" || { cat "$df_log" >&2; fail "unset TMPDIR asked df for no /tmp"; }
rm -f "$df_log"
export FIX_DF_TMP_KIB=0
rc=0
env -u TMPDIR CARGO_TARGET_DIR="$tmp/target" "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "unset TMPDIR short exited $rc, want 75"; }
grep -qF "TMPDIR=(unset, using /tmp)" "$out" || { cat "$out" >&2; fail "unset TMPDIR refusal prints no unset form"; }
unset FIX_DF_TMP_KIB FIX_DF_TGT_KIB

# CARGO_TARGET_DIR with missing parents: exit 0, df is asked for the
# nearest existing parent, never the missing path.
rm -f "$df_log"
export FIX_DF_TMPDIR=$tmp/scratch
export FIX_DF_TMP_KIB=$(((tmp_min + 50) * 1024))
export FIX_DF_TGT_KIB=$(((tgt_min + 50) * 1024))
missing=$tmp/no/such/dir/target
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$missing "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 0 ] || { cat "$out" "$err" >&2; fail "missing target parents exited $rc, want 0"; }
grep -qF -- "-Pk $tmp" "$df_log" || { cat "$df_log" >&2; fail "missing parents asked df for no nearest parent"; }
grep -qF "$missing" "$df_log" && { cat "$df_log" >&2; fail "df was asked the missing path"; }
unset FIX_DF_TMP_KIB FIX_DF_TGT_KIB

# A df that cannot be read warns on stderr and skips that directory: exit 0
# for it, while the other directory is still checked.
export FIX_DF_TMPDIR=$tmp/scratch
export FIX_DF_FAIL=1
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 0 ] || { cat "$out" "$err" >&2; fail "failed df exited $rc, want 0"; }
grep -qF "preflight skipped for $tmp/scratch: df unreadable" "$err" || { cat "$err" >&2; fail "failed df warns for no TMPDIR"; }
grep -qF "preflight skipped for $tmp/target: df unreadable" "$err" || { cat "$err" >&2; fail "failed df warns for no target"; }
unset FIX_DF_FAIL
export FIX_DF_NONNUMERIC=1
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 0 ] || { cat "$out" "$err" >&2; fail "non-numeric df exited $rc, want 0"; }
grep -qF "preflight skipped for $tmp/scratch: df unreadable" "$err" || { cat "$err" >&2; fail "non-numeric df warns for no TMPDIR"; }
unset FIX_DF_NONNUMERIC
# One side unreadable, the other short: the readable side still refuses.
export FIX_DF_NONNUMERIC=tmp
export FIX_DF_TGT_KIB=0
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "unreadable TMPDIR with short target exited $rc, want 75"; }
grep -qF "target ($tmp/target)" "$out" || { cat "$out" >&2; fail "readable side was not checked"; }
unset FIX_DF_NONNUMERIC FIX_DF_TGT_KIB
export FIX_DF_FAIL=tgt
export FIX_DF_TMP_KIB=0
rc=0
TMPDIR=$tmp/scratch CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 75 ] || { cat "$out" "$err" >&2; fail "failed target df with short TMPDIR exited $rc, want 75"; }
unset FIX_DF_FAIL FIX_DF_TMP_KIB

# TMPDIR that is not a directory, or that does not exist: exit 1 on stderr.
printf 'x\n' >"$tmp/afile"
rc=0
TMPDIR=$tmp/afile CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 1 ] || { cat "$out" "$err" >&2; fail "file TMPDIR exited $rc, want 1"; }
[ -s "$err" ] || fail "file TMPDIR wrote nothing to stderr"
rc=0
TMPDIR=$tmp/absent CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 1 ] || { cat "$out" "$err" >&2; fail "missing TMPDIR exited $rc, want 1"; }

# Usage: an unknown subcommand, no subcommand, and classify without a
# readable file exit 2.
rc=0
"$check_resources" frobnicate >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "unknown subcommand exited $rc, want 2"
rc=0
"$check_resources" >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "no subcommand exited $rc, want 2"
rc=0
"$check_resources" classify >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "classify without a file exited $rc, want 2"
rc=0
"$check_resources" classify "$tmp/absent" >"$out" 2>"$err" || rc=$?
[ "$rc" -eq 2 ] || fail "classify on a missing file exited $rc, want 2"

# Unwritable TMPDIR with almost no space: exit 75, not 1. Root bypasses
# modes, so the case is skipped there.
if [ "$(id -u)" -eq 0 ]; then
  echo "scripts/test-check-resources: unwritable TMPDIR case skipped (running as root)"
else
  mkdir -p "$tmp/locked"
  chmod 500 "$tmp/locked"
  export FIX_DF_TMPDIR=$tmp/locked
  export FIX_DF_TMP_KIB=0
  export FIX_DF_TGT_KIB=$(((tgt_min + 50) * 1024))
  rc=0
  TMPDIR=$tmp/locked CARGO_TARGET_DIR=$tmp/target "$check_resources" preflight >"$out" 2>"$err" || rc=$?
  [ "$rc" -eq 75 ] || { chmod 700 "$tmp/locked"; cat "$out" "$err" >&2; fail "locked TMPDIR exited $rc, want 75"; }
  chmod 700 "$tmp/locked"
  unset FIX_DF_TMPDIR FIX_DF_TMP_KIB FIX_DF_TGT_KIB
fi

# --- classify ---

expect_classify() {
  # $1 fixture file, $2 want exit, $3 want matched shape (empty for none).
  rc=0
  "$check_resources" classify "$1" >"$out" 2>"$err" || rc=$?
  [ "$rc" -eq "$2" ] || { cat "$out" "$err" >&2; fail "classify $1 exited $rc, want $2"; }
  if [ -n "$3" ]; then
    grep -qF "(matched \"$3\")" "$out" || { cat "$out" >&2; fail "classify $1 quotes no $3"; }
  else
    if [ -s "$out" ]; then
      cat "$out" >&2
      fail "classify $1 printed on a pass"
    fi
  fi
  return 0
}

# Linker killed by bus error: the ticket's evidence, with cargo's marker.
cat >"$tmp/f-link7.txt" <<'EOF'
error: linking with `cc` failed: exit status: 1
  |
  = note: "cc" "-m64" "-o" "/tmp/killrec/rec/target/debug/deps/killrec-abc" "src/main.rs"
  = note: collect2: fatal error: ld terminated with signal 7 [Bus error]
          compilation terminated.
error: could not compile `killrec` (bin "killrec") due to 1 previous error
EOF
expect_classify "$tmp/f-link7.txt" 75 'terminated with signal 7'

# Linker killed by the OOM killer.
cat >"$tmp/f-link9.txt" <<'EOF'
error: linking with `cc` failed: exit status: 1
  |
  = note: "cc" "-m64" "-o" "/tmp/killrec/rec/target/debug/deps/killrec-abc" "src/main.rs"
  = note: collect2: fatal error: ld terminated with signal 9 [Killed]
error: could not compile `killrec` (bin "killrec") due to 1 previous error
EOF
expect_classify "$tmp/f-link9.txt" 75 'terminated with signal 9'

# Recorded `cargo build` with rustc killed by SIGKILL (paths stabilised).
cat >"$tmp/f-buildkill.txt" <<'EOF'
   Compiling killrec v0.1.0 (/tmp/killrec/rec)
error: could not compile `killrec` (lib)

Caused by:
  process didn't exit successfully: `/tmp/killrec/wrap.sh /home/user/.rustup/toolchains/1.99.0-x86_64-unknown-linux-gnu/bin/rustc --crate-name killrec --edition=2024 src/lib.rs --crate-type lib` (signal: 9, SIGKILL: kill)
EOF
expect_classify "$tmp/f-buildkill.txt" 75 'signal: 9, SIGKILL'

# Recorded `cargo build` with rustc killed by SIGBUS.
cat >"$tmp/f-buildbus.txt" <<'EOF'
   Compiling killrec v0.1.0 (/tmp/killrec/rec)
error: could not compile `killrec` (lib)

Caused by:
  process didn't exit successfully: `/tmp/killrec/wrap.sh /home/user/.rustup/toolchains/1.99.0-x86_64-unknown-linux-gnu/bin/rustc --crate-name killrec --edition=2024 src/lib.rs --crate-type lib` (signal: 7, SIGBUS: access to undefined memory)
EOF
expect_classify "$tmp/f-buildbus.txt" 75 'signal: 7, SIGBUS'

# Recorded `cargo nextest run` with the test binary build killed (SIGKILL).
cat >"$tmp/f-nextest.txt" <<'EOF'
   Compiling killrec v0.1.0 (/tmp/killrec/rec)
error: could not compile `killrec` (lib test)

Caused by:
  process didn't exit successfully: `/tmp/killrec/wrap.sh /home/user/.rustup/toolchains/1.99.0-x86_64-unknown-linux-gnu/bin/rustc --crate-name killrec --edition=2024 src/lib.rs --test` (signal: 9, SIGKILL: kill)
warning: build failed, waiting for other jobs to finish...
error: command `/home/user/.rustup/toolchains/1.99.0-x86_64-unknown-linux-gnu/bin/cargo '--color=auto' test --no-run --message-format json-render-diagnostics` exited with code 101
EOF
expect_classify "$tmp/f-nextest.txt" 75 'signal: 9, SIGKILL'

# Recorded `cargo test --doc` with the library build killed (SIGBUS).
cat >"$tmp/f-doctest.txt" <<'EOF'
   Compiling killrec v0.1.0 (/tmp/killrec/rec)
error: could not compile `killrec` (lib)

Caused by:
  process didn't exit successfully: `/tmp/killrec/wrap.sh /home/user/.rustup/toolchains/1.99.0-x86_64-unknown-linux-gnu/bin/rustc --crate-name killrec --edition=2024 src/lib.rs --crate-type lib` (signal: 7, SIGBUS: access to undefined memory)
EOF
expect_classify "$tmp/f-doctest.txt" 75 'signal: 7, SIGBUS'

# Recorded build script killed by SIGKILL: the third marker.
cat >"$tmp/f-buildscript.txt" <<'EOF'
   Compiling killrec v0.1.0 (/tmp/killrec/rec)
error: failed to run custom build command for `killrec v0.1.0 (/tmp/killrec/rec)`

Caused by:
  process didn't exit successfully: `/tmp/killrec/rec/target/debug/build/killrec-1bcd02a1f060f968/build-script-build` (signal: 9, SIGKILL: kill)
EOF
expect_classify "$tmp/f-buildscript.txt" 75 'signal: 9, SIGKILL'

# A coloured copy of the linker fixture: CI sets CARGO_TERM_COLOR=always.
{ printf '\033[1;31m'; cat "$tmp/f-link7.txt"; printf '\033[0m'; } >"$tmp/f-colored.txt"
expect_classify "$tmp/f-colored.txt" 75 'terminated with signal 7'

# The acceptance box: a file holding only the ticket's one line.
printf '%s\n' 'collect2: fatal error: ld terminated with signal 7 [Bus error]' >"$tmp/f-bare7.txt"
expect_classify "$tmp/f-bare7.txt" 75 'terminated with signal 7'
printf '%s\n' 'collect2: fatal error: ld terminated with signal 9 [Killed]' >"$tmp/f-bare9.txt"
expect_classify "$tmp/f-bare9.txt" 75 'terminated with signal 9'

# A `signal: N, SIG...` shape without a marker is the step's own failure:
# a killed test child under nextest, and under doc tests.
cat >"$tmp/f-nextest-sigonly.txt" <<'EOF'
error: test binary `tui-abc123` failed
Caused by:
  process didn't exit successfully: `/tmp/killrec/rec/target/debug/deps/tui-abc123` (signal: 9, SIGKILL: kill)
EOF
expect_classify "$tmp/f-nextest-sigonly.txt" 0 ''
cat >"$tmp/f-doctest-sigonly.txt" <<'EOF'
---- src/lib.rs - add_one (line 3) stdout ----
error: doctest harness died: worker process (signal: 7, SIGBUS: access to undefined memory)
EOF
expect_classify "$tmp/f-doctest-sigonly.txt" 0 ''
# The same two shapes with a marker refuse.
cat >"$tmp/f-nextest-sig-marker.txt" <<'EOF'
error: could not compile `killrec` (lib test)
Caused by:
  process didn't exit successfully: `/tmp/killrec/wrap.sh /home/user/.rustup/toolchains/1.99.0-x86_64-unknown-linux-gnu/bin/rustc --crate-name killrec` (signal: 9, SIGKILL: kill)
EOF
expect_classify "$tmp/f-nextest-sig-marker.txt" 75 'signal: 9, SIGKILL'
cat >"$tmp/f-doctest-sig-marker.txt" <<'EOF'
error: failed to run custom build command for `killrec v0.1.0 (/tmp/killrec/rec)`
Caused by:
  process didn't exit successfully: `/tmp/killrec/rec/target/debug/build/killrec-abc/build-script-build` (signal: 7, SIGBUS: access to undefined memory)
EOF
expect_classify "$tmp/f-doctest-sig-marker.txt" 75 'signal: 7, SIGBUS'

# A marker without a shape keeps the step's own failure.
cat >"$tmp/f-ordinary-link.txt" <<'EOF'
error: linking with `cc` failed: exit status: 1
  |
  = note: "cc" "-m64" "-o" "/tmp/killrec/rec/target/debug/deps/killrec-abc" "src/main.rs"
  = note: /usr/bin/ld: undefined reference to `missing_symbol'
          collect2: error: ld returned 1 exit status
error: could not compile `killrec` (bin "killrec") due to 1 previous error
EOF
expect_classify "$tmp/f-ordinary-link.txt" 0 ''
cat >"$tmp/f-e0425.txt" <<'EOF'
error[E0425]: cannot find value `foo` in this scope
 --> src/main.rs:2:5
  |
2 |     foo
  |     ^^^ not found in this scope
error: could not compile `killrec` (bin "killrec") due to 1 previous error
EOF
expect_classify "$tmp/f-e0425.txt" 0 ''

# Other negatives, each exit 0.
printf '%s\n' 'collect2: fatal error: ld terminated with signal 11 [Segmentation fault]' >"$tmp/f-sig11.txt"
expect_classify "$tmp/f-sig11.txt" 0 ''
cat "$tmp/f-sig11.txt" "$tmp/f-ordinary-link.txt" >"$tmp/f-sig11-marker.txt"
expect_classify "$tmp/f-sig11-marker.txt" 0 ''
cat >"$tmp/f-segv.txt" <<'EOF'
error: could not compile `killrec` (bin "killrec") due to 1 previous error
Caused by:
  process didn't exit successfully: `rustc --crate-name killrec src/main.rs` (signal: 11, SIGSEGV: invalid memory reference)
EOF
expect_classify "$tmp/f-segv.txt" 0 ''
cat >"$tmp/f-bare9only.txt" <<'EOF'
error: could not compile `killrec` (bin "killrec") due to 1 previous error
note: signal: 9
EOF
expect_classify "$tmp/f-bare9only.txt" 0 ''
printf '%s\n' 'Killed' >"$tmp/f-killed.txt"
expect_classify "$tmp/f-killed.txt" 0 ''
cat >"$tmp/f-nospace.txt" <<'EOF'
error: could not compile `killrec` (bin "killrec") due to 1 previous error
Caused by:
  No space left on device (os error 28)
EOF
expect_classify "$tmp/f-nospace.txt" 0 ''
: >"$tmp/f-empty.txt"
expect_classify "$tmp/f-empty.txt" 0 ''
printf '%s\n' 'process (signal: 9, SIGKILL: kill)' >"$tmp/f-buildscript-nomarker.txt"
expect_classify "$tmp/f-buildscript-nomarker.txt" 0 ''

# --- scripts/check wiring ---

# Each case runs scripts/check in a throwaway repo holding copies of the
# three scripts, with the fixture df and cargo first on PATH. The repo gets
# a git identity, since CI hosts have none.
new_repo() {
  git init -q "$1"
  git -C "$1" config user.email test@example.com
  git -C "$1" config user.name Test
  git -C "$1" commit -q --allow-empty -m base
}

wire_repo() {
  mkdir -p "$1/scripts" "$1/tmp"
  cp "$top/scripts/check" "$top/scripts/check-resources" "$top/scripts/check-docs" "$1/scripts/"
  chmod 755 "$1/scripts/check" "$1/scripts/check-resources"
}

plenty=$(((tmp_min + tgt_min + 100) * 1024))

run_nested() {
  # $1 repo dir. Extra fixture behaviour rides in SELERR, CLIP, CLIPRC,
  # KIB_TMP, KIB_TGT and SHARED. Output in $1/out.txt, status in nested_rc.
  nested_repo=$1
  nested_rc=0
  rm -f "$cargo_log" "$df_log"
  (
    cd "$nested_repo" || exit 1
    TMPDIR=$nested_repo/tmp CARGO_TARGET_DIR=$nested_repo/target \
      FIX_CARGO_LOG=$cargo_log FIX_DF_LOG=$df_log \
      FIX_DF_TMPDIR=$nested_repo/tmp \
      FIX_DF_TMP_KIB=${KIB_TMP-$plenty} FIX_DF_TGT_KIB=${KIB_TGT-$plenty} \
      FIX_DF_SHARED=${SHARED-} FIX_SELECT_STDERR=${SELERR-} \
      FIX_CLIPPY_OUT=${CLIP-} FIX_CLIPPY_RC=${CLIPRC-0} \
      PATH="$tmp/bin:$PATH" \
      ./scripts/check --base HEAD --shared-only >"$nested_repo/out.txt" 2>&1
  ) || nested_rc=$?
  return 0
}

last_line() {
  tail -n 1 "$1/out.txt"
}

# Preflight refusal: exit 75, cause in the last line, and no build step ran.
w=$tmp/w-refuse
new_repo "$w"
wire_repo "$w"
KIB_TMP=0 run_nested "$w"
[ "$nested_rc" -eq 75 ] || { cat "$w/out.txt" >&2; fail "refusal run exited $nested_rc, want 75"; }
case $(last_line "$w") in
  "scripts/check: FAIL (exit 75): "*) ;;
  *) fail "refusal last line holds no cause: $(last_line "$w")" ;;
esac
grep -qF "TMPDIR=$w/tmp" "$w/out.txt" || { cat "$w/out.txt" >&2; fail "refusal names no TMPDIR"; }
if [ -s "$cargo_log" ]; then cat "$cargo_log" >&2; fail "a build step ran after a preflight refusal"; fi
if grep -qF '== selection' "$w/out.txt"; then cat "$w/out.txt" >&2; fail "selection ran after a preflight refusal"; fi

# Target short: same shape, naming the target.
w=$tmp/w-target
new_repo "$w"
wire_repo "$w"
KIB_TGT=512 run_nested "$w"
[ "$nested_rc" -eq 75 ] || { cat "$w/out.txt" >&2; fail "target run exited $nested_rc, want 75"; }
case $(last_line "$w") in
  "scripts/check: FAIL (exit 75): "*) ;;
  *) fail "target last line holds no cause: $(last_line "$w")" ;;
esac
grep -qF "target ($w/target)" "$w/out.txt" || { cat "$w/out.txt" >&2; fail "refusal names no target"; }

# Shared filesystem between the larger constant and the sum: exit 75.
w=$tmp/w-shared
new_repo "$w"
wire_repo "$w"
if [ "$tmp_min" -gt "$tgt_min" ]; then big=$tmp_min; else big=$tgt_min; fi
KIB_TMP=$(((big * 1024) + 512)) KIB_TGT=$(((big * 1024) + 512)) SHARED=1 run_nested "$w"
[ "$nested_rc" -eq 75 ] || { cat "$w/out.txt" >&2; fail "shared run exited $nested_rc, want 75"; }
case $(last_line "$w") in
  "scripts/check: FAIL (exit 75): "*) ;;
  *) fail "shared last line holds no cause: $(last_line "$w")" ;;
esac

# Select killed with the recorded signal-7 block: exit 75 with the cause.
cp "$tmp/f-link7.txt" "$tmp/sel-killed.txt"
w=$tmp/w-select-kill
new_repo "$w"
wire_repo "$w"
SELERR=$tmp/sel-killed.txt run_nested "$w"
[ "$nested_rc" -eq 75 ] || { cat "$w/out.txt" >&2; fail "killed select exited $nested_rc, want 75"; }
case $(last_line "$w") in
  "scripts/check: FAIL (exit 75): the build was killed for lack of resources (matched \"terminated with signal 7\")"*) ;;
  *) fail "killed select last line holds no cause: $(last_line "$w")" ;;
esac

# Select killed by the bare ticket line: exit 75 with the cause.
cp "$tmp/f-bare7.txt" "$tmp/sel-bare.txt"
w=$tmp/w-select-bare
new_repo "$w"
wire_repo "$w"
SELERR=$tmp/sel-bare.txt run_nested "$w"
[ "$nested_rc" -eq 75 ] || { cat "$w/out.txt" >&2; fail "bare select exited $nested_rc, want 75"; }
case $(last_line "$w") in
  "scripts/check: FAIL (exit 75): "*) ;;
  *) fail "bare select last line holds no cause: $(last_line "$w")" ;;
esac

# Select ordinary failure: the step's code, a bare FAIL line, no cause.
cp "$tmp/f-ordinary-link.txt" "$tmp/sel-ordinary.txt"
w=$tmp/w-select-ordinary
new_repo "$w"
wire_repo "$w"
SELERR=$tmp/sel-ordinary.txt run_nested "$w"
[ "$nested_rc" -eq 101 ] || { cat "$w/out.txt" >&2; fail "ordinary select exited $nested_rc, want 101"; }
[ "$(last_line "$w")" = "scripts/check: FAIL (exit 101)" ] || fail "ordinary select last line moved: $(last_line "$w")"
if grep -qF 'killed for lack of resources' "$w/out.txt"; then cat "$w/out.txt" >&2; fail "ordinary select carries a cause"; fi

# The tui-prototype clippy step with a SIGKILL and a marker: exit 75.
cp "$tmp/f-nextest-sig-marker.txt" "$tmp/clip-killed.txt"
w=$tmp/w-clip-kill
new_repo "$w"
wire_repo "$w"
mkdir -p "$w/research/tui-prototype"
printf '// x\n' >"$w/research/tui-prototype/x"
CLIP=$tmp/clip-killed.txt CLIPRC=101 run_nested "$w"
[ "$nested_rc" -eq 75 ] || { cat "$w/out.txt" >&2; fail "killed clippy exited $nested_rc, want 75"; }
case $(last_line "$w") in
  "scripts/check: FAIL (exit 75): the build was killed for lack of resources (matched \"signal: 9, SIGKILL\")"*) ;;
  *) fail "killed clippy last line holds no cause: $(last_line "$w")" ;;
esac

# The same SIGKILL without a marker, and an ordinary clippy error: 101.
cp "$tmp/f-nextest-sigonly.txt" "$tmp/clip-nomarker.txt"
w=$tmp/w-clip-nomarker
new_repo "$w"
wire_repo "$w"
mkdir -p "$w/research/tui-prototype"
printf '// x\n' >"$w/research/tui-prototype/x"
CLIP=$tmp/clip-nomarker.txt CLIPRC=101 run_nested "$w"
[ "$nested_rc" -eq 101 ] || { cat "$w/out.txt" >&2; fail "markerless clippy exited $nested_rc, want 101"; }
[ "$(last_line "$w")" = "scripts/check: FAIL (exit 101)" ] || fail "markerless clippy last line moved: $(last_line "$w")"
w=$tmp/w-clip-ordinary
new_repo "$w"
wire_repo "$w"
mkdir -p "$w/research/tui-prototype"
printf '// x\n' >"$w/research/tui-prototype/x"
CLIP=$tmp/f-ordinary-link.txt CLIPRC=101 run_nested "$w"
[ "$nested_rc" -eq 101 ] || { cat "$w/out.txt" >&2; fail "ordinary clippy exited $nested_rc, want 101"; }
[ "$(last_line "$w")" = "scripts/check: FAIL (exit 101)" ] || fail "ordinary clippy last line moved: $(last_line "$w")"

# Clippy passing: the run passes with no "full output in" line.
w=$tmp/w-clip-pass
new_repo "$w"
wire_repo "$w"
mkdir -p "$w/research/tui-prototype"
printf '// x\n' >"$w/research/tui-prototype/x"
CLIPRC=0 run_nested "$w"
[ "$nested_rc" -eq 0 ] || { cat "$w/out.txt" >&2; fail "passing clippy exited $nested_rc, want 0"; }
[ "$(last_line "$w")" = "scripts/check: PASS" ] || fail "passing run last line moved: $(last_line "$w")"
if grep -qF 'full output in' "$w/out.txt"; then cat "$w/out.txt" >&2; fail "passing run names a log"; fi

# A passing run prints the preflight line before the first cargo call.
w=$tmp/w-pass
new_repo "$w"
wire_repo "$w"
run_nested "$w"
[ "$nested_rc" -eq 0 ] || { cat "$w/out.txt" >&2; fail "passing run exited $nested_rc, want 0"; }
grep -qF '== preflight: ' "$w/out.txt" || { cat "$w/out.txt" >&2; fail "passing run prints no preflight line"; }
[ "$(head -n 1 "$cargo_log")" = "xtask select --base HEAD" ] || { cat "$cargo_log" >&2; fail "a cargo call ran before the preflight"; }

echo "scripts/test-check-resources: PASS"
