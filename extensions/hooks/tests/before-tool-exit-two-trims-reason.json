{
  "script": {
    "steps": [
      {
        "tool_calls": [
          {
            "arguments": {
              "path": "script.json"
            },
            "name": "read"
          }
        ]
      },
      {
        "text": "Done."
      }
    ]
  },
  "prompt": "read it",
  "settings": {
    "hooks": {
      "hooks": {
        "guard": {
          "point": "before_tool",
          "command": "probe",
          "args": [],
          "timeout": 10000,
          "on_failure": "blocking"
        }
      }
    }
  },
  "host": {
    "exec": [
      {
        "request": {
          "program": "probe",
          "args": []
        },
        "reply": {
          "code": 2,
          "stdout": "",
          "stderr": "  no reads here\n\n"
        }
      }
    ]
  },
  "expect": [
    {
      "kind": "session_started"
    },
    {
      "kind": "fiber_started"
    },
    {
      "kind": "extensions_loaded"
    },
    {
      "kind": "preamble_built"
    },
    {
      "kind": "opening_message"
    },
    {
      "kind": "extension_state_set",
      "payload": {
        "extension": "github.com/aakshintala/fiber/extensions/hooks",
        "key": "hooks_workspace"
      }
    },
    {
      "kind": "turn_started"
    },
    {
      "kind": "step_started"
    },
    {
      "kind": "assistant_message_started"
    },
    {
      "kind": "tool_call_requested"
    },
    {
      "kind": "usage_recorded"
    },
    {
      "kind": "assistant_message_completed"
    },
    {
      "kind": "tool_call_completed",
      "payload": {
        "status": "denied",
        "reason": "hook",
        "content": [
          {
            "type": "text",
            "text": "Extension github.com/aakshintala/fiber/extensions/hooks refused this call: no reads here. It did not run."
          }
        ]
      }
    },
    {
      "kind": "step_started"
    },
    {
      "kind": "extension_exec"
    },
    {
      "kind": "assistant_message_started"
    },
    {
      "kind": "text_completed",
      "payload": {
        "text": "Done."
      }
    },
    {
      "kind": "usage_recorded"
    },
    {
      "kind": "assistant_message_completed"
    },
    {
      "kind": "turn_completed"
    },
    {
      "kind": "fiber_exited"
    }
  ]
}
