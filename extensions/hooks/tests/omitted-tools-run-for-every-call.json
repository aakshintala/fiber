{
  "script": {
    "steps": [
      {
        "tool_calls": [
          {
            "arguments": {
              "content": "hi",
              "path": "out.txt"
            },
            "name": "write"
          }
        ]
      },
      {
        "tool_calls": [
          {
            "arguments": {
              "path": "out.txt"
            },
            "name": "read"
          }
        ]
      },
      {
        "text": "Done."
      }
    ]
  },
